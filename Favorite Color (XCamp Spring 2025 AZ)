import java.util.*;
import java.io.*;
public class solution{
    static void merge(int a,int b,ArrayList<Integer>[]group,ArrayList<Integer>[]adj,int[]parent){
        for(int u:group[b]){
            parent[u]=a;
            group[a].add(u);
        }
        for(int u:adj[b]){
            adj[a].add(u);
        }
        adj[b].clear();
        group[b].clear();
    }
    public static void main(String[]args) throws IOException{
        BufferedReader br=new BufferedReader(new FileReader("fcolor.in"));
        PrintWriter pw=new PrintWriter(new FileWriter("fcolor.out"));
        StringTokenizer st=new StringTokenizer(br.readLine());
        int n=Integer.parseInt(st.nextToken());
        int m=Integer.parseInt(st.nextToken());
        int[]parent=new int[n+1];
        ArrayList<Integer>[]adj=new ArrayList[n+1];
        ArrayList<Integer>[]group=new ArrayList[n+1];
        for(int i=0;i<n;i++){
            parent[i]=i;
            adj[i]=new ArrayList<>();
            group[i]=new ArrayList<>();
            group[i].add(i);
        }
        for(int i=0;i<m;i++){
            st=new StringTokenizer(br.readLine());
            adj[Integer.parseInt(st.nextToken())-1].add(Integer.parseInt(st.nextToken())-1);
        }
        Queue<Integer>q=new LinkedList<>();
        for(int i=0;i<n;i++){
            if(adj[i].size()>1)
                q.add(i);
        }
        while(!q.isEmpty()){
            int u=q.peek();
            if(adj[u].size()<=1){
                q.poll();
                continue;
            }
            int v=adj[u].remove(adj[u].size()-1);
            int w=adj[u].get(adj[u].size()-1);
            if(parent[v]==parent[w])
                continue;
            if(group[parent[w]].size()>group[parent[v]].size()){
                merge(parent[w],parent[v],group,adj,parent);
                if(adj[parent[w]].size()>1)
                    q.add(parent[w]);
            }
            else{
                merge(parent[v],parent[w],group,adj,parent);
                if(adj[parent[v]].size()>1)
                    q.add(parent[v]);
            }
        }
        int count=0;
        int[]ans=new int[n];
        for(int i=0;i<n;i++){
            if(ans[parent[i]]==0)
                ans[parent[i]]=++count;
            pw.println(ans[parent[i]]);
        }
        pw.close();
    }
}
