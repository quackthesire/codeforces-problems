import java.util.*;
public class Main{
    static void dfs(int u,int p,int k,int[]dp,ArrayList<Integer>[]adj){
        ArrayList<Integer>temp=new ArrayList<>();
        for(int v:adj[u]){
            if(v==p)
                continue;
            dfs(v,u,k,dp,adj);
            temp.add(dp[v]);
        }
        Collections.sort(temp);
        if(temp.size()==0){
            dp[u]=0;
            return;
        }
        if(temp.size()==1){
            dp[u]=temp.get(0)+1;
            return;
        }
        if(temp.get(0)+temp.get(1)<=k-1)
            dp[u]=0;
        else
            dp[u]=temp.get(0)+1;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int k=scan.nextInt();
            int r=scan.nextInt()-1;
            int[]dp=new int[n];
            Arrays.fill(dp,Integer.MAX_VALUE/2);
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<n-1;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(v);
                adj[v].add(u);
            }
            dfs(r,-1,k,dp,adj);
            System.out.println(dp[r]==0?"YES":"NO");
        }
    }
}
