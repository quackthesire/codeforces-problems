import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int q=scan.nextInt();
            int[]array=new int[n];
            int[]ans=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
                ans[i]=array[i];
            }
            int[][]query=new int[q][3];
            for(int i=0;i<q;i++){
                query[i][0]=scan.nextInt()-1;
                query[i][1]=scan.nextInt()-1;
                query[i][2]=scan.nextInt()-1;
            }
            for(int i=q-1;i>=0;i--){
                int x=query[i][0];
                int y=query[i][1];
                int z=query[i][2];
                int xp=Math.max(ans[x],ans[z]);
                int yp=Math.max(ans[y],ans[z]);
                ans[z]=0;
                ans[y]=yp;
                ans[x]=xp;
            }
            int[]check=new int[n];
            for(int i=0;i<n;i++){
                check[i]=ans[i];
            }
            for(int i=0;i<q;i++){
                check[query[i][2]]=Math.min(check[query[i][0]],check[query[i][1]]);
            }
            boolean work=true;
            for(int i=0;i<n;i++){
                if(check[i]!=array[i])
                    work=false;
            }
            if(!work){
                System.out.println(-1);
                continue;
            }
            for(int i=0;i<n;i++){
                System.out.print(ans[i]+" ");
            }
            System.out.println();
        }
    }
}
