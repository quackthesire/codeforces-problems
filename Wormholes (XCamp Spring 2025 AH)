import java.util.*;
public class Main{
    static class Edge{
        int node;
        int w;
        public Edge(int node,int w){
            this.node=node;
            this.w=w;
        }
    }
    static void solve(LinkedList<Edge>[]adj){
        int[]dist=new int[adj.length];
        Arrays.fill(dist,Integer.MAX_VALUE);
        dist[0]=0;
        for(int i=0;i<adj.length-1;i++){
            for(int j=0;j<adj.length;j++){
                for(Edge k:adj[j]){
                    if(dist[j]!=Integer.MAX_VALUE&&dist[j]+k.w<dist[k.node])
                        dist[k.node]=dist[j]+k.w;
                }
            }
        }
        for(int i=0;i<adj.length;i++){
            for(Edge j:adj[i]){
                if(dist[i]!=Integer.MAX_VALUE&&dist[i]+j.w<dist[j.node]){
                    System.out.println("YES");
                    return;
                }
            }
        }
        System.out.println("NO");
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int w=scan.nextInt();
            LinkedList<Edge>[]adj=new LinkedList[n];
            for(int i=0;i<n;i++){
                adj[i]=new LinkedList<Edge>();
            }
            for(int i=0;i<m;i++){
                int a=scan.nextInt()-1;
                int b=scan.nextInt()-1;
                int c=scan.nextInt();
                adj[a].add(new Edge(b,c));
                adj[b].add(new Edge(a,c));
            }
            for(int i=0;i<w;i++){
                int a=scan.nextInt()-1;
                int b=scan.nextInt()-1;
                int c=scan.nextInt();
                adj[a].add(new Edge(b,-c));
            }
            solve(adj);
        }
    }
}
