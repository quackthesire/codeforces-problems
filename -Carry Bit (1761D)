import java.util.*;
public class Main{
    static int MOD=1000000007;
    static long[]fact=new long[1000005];
    static long modpow(long base,long exp){
        long res=1;
        while(exp>0){
            if(exp%2==1)
                res=(res*base)%MOD;
            base=(base*base)%MOD;
            exp/=2;
        }
        return res;
    }
    static long modinv(long base){
        return modpow(base,MOD-2);
    }
    static long choose(int n,int k){
        if(n<k||k<0)
            return 0;
        return ((fact[n]*modinv(fact[k]))%MOD*modinv(fact[n-k]))%MOD;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int k=scan.nextInt();
        fact[0]=1;
        for(int i=1;i<1000005;i++){
            fact[i]=(fact[i-1]*i)%MOD;
        }
        long ans=0;
        for(int i=1;i<=n+1;i++){
            ans=(ans+((choose(k-1,i/2-1)*choose(n-k,(i+1)/2-1))%MOD*modpow(3,n-i+1))%MOD)%MOD;
        }
        System.out.println(k==0?modpow(3,n):ans);
    }
}
