import java.util.*;
public class Main{
    static int gcd(int a,int b){
        a=Math.abs(a);
        b=Math.abs(b);
        while(b!=0){
            int temp=b;
            b=a%b;
            a=temp;
        }
        return a;
    }
    static int overlap(int n,int m,int k){
        int add=k/gcd(1-n*m,k);
        int count=0;
        for(int i=0;i<n;i+=add){
            int temp=((-i*m)%k+k)%k;
            for(int j=temp;j<m;j+=k){
                count++;
            }
        }
        return count;
    }
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int n=scan.nextInt();
	    int m=scan.nextInt();
	    for(int i=1;i<=n*m;i++){
	        System.out.print(2*((n*m-1)/i+1)-overlap(n,m,i)+" ");
	    }
	}
}
