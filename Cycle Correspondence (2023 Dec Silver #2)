import java.util.*;
public class Main{
	public static void main(String[]args){
		Scanner scan=new Scanner(System.in);
		int n=scan.nextInt();
		int k=scan.nextInt();
		int[]array=new int[k];
		int[]array2=new int[k];
		for(int i=0;i<k;i++){
		    array[i]=scan.nextInt()-1;
		}
		for(int i=0;i<k;i++){
		    array2[i]=scan.nextInt()-1;
		}
		int ans=0;
		int[]pos=new int[n];
		int[]pos2=new int[n];
		int[]revpos=new int[n];
		int[]dist=new int[2*k];
		Arrays.fill(pos,-1);
		Arrays.fill(pos2,-1);
		Arrays.fill(revpos,-1);
		for(int i=0;i<k;i++){
		    pos[array[i]]=i;
		    revpos[array[i]]=k-i-1;
		    pos2[array2[i]]=i;
		}
		for(int i=0;i<n;i++){
		    if(pos[i]!=-1&&pos2[i]!=-1){
		        dist[(pos2[i]-pos[i]+k)%k]++;
		    }
		    if(revpos[i]!=-1&&pos2[i]!=-1){
		        dist[(pos2[i]-revpos[i]+k)%k+k]++;
		    }
		}
		for(int i=0;i<2*k;i++){
		    ans=Math.max(ans,dist[i]);
		}
		boolean[]visited=new boolean[n];
		for(int i=0;i<k;i++){
		    visited[array[i]]=true;
		    visited[array2[i]]=true;
		}
		for(int i=0;i<n;i++){
		    if(visited[i]==false){
		        ans++;
		    }
		}
		System.out.println(ans);
	}
}
