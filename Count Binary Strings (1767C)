import java.util.*;
public class Main{
    static int MOD=998244353;
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int[]same=new int[n+1];
        for(int i=1;i<=n;i++){
            same[i]=i;
        }
        int[]diff=new int[n+1];
        Arrays.fill(diff,-1);
        for(int i=1;i<=n;i++){
            for(int j=i;j<=n;j++){
                int val=scan.nextInt();
                if(val==1)
                    same[j]=Math.min(same[j],i);
                if(val==2)
                    diff[j]=Math.max(diff[j],i);
            }
        }
        long[][]dp=new long[n+1][n+1];
        dp[0][0]=1;
        if(same[1]>=diff[1]&&diff[1]!=1)
            dp[1][1]=2;
        for(int i=2;i<=n;i++){
            if(same[i]<diff[i]||diff[i]==i)
                continue;
            for(int j=i-same[i]+1;j<=n;j++){
                if(diff[i]==-1||j-1<i-diff[i])
                    dp[i][j]=(dp[i][j]+dp[i-1][j-1])%MOD;
            }
            if(same[i]==i){
                for(int j=1;j<=n;j++){
                    dp[i][1]=(dp[i][1]+dp[i-1][j])%MOD;
                }
            }
            /*for(int j=1;j<=n;j++){
                System.out.print(dp[i][j]+" ");
            }
            System.out.println();
            System.out.println(i+" "+same[i]+" "+diff[i]);*/
        }
        long ans=0;
        for(int i=1;i<=n;i++){
            ans=(ans+dp[n][i])%MOD;
        }
        System.out.println(ans);
    }
}
