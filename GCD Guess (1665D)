import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int ans=0;
            System.out.println("? 2 4");
            System.out.flush();
            if(scan.nextInt()%2==1)
                ans=1;
            for(int i=1;i<30;i++){
                int pow=(int)Math.pow(2,i);
                System.out.println("? "+(pow-ans)+" "+(3*pow-ans));
                System.out.flush();
                if(scan.nextInt()>pow)
                    ans+=pow;
            }
            System.out.println("! "+ans);
        }
    }
}
