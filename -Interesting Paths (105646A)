import java.util.*;
public class Main{
    static void dfs(int u,ArrayList<Integer>[]adj,boolean[]visited){
        if(visited[u])
            return;
        visited[u]=true;
        for(int v:adj[u]){
            dfs(v,adj,visited);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int m=scan.nextInt();
        ArrayList<Integer>[]adj=new ArrayList[n];
        ArrayList<Integer>[]rev=new ArrayList[n];
        for(int i=0;i<n;i++){
            adj[i]=new ArrayList<>();
            rev[i]=new ArrayList<>();
        }
        for(int i=0;i<m;i++){
            int u=scan.nextInt()-1;
            int v=scan.nextInt()-1;
            adj[u].add(v);
            rev[v].add(u);
        }
        int ans=0;
        boolean[]start=new boolean[n];
        boolean[]end=new boolean[n];
        dfs(0,adj,start);
        dfs(n-1,rev,end);
        if(!start[n-1]){
            System.out.print(0);
            System.exit(0);
        }
        for(int i=0;i<n;i++){
            for(int j:adj[i]){
                if(start[i]&&end[j])
                    ans++;
            }
            if(start[i]&&end[i])
                ans--;
        }
        System.out.print(ans+2);
    }
}
