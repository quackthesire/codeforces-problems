import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new int[4*n];
            Arrays.fill(tree,-1);
        }
        public int query(int l,int r){
            if(l>r)
                return -1;
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return -1;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            int left=query(node*2,l,m,ll,rr);
            int right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
        public void update(int i,int val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,int val){
            if(l==r){
                tree[node]=Math.max(tree[node],val);
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt()-1;
            }
            int add=0;
            if(array[0]!=0){
                add++;
                array[0]=0;
            }
            if(array[n-1]!=m-1){
                add++;
                array[n-1]=m-1;
            }
            int[]dp=new int[n];
            dp[0]=1;
            Segtree segtree=new Segtree(n);
            Segtree segtree2=new Segtree(m+n-1);
            segtree.update(0,1);
            segtree2.update(array[0]+n-1,1);
            for(int i=1;i<n;i++){
                dp[i]=Math.max(dp[i],segtree.query(0,i-array[i]-1)+1);
                dp[i]=Math.max(dp[i],segtree2.query(m+n-i-1,m+n-2)+1);
                dp[i]=Math.max(dp[i],segtree2.query(array[i]+n-i-1,array[i]+n-i-1)+1);
                if(dp[i]!=0){
                    segtree.update(i,dp[i]);
                    segtree2.update(array[i]+n-i-1,dp[i]);
                }
            }
            System.out.println(n-dp[n-1]+add);
        }
    }
}
