import java.util.*;
public class Main{
  	public static void main(String[]args){
  	    Scanner scan=new Scanner(System.in);
  	    int n=scan.nextInt();
  	    int[]array=new int[n];
  	    for(int i=0;i<n;i++){
  	        array[i]=scan.nextInt();
  	    }
  	    int[]pos=new int[1000005];
  	    Arrays.fill(pos,-1);
  	    for(int i=0;i<n;i++){
  	        pos[array[i]]=i;
  	    }
  	    long count=0;
  	    for(int i=0;i<n;i++){
  	        for(int j=1;;j++){
  	            long val=(long)j*(2*array[i]+j);
                if(val>=1000005)
                  break;
                if(pos[(int)val]!=-1)
  	              count++;
  	        }
  	    }
  	    System.out.println(count);
  	}
}
