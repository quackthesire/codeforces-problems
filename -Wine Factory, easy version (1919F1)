import java.util.*;
public class Main{
    static class LazySegtree{
        int n;
        long[]tree;
        long[]lazy;
        int[]pos;
        public LazySegtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            lazy=new long[4*n];
            pos=new int[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                pos[node]=l;
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            pull(node);
        }
        public void pull(int node){
            if(tree[node*2]<=tree[node*2+1]){
                tree[node]=tree[node*2];
                pos[node]=pos[node*2];
            }
            else{
                tree[node]=tree[node*2+1];
                pos[node]=pos[node*2+1];
            }
        }
        public void push(int node){
            if(lazy[node]!=0){
                tree[node*2]+=lazy[node];
                lazy[node*2]+=lazy[node];
                tree[node*2+1]+=lazy[node];
                lazy[node*2+1]+=lazy[node];
                lazy[node]=0;
            }
        }
        public void update(int l,int r,long val){
            if(l>r)
                return;
            update(1,0,n-1,l,r,val);
        }
        public void update(int node,int l,int r,int ll,int rr,long val){
            if(ll>r||rr<l)
                return;
            if(ll<=l&&r<=rr){
                tree[node]+=val;
                lazy[node]+=val;
                return;
            }
            push(node);
            int m=(l+r)/2;
            update(node*2,l,m,ll,rr,val);
            update(node*2+1,m+1,r,ll,rr,val);
            pull(node);
        }
        public int query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return -1;
            if(ll<=l&&r<=rr)
                return pos[node];
            push(node);
            int m=(l+r)/2;
            int left=query(node*2,l,m,ll,rr);
            int right=query(node*2+1,m+1,r,ll,rr);
            if(left==-1)
                return right;
            if(right==-1)
                return left;
            if(tree[node*2]<=tree[node*2+1])
                return left;
            return right;
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int q=scan.nextInt();
        long sum=0;
        long[]array=new long[n];
        long[]diff=new long[n];
        for(int i=0;i<n;i++){
            array[i]=scan.nextLong();
            sum+=array[i];
        }
        for(int i=0;i<n;i++){
            diff[i]=array[i]-scan.nextLong();
        }
        for(int i=0;i<n-1;i++){
            scan.nextLong();
        }
        long[]pref=new long[n];
        for(int i=0;i<n;i++){
            pref[i]=diff[i];
            if(i!=0)
                pref[i]+=pref[i-1];
        }
        LazySegtree lazy=new LazySegtree(pref);
        Segtree segtree=new Segtree(diff);
        for(int i=0;i<q;i++){
            int index=scan.nextInt()-1;
            long x=scan.nextLong();
            long y=scan.nextLong();
            scan.nextLong();
            sum+=x-array[index];
            lazy.update(index,n-1,x-y-diff[index]);
            segtree.update(index,x-y);
            array[index]=x;
            diff[index]=x-y;
            int pos=lazy.query(0,n-1);
            if(lazy.tree[1]>=0)
                pos=-1;
            System.out.println(sum-segtree.query(pos+1,n-1));
        }
    }
}
