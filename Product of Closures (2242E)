import java.util.*;
public class Main{
    static void solve(long x,long y,int n){
        int xl=(int)(Math.log(x)/Math.log(2))+1;
        int yl=(int)(Math.log(y)/Math.log(2))+1;
        for(int i=0;i<n;i++){
            int a=(int)((x>>>(xl-(i%xl)-1))&1);
            int b=(int)((y>>>(yl-(i%yl)-1))&1);
            System.out.print(a&b);
        }
        System.out.println();
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            long l=scan.nextLong();
            long r=scan.nextLong();
            int n=scan.nextInt();
            int k=(int)(Math.log(r)/Math.log(2));
            if(l<=(long)Math.pow(2,k-1))
                solve((long)Math.pow(2,k-1),(long)Math.pow(2,k),n);
            else if(l<(long)Math.pow(2,k))
                solve(l,(long)Math.pow(2,k),n);
            else{
                int d=k;
                while(((l>>d)&1)==((r>>d)&1)){
                    d--;
                }
                solve(l,l-(l%((long)Math.pow(2,d)))+(long)Math.pow(2,d),n);
            }
        }
    }
}
