import java.util.*;
public class Main{
    static class Pair{
        int a;
        int b;
        public Pair(int a,int b){
            this.a=a;
            this.b=b;
        }
        @Override
        public boolean equals(Object other){
            return (this.a==((Pair)other).a&&this.b==((Pair)other).b)||(this.a==((Pair)other).b&&this.b==((Pair)other).a);
        }
        @Override
        public int hashCode(){
            return a+b;
        }
    }
    static class Node{
        int index;
        boolean start;
        public Node(int index,boolean start){
            this.index=index;
            this.start=start;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int k=scan.nextInt();
            int[]array=new int[m];
            HashMap<Pair,Integer>map=new HashMap<>();
            ArrayList<Node>[]segs=new ArrayList[n];
            for(int i=0;i<n;i++){
                segs[i]=new ArrayList<>();
            }
            for(int i=0;i<m;i++){
                int l=scan.nextInt()-1;
                int r=scan.nextInt();
                segs[l].add(new Node(i,true));
                if(r!=n)
                    segs[r].add(new Node(i,false));
            }
            int ans=0;
            HashSet<Integer>vals=new HashSet<>();
            for(int i=0;i<n;i++){
                for(Node j:segs[i]){
                    if(j.start)
                        vals.add(j.index);
                    else
                        vals.remove(j.index);
                }
                if(vals.size()==0)
                    ans++;
                if(vals.size()==1)
                    array[vals.iterator().next()]++;
                if(vals.size()==2){
                    Iterator<Integer>it=vals.iterator();
                    Pair pair=new Pair(it.next(),it.next());
                    map.put(pair,map.getOrDefault(pair,0)+1);
                }
            }
            int max1=0;
            int max2=0;
            for(int i=0;i<m;i++){
                if(array[i]>max1){
                    max2=max1;
                    max1=array[i];
                }
                else if(array[i]>max2)
                    max2=array[i];
            }
            int best=max1+max2;
            for(Map.Entry<Pair,Integer>entry:map.entrySet()){
                best=Math.max(best,entry.getValue()+array[entry.getKey().a]+array[entry.getKey().b]);
            }
            System.out.println(best+ans);
        }
    }
}
