import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new int[4*n];
            int[]temp=new int[n];
            Arrays.fill(temp,1);
            build(temp,1,0,n-1);
        }
        public void build(int[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public int query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            int left=query(node*2,l,m,ll,rr);
            int right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,int val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,int val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int q=scan.nextInt();
        for(int temp=0;temp<q;temp++){
            int n=scan.nextInt();
            String ss=scan.next();
            String st=scan.next();
            int[]s=new int[n];
            int[]t=new int[n];
            for(int i=0;i<n;i++){
                s[i]=ss.charAt(i)-'a';
                t[i]=st.charAt(i)-'a';
            }
            Segtree segtree=new Segtree(n);
            TreeSet<Integer>[]set=new TreeSet[26];
            for(int i=0;i<26;i++){
                set[i]=new TreeSet<>();
            }
            for(int i=0;i<n;i++){
                set[s[i]].add(i);
            }
            long count=0;
            long ans=Long.MAX_VALUE/4;
            for(int i=0;i<n;i++){
                long best=Long.MAX_VALUE/4;
                for(int j=0;j<t[i];j++){
                    if(set[j].isEmpty())
                        continue;
                    best=Math.min(best,segtree.query(0,set[j].first()-1));
                }
                ans=Math.min(ans,count+best);
                if(set[t[i]].isEmpty())
                    break;
                int first=set[t[i]].first();
                count+=segtree.query(0,first-1);
                set[t[i]].remove(first);
                segtree.update(first,0);
            }
            System.out.println(ans>=Long.MAX_VALUE/4?-1:ans);
        }
    }
}
