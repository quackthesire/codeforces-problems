import java.util.*;
public class endspeaker{
    static long MOD=1000000007;
    static class Node{
        long val;
        long count;
        public Node(long val,long count){
            this.val=val;
            this.count=count;
        }
    }
    static class Segtree{
        int n;
        Node[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new Node[4*n];
            for(int i=0;i<4*n;i++){
                tree[i]=new Node(Long.MAX_VALUE/2,0);
            }
        }
        public Node query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public Node query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return new Node(Long.MAX_VALUE/2,0);
            if(ll<=l&&r<=rr)
                return new Node(tree[node].val,tree[node].count);
            int m=(l+r)/2;
            Node left=query(node*2,l,m,ll,rr);
            Node right=query(node*2+1,m+1,r,ll,rr);
            if(left.val<right.val)
                return new Node(left.val,left.count);
            else if(left.val>right.val)
                return new Node(right.val,right.count);
            return new Node(left.val,(left.count+right.count)%MOD);
        }
        public void update(int i,Node val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,Node val){
            if(l==r){
                tree[node]=new Node(val.val,val.count);
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            Node left=tree[node*2];
            Node right=tree[node*2+1];
            if(left.val<right.val)
                tree[node]=new Node(left.val,left.count);
            else if(left.val>right.val)
                tree[node]=new Node(right.val,right.count);
            else
                tree[node]=new Node(left.val,(left.count+right.count)%MOD);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            long[]array=new long[n];
            long[]pre=new long[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextLong();
                pre[i]=array[i];
                if(i!=0)
                    pre[i]+=pre[i-1];
            }
            Segtree dp=new Segtree(n);
            for(int i=0;i<m;i++){
                long val=scan.nextLong();
                for(int j=0;j<n;j++){
                    int l=-1;
                    int r=j;
                    int res=-1;
                    while(l<=r){
                        int mid=(l+r)/2;
                        if(pre[j]-(mid==-1?0:pre[mid])<=val){
                            res=mid;
                            r=mid-1;
                        }
                        else
                            l=mid+1;
                    }
                    Node prev=dp.query(j,j);
                    Node cur=dp.query(res,j-1);
                    if(res==-1&&cur.val!=0)
                        cur=new Node(0,1);
                    else if(res==-1&&cur.val==0)
                        cur.count=(cur.count+1)%MOD;
                    cur.val+=m-i-1;
                    if(cur.val<prev.val)
                        dp.update(j,new Node(cur.val,cur.count));
                    else if(cur.val==prev.val)
                        dp.update(j,new Node(cur.val,(prev.count+cur.count)%MOD));
                }
            }
            Node ans=dp.query(n-1,n-1);
            if(ans.val>=Long.MAX_VALUE/4)
                System.out.println(-1);
            else
                System.out.println(ans.val+" "+ans.count);
        }
    }
}
