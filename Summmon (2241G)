import java.util.*;
import java.math.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=gcd(tree[node*2],tree[node*2+1]);
        }
        public int query(int i,long val){
            return query(1,0,n-1,i,val);
        }
        public int query(int node,int l,int r,int i,long val){
            if(r<i||tree[node]%val==0)
                return -1;
            if(l==r)
                return l;
            int m=(l+r)/2;
            int ans=query(node*2,l,m,i,val);
            if(ans!=-1)
                return ans;
            return query(node*2+1,m+1,r,i,val);
        }
    }
    static long gcd(long a,long b){
        while(b!=0){
            long temp=b;
            b=a%b;
            a=temp;
        }
        return a;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            long[]array=new long[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextLong();
            }
            BigInteger ans=BigInteger.ZERO;
            Segtree segtree=new Segtree(array);
            for(int i=0;i<n;i++){
                int index=segtree.query(i,array[i]);
                if(index!=-1)
                    ans=ans.add(BigInteger.valueOf((long)(n-index)*Math.min(array[index]%array[i],Math.abs(array[i]-(array[index]%array[i])))));
            }
            System.out.println(ans);
        }
    }
}
