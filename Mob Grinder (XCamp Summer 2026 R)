import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int u=scan.nextInt();
            int r=scan.nextInt();
            int d=scan.nextInt();
            int l=scan.nextInt();
            if(u<n-1||r<m-1){
                System.out.println("impossible");
                System.out.println();
                continue;
            }
            u-=(n-1);
            r-=(m-1);
            char[][]ans=new char[n][m];
            ans[0][m-1]='*';
            int need=u+l;
            int ucount=n-1;
            int rcount=m-1;
            int x=n-1;
            int y=0;
            if(ucount==0){
                for(int j=0;j<m-1;j++){
                    ans[0][j]='R';
                }
            }
            else{
                int quo=need/ucount;
                int rem=need%ucount;
                for(int i=0;i<rcount-quo-(rem>0?1:0);i++){
                    ans[x][y]='R';
                    y++;
                }
                for(int i=0;i<rem;i++){
                    ans[x][y]='U';
                    x--;
                }
                if(rem>0){
                    ans[x][y]='R';
                    y++;
                }
                for(int i=rem;i<ucount;i++){
                    ans[x][y]='U';
                    x--;
                }
                for(int i=0;i<quo;i++){
                    ans[x][y]='R';
                    y++;
                }
            }
            int[]dx={-1,1,0,0};
            int[]dy={0,0,-1,1};
            boolean[][]side=new boolean[n][m];
            boolean[][]visited=new boolean[n][m];
            ArrayDeque<Integer>q=new ArrayDeque<>();
            if(ans[n-1][m-1]==0){
                visited[n-1][m-1]=true;
                q.add((n-1)*m+m-1);
            }
            while(!q.isEmpty()){
                int cur=q.poll();
                int cx=cur/m;
                int cy=cur%m;
                side[cx][cy]=true;
                for(int i=0;i<4;i++){
                    int nx=cx+dx[i];
                    int ny=cy+dy[i];
                    if(nx<0||nx>=n||ny<0||ny>=m)
                        continue;
                    if(ans[nx][ny]!=0)
                        continue;
                    if(!visited[nx][ny]){
                        visited[nx][ny]=true;
                        q.add(nx*m+ny);
                    }
                }
            }
            for(int i=0;i<n;i++){
                for(int j=0;j<m;j++){
                    if(ans[i][j]==0&&side[i][j]){
                        if(u>0){
                            ans[i][j] = 'U';
                            u--;
                        }
                        else{
                            ans[i][j]='L';
                            l--;
                        }
                    }
                }
            }
            for(int i=0;i<n;i++){
                for(int j=0;j<m;j++){
                    if(ans[i][j]==0){
                        if(r>0){
                            ans[i][j]='R';
                            r--;
                        }
                        else{
                            ans[i][j]='D';
                            d--;
                        }
                    }
                }
            }
            for(int i=0;i<n;i++){
                for(int j=0;j<m;j++){
                    System.out.print(ans[i][j]);
                }
                if(temp==t-1&&i==n-1)
                    continue;
                System.out.println();
            }
            if(temp==t-1)
                continue;
            System.out.println();
        }
    }
}
