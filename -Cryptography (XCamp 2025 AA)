import java.util.*;
public class Main{
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    while(scan.hasNextInt()){
    	    int m=scan.nextInt();
    	    int q=scan.nextInt();
    	    int[]f=new int[1<<m];
    	    int[]g=new int[1<<m];
    	    int[]h=new int[1<<m];
    	    for(int i=0;i<1<<m;i++){
    	        f[i]=scan.nextInt();
    	    }
    	    for(int i=0;i<1<<m;i++){
    	        g[i]=scan.nextInt();
    	    }
    	    for(int i=0;i<1<<m;i++){
    	        h[i]=scan.nextInt();
    	    }
    	    for(int i=0;i<q;i++){
    	        int a=scan.nextInt();
    	        int b=scan.nextInt();
    	        int temp=b^h[a];
    	        int y=a^g[temp];
    	        int x=temp^f[y];
    	        System.out.println(x+" "+y);
    	    }
	    }
	}
}
