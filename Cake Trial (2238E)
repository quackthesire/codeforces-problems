import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            String s=scan.next();
            int[][]dp=new int[n+1][n+1];
            for(int i=0;i<=n;i++){
                Arrays.fill(dp[i],Integer.MAX_VALUE/2);
            }
            dp[0][0]=0;
            for(int i=1;i<=n;i++){
                int[][]next=new int[n+1][n+1];
                for(int j=0;j<=i;j++){
                    Arrays.fill(next[j],0,i+1,Integer.MAX_VALUE/2);
                }
                for(int j=0;j<i;j++){
                    for(int k=0;k<i;k++){
                        if(dp[j][k]==Integer.MAX_VALUE/2)
                            continue;
                        if(s.charAt(i-1)!='T')
                            next[j+1][k+1]=Math.min(next[j+1][k+1],Math.max(dp[j][k],k+1));
                        if(s.charAt(i-1)!='F')
                            next[j][Math.max(0,k-1)]=Math.min(next[j][Math.max(0,k-1)],dp[j][k]);
                    }
                }
                dp=next;
            }
            int best=0;
            for(int j=0;j<=n;j++){
                for(int k=0;k<=n;k++){
                    best=Math.max(best,j-dp[j][k]);
                }
            }
            System.out.println(best);
        }
    }
}
