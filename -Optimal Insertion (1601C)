import java.util.*;
public class Main{
    static void solve(int l,int r,int ll,int rr,int[]array,int[]vals,long[]pos){
        if(l>r)
            return;
        int m=(l+r)/2;
        long count=0;
        for(int i=ll;i<rr;i++){
            if(array[i]<vals[m])
                count++;
        }
        int best=ll;
        long bestval=count;
        for(int i=ll;i<rr;i++){
            if(array[i]<vals[m])
                count--;
            else if(array[i]>vals[m])
                count++;
            if(count<bestval){
                best=i+1;
                bestval=count;
            }
        }
        pos[m]=best;
        solve(l,m-1,ll,best,array,vals,pos);
        solve(m+1,r,best,rr,array,vals,pos);
    }
    static int bsl(int[]array,int val){
        int l=0;
        int r=array.length-1;
        while(l<=r){
            int m=(l+r)/2;
            if(array[m]<val)
                l=m+1;
            else
                r=m-1;
        }
        return l;
    }
    static int bsr(int[]array,int val){
        int l=0;
        int r=array.length-1;
        while(l<=r){
            int m=(l+r)/2;
            if(array[m]<=val)
                l=m+1;
            else
                r=m-1;
        }
        return l;
    }
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int tempvar=0;tempvar<t;tempvar++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            int[]vals=new int[m];
            for(int i=0;i<m;i++){
                vals[i]=scan.nextInt();
            }
            Arrays.sort(vals);
            long[]pos=new long[m];
            solve(0,m-1,0,n,array,vals,pos);
            int count=0;
            long ans=0;
            int[]freq=new int[n];
            int[]temp=new int[n];
            for(int i=0;i<n;i++){
                temp[i]=array[i];
            }
            Arrays.sort(temp);
            Segtree segtree=new Segtree(n);
            for(int i=0;i<n;i++){
                int index=bsl(temp,array[i]);
                ans+=segtree.query(index+1,n-1);
                freq[index]++;
                segtree.update(index,freq[index]);
                while(count<m&&pos[count]<=i){
                    count++;
                }
                ans+=count-Math.min(count,bsr(vals,array[i]));
            }
            count=m;
            for(int i=n-1;i>=0;i--){
                while(count>0&&pos[count-1]>i){
                    count--;
                }
                ans+=Math.max(0,bsl(vals,array[i])-count);
            }
            System.out.println(ans);
        }
    }
}
