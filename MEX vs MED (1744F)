import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]pos=new int[n];
            for(int i=0;i<n;i++){
                pos[scan.nextInt()]=i;
            }
            int l=n-1;
            int r=0;
            long ans=0;
            for(int i=1;i<=n;i++){
                if(i%2==1){
                    l=Math.min(l,pos[i/2]);
                    r=Math.max(r,pos[i/2]);
                }
                int left=i-(r-l+1);
                int val=Math.min(l,left)-Math.max(0,left-(n-r-1))+1;
                ans+=(val<0?0:val);
            }
            System.out.println(ans);
        }
    }
}
