import java.util.*;
public class Main{
    static int MOD=998244353;
    static int[] dfs(ArrayList<Integer>[]adj,boolean[]visited,int u,int[]array){
        array[0]++;
        array[1]+=adj[u].size();
        visited[u]=true;
        for(int v:adj[u]){
            if(u==v){
                array[1]++;
                array[2]=1;
            }
            if(visited[v])
                continue;
            dfs(adj,visited,v,array);
        }
        return array;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            char[][]board=new char[n+2][m+2];
            for(int i=0;i<=n+1;i++){
                Arrays.fill(board[i],'*');
            }
            for(int i=1;i<=n;i++){
                String s=scan.next();
                for(int j=1;j<=m;j++){
                    board[i][j]=s.charAt(j-1);
                }
            }
            ArrayList<Integer>[]adj=new ArrayList[n*m+1];
            for(int i=1;i<=n*m;i++){
                adj[i]=new ArrayList<>();
            }
            long ans=1;
            for(int i=1;i<=n;i++){
                for(int j=1;j<=m;j++){
                    if(board[i][j]!='*')
                        continue;
                    if(board[i-1][j]=='*'&&board[i+1][j]=='*')
                        ans=0;
                    else if(board[i-1][j]=='*')
                        adj[i*m+j].add(i*m+j);
                    else if(board[i+1][j]=='*')
                        adj[(i-2)*m+j].add((i-2)*m+j);
                    else{
                        adj[i*m+j].add((i-2)*m+j);
                        adj[(i-2)*m+j].add(i*m+j);
                    }
                    if(board[i][j-1]=='*'&&board[i][j+1]=='*')
                        ans=0;
                    else if(board[i][j-1]=='*')
                        adj[(i-1)*m+j+1].add((i-1)*m+j+1);
                    else if(board[i][j+1]=='*')
                        adj[(i-1)*m+j-1].add((i-1)*m+j-1);
                    else{
                        adj[(i-1)*m+j+1].add((i-1)*m+j-1);
                        adj[(i-1)*m+j-1].add((i-1)*m+j+1);
                    }
                }
            }
            boolean[]visited=new boolean[n*m+1];
            for(int i=1;i<=n*m;i++){
                if(visited[i])
                    continue;
                int[]array=dfs(adj,visited,i,new int[]{0,0,0});
                if(array[1]==2*(array[0]-1))
                    ans=(ans*array[0])%MOD;
                else if(array[1]==2*array[0])
                    ans=(ans*(array[2]==1?1:2))%MOD;
                else
                    ans=0;
            }
            System.out.println(ans);
        }
    }
}
