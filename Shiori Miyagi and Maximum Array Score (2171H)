import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return Long.MIN_VALUE/2;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=Math.max(tree[node],val);
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            Segtree segtree=new Segtree(m);
            for(int i=2;i<=n;i++){
                long[]array=new long[m/i+1];
                for(int j=0;j<=m;j+=i){
                    if(j<i)
                        continue;
                    int cur=j;
                    int count=0;
                    while(cur%i==0){
                        count++;
                        cur/=i;
                    }
                    array[j/i]=segtree.query(0,j-i)+count;
                }
                for(int j=0;j<=m/i;j++){
                    segtree.update(j*i-i,array[j]);
                }
            }
            System.out.println(segtree.query(0,m-n));
        }
    }
}
