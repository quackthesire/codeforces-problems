import java.util.*;
public class Main{
    static class Node{
        int index;
        int val;
        public Node(int index,int val){
            this.index=index;
            this.val=val;
        }
    }
    static int ord(Node node,ArrayList<Integer>[][]dp,int[][]array,int i){
        if(node.index==-1)
            return array[0][i];
        return dp[node.index][1].get(node.val)+array[node.index+1][i];
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int k=scan.nextInt();
            int[][]array=new int[n][n];
            for(int i=0;i<n;i++){
                for(int j=i;j<n;j++){
                    array[i][j]=scan.nextInt();
                }
            }
            ArrayList<Integer>[][]dp=new ArrayList[n][2];
            for(int i=0;i<n;i++){
                dp[i][0]=new ArrayList<>();//take
                dp[i][1]=new ArrayList<>();//dont take
            }
            dp[0][0].add(array[0][0]);
            dp[0][1].add(0);
            for(int i=1;i<n;i++){
                final int index=i;
                PriorityQueue<Node>pq=new PriorityQueue<>((a,b)->(ord(b,dp,array,index)-ord(a,dp,array,index)));
                for(int j=-1;j<i;j++){
                    pq.add(new Node(j,0));
                }
                while(!pq.isEmpty()&&dp[i][0].size()<k){
                    Node node=pq.poll();
                    dp[i][0].add(ord(node,dp,array,index));
                    if(node.index!=-1&&node.val!=dp[node.index][1].size()-1)
                        pq.add(new Node(node.index,node.val+1));
                }
                ArrayList<Integer>tot=new ArrayList<>();
                for(int j:dp[i-1][0]){
                    tot.add(j);
                }
                for(int j:dp[i-1][1]){
                    tot.add(j);
                }
                Collections.sort(tot,Collections.reverseOrder());
                for(int j=0;j<Math.min(tot.size(),k);j++){
                    dp[i][1].add(tot.get(j));
                }
            }
            ArrayList<Integer>ans=new ArrayList<>();
            for(int i:dp[n-1][0]){
                ans.add(i);
            }
            for(int i:dp[n-1][1]){
                ans.add(i);
            }
            Collections.sort(ans,Collections.reverseOrder());
            for(int i=0;i<k;i++){
                System.out.print(ans.get(i)+" ");
            }
            System.out.println();
        }
    }
}
