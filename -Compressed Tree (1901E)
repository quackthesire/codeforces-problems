import java.util.*;
public class Main{
    static long ans;
    static long[] dfs(int u,int p,long[]array,ArrayList<Integer>[]adj){
        long sum=0;
        long[]res=new long[2];//0 is yes parent, 1 is no parent
        Arrays.fill(res,array[u]);
        ArrayList<long[]>list=new ArrayList<>();
        for(int v:adj[u]){
            if(v==p)
                continue;
            long[]temp=dfs(v,u,array,adj);
            res[0]=Math.max(res[0],temp[0]);
            res[1]=Math.max(res[1],array[u]+temp[0]);
            list.add(temp);
        }
        Collections.sort(list,(a,b)->(Long.compare(b[0],a[0])));
        if(list.size()>=2){
            sum+=list.get(0)[0];
            sum+=list.get(1)[0];
            res[1]=Math.max(res[1],sum);
            for(int i=2;i<list.size();i++){
                sum+=Math.max(0,list.get(i)[0]);
            }
            res[0]=Math.max(res[0],array[u]+sum);
        }
        sum=0;
        if(list.size()>=3){
            sum+=list.get(0)[0];
            sum+=list.get(1)[0];
            sum+=list.get(2)[0];
            for(int i=3;i<list.size();i++){
                sum+=Math.max(0,list.get(i)[0]);
            }
            res[1]=Math.max(res[1],array[u]+sum);
        }
        ans=Math.max(ans,res[1]);
        return res;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            long[]array=new long[n];
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextLong();
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<n-1;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(v);
                adj[v].add(u);
            }
            ans=0;
            dfs(0,-1,array,adj);
            System.out.println(ans);
        }
    }
}
