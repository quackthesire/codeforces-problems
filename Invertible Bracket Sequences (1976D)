import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]tree;
        public Segtree(int[]array){
            n=array.length;
            tree=new int[4*n];
            build(array,1,0,n-1);
        }
        public void build(int[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
        public int query(int l,int r,int val){
            return query(1,0,n-1,l,r,val);
        }
        public int query(int node,int l,int r,int ll,int rr,int val){
            if(r<ll||l>rr||tree[node]<=val)
                return -1;
            if(l==r)
                return l;
            int m=(l+r)/2;
            int res=query(node*2,l,m,ll,rr,val);
            if(res!=-1)
                return res;
            return query(node*2+1,m+1,r,ll,rr,val);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            String s=scan.next();
            int n=s.length();
            int[]array=new int[n];
            ArrayList<Integer>[]pos=new ArrayList[n/2+1];
            for(int i=0;i<=n/2;i++){
                pos[i]=new ArrayList<>();
            }
            array[0]=1;
            pos[1].add(0);
            for(int i=1;i<n;i++){
                array[i]=array[i-1]+(s.charAt(i)=='('?1:-1);
                pos[array[i]].add(i);
            }
            long count=0;
            Segtree segtree=new Segtree(array);
            for(int i=0;i<=n/2;i++){
                for(int j=0;j<pos[i].size();j++){
                    int limit=segtree.query(pos[i].get(j)+1,n-1,2*array[pos[i].get(j)]);
                    int l=j+1;
                    int r=pos[i].size()-1;
                    while(l<=r){
                        int m=(l+r)/2;
                        if(limit==-1||pos[i].get(m)<limit)
                            l=m+1;
                        else
                            r=m-1;
                    }
                    count+=l-j-1;
                }
            }
            System.out.println(count);
        }
    }
}
