import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]tree;
        public Segtree(int[]array){
            this.n=array.length;
            tree=new int[4*n];
            build(array,1,0,n-1);
        }
        public void build(int[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
        public int query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return Integer.MAX_VALUE/2;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            int left=query(node*2,l,m,ll,rr);
            int right=query(node*2+1,m+1,r,ll,rr);
            return Math.min(left,right);
        }
        public void update(int i,int val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,int val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]a=new int[n];
            int[]b=new int[n];
            ArrayList<Integer>[]posa=new ArrayList[n];
            ArrayList<Integer>[]posb=new ArrayList[n];
            for(int i=0;i<n;i++){
                posa[i]=new ArrayList<>();
                posb[i]=new ArrayList<>();
            }
            for(int i=0;i<n;i++){
                a[i]=scan.nextInt()-1;
                posa[a[i]].add(i);
            }
            for(int i=0;i<n;i++){
                b[i]=scan.nextInt()-1;
                posb[b[i]].add(i);
            }
            boolean work=true;
            for(int i=0;i<n;i++){
                if(posa[i].size()!=posb[i].size()){
                    work=false;
                    break;
                }
            }
            if(!work){
                System.out.println("NO");
                continue;
            }
            int[]index=new int[n];
            Segtree segtree=new Segtree(a);
            for(int i=0;i<n;i++){
                int pos=posa[b[i]].get(index[b[i]]);
                if(segtree.query(0,pos)!=a[pos]){
                    work=false;
                    break;
                }
                index[b[i]]++;
                segtree.update(pos,Integer.MAX_VALUE/2);
            }
            System.out.println(work?"YES":"NO");
        }
    }
}
