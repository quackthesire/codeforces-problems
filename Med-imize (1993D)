import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int k=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            int[]sort=array.clone();
            Arrays.sort(sort);
            int l=0;
            int r=n-1;
            while(l<=r){
                int m=(l+r)/2;
                int[]vals=new int[n];
                for(int i=0;i<n;i++){
                    vals[i]=(array[i]>=sort[m]?1:-1);
                }
                int ans=0;
                int remove=n/k-(n%k==0?1:0);
                int keep=n-k*remove;
                int[][]dp=new int[keep+1][remove+1];
                for(int i=0;i<=keep;i++){
                    Arrays.fill(dp[i],Integer.MIN_VALUE);
                }
                dp[0][0]=0;
                for(int i=0;i<=keep;i++){
                    for(int j=0;j<=remove;j++){
                        if(dp[i][j]==Integer.MIN_VALUE)
                            continue;
                        int pos=i+k*j;
                        if(i<keep)
                            dp[i+1][j]=Math.max(dp[i+1][j],dp[i][j]+vals[pos]);
                        if(j<remove)
                            dp[i][j+1]=Math.max(dp[i][j+1],dp[i][j]);
                    }
                }
                ans=dp[keep][remove];
                if(ans>0)
                    l=m+1;
                else
                    r=m-1;
            }
            System.out.println(r>=0?sort[r]:0);
        }
    }
}
