import java.util.*;
public class Main{
    static class Node implements Comparable<Node>{
        int pos;
        int index;
        boolean start;
        public Node(int pos,int index,boolean start){
            this.pos=pos;
            this.index=index;
            this.start=start;
        }
        public int compareTo(Node other){
            if(this.pos==other.pos){
                if(this.start==other.start)
                    return 0;
                if(this.start)
                    return -1;
                return 1;
            }
            return this.pos-other.pos;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[][]array=new int[n][3];
            TreeMap<Integer,ArrayList<Node>>list=new TreeMap<>();
            for(int i=0;i<n;i++){
                int a=scan.nextInt();
                int b=scan.nextInt();
                int m=scan.nextInt();
                array[i][0]=a;
                array[i][1]=b;
                array[i][2]=m;
                list.putIfAbsent(a+b-m,new ArrayList<>());
                list.get(a+b-m).add(new Node(Math.max(0,a-m),i,true));
                list.get(a+b-m).add(new Node(Math.min(a,a+b-m),i,false));
            }
            int count=0;
            int[][]ans=new int[n][2];
            for(ArrayList<Node>nodes:list.values()){
                Collections.sort(nodes);
                boolean req=false;
                HashSet<Integer>active=new HashSet<>();
                for(int j=0;j<nodes.size();j++){
                    Node node=nodes.get(j);
                    if(j!=nodes.size()-1&&node.pos==nodes.get(j+1).pos){
                        if(node.start)
                            active.add(node.index);
                        else if(active.contains(node.index))
                            req=true;
                        continue;
                    }
                    if(node.start)
                        active.add(node.index);
                    else if(active.contains(node.index))
                        req=true;
                    if(req){
                        count++;
                        for(int k:active){
                            int left=array[k][0]+array[k][1]-array[k][2]-node.pos;
                            ans[k][0]=array[k][0]-node.pos;
                            ans[k][1]=array[k][1]-left;
                        }
                        req=false;
                        active=new HashSet<>();
                    }
                }
            }
            System.out.println(count);
            for(int i=0;i<n;i++){
                System.out.println(ans[i][0]+" "+ans[i][1]);
            }
        }
    }
}
