import java.util.*;
public class Main{
    static class MaxSegtree{
        int n;
        int[]tree;
        public MaxSegtree(int n){
            this.n=n;
            tree=new int[4*n];
            Arrays.fill(tree,-1);
        }
        public int query(int l,int r){
            if(l>r)
                return -1;
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return -1;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            return Math.max(query(node*2,l,m,ll,rr),query(node*2+1,m+1,r,ll,rr));
        }
        public void update(int i,int val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,int val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public void build(long[]array){
            build(1,0,n-1,array);
        }
        public void build(int node,int l,int r,long[]array){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(node*2,l,m,array);
            build(node*2+1,m+1,r,array);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public long query(int l,int r){
            if(l>r)
                return 0;
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            return query(node*2,l,m,ll,rr)+query(node*2+1,m+1,r,ll,rr);
        }
        public void add(int i,long val){
            add(1,0,n-1,i,val);
        }
        public void add(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]+=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                add(node*2,l,m,i,val);
            else
                add(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public void set(int i,long val){
            set(1,0,n-1,i,val);
        }
        public void set(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                set(node*2,l,m,i,val);
            else
                set(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    static class Node{
        int r;
        int index;
        public Node(int r,int index){
            this.r=r;
            this.index=index;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int q=scan.nextInt();
        int[]array=new int[n];
        int[]prev=new int[n];
        int[]last=new int[n];
        long[]freq=new long[n];
        Arrays.fill(last,-1);
        for(int i=0;i<n;i++){
            array[i]=scan.nextInt()-1;
            prev[i]=last[array[i]];
            last[array[i]]=i;
            freq[array[i]]++;
        }
        ArrayList<Integer>[]list=new ArrayList[n];
        for(int i=0;i<n;i++){
            list[i]=new ArrayList<>();
        }
        MaxSegtree maxtree=new MaxSegtree(n);
        for(int i=0;i<n;i++){
            int val=last[i];
            while(val!=-1&&prev[val]!=-1){
                list[maxtree.query(prev[val]+1,val-1)+1].add(i);
                val=prev[val];
            }
            val=last[i];
            while(val!=-1){
                maxtree.update(val,i);
                val=prev[val];
            }
        }
        ArrayList<Node>[]query=new ArrayList[n];
        for(int i=0;i<n;i++){
            query[i]=new ArrayList<>();
        }
        for(int i=0;i<q;i++){
            query[scan.nextInt()-1].add(new Node(scan.nextInt()-1,i));
        }
        long[]ans=new long[q];
        Segtree segtree=new Segtree(n);
        segtree.build(freq);
        for(int i=0;i<n;i++){
            for(int val:list[i]){
                segtree.add(val,-1);
            }
            for(Node node:query[i]){
                ans[node.index]=segtree.query(i,node.r);
            }
        }
        for(int i=0;i<q;i++){
            System.out.println(ans[i]);
        }
    }
}
