import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(long[]array){
            n=array.length;
            tree=new long[4*n];
            build(1,0,n-1,array);
        }
        public void build(int node,int l,int r,long[]array){
            if(l==r)
                tree[node]=array[l];
            else{
                int m=(l+r)/2;
                build(node*2,l,m,array);
                build(node*2+1,m+1,r,array);
                tree[node]=Math.max(tree[2*node],tree[2*node+1]);
            }
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(rr<l||r<ll)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
    }
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int n=scan.nextInt();
	    long[]a=new long[n];
	    long[]b=new long[n];
	    for(int i=0;i<n;i++){
	        a[i]=scan.nextLong();
	        b[i]=scan.nextLong();
	    }
	    Segtree segtree=new Segtree(a);
	    int best=0;
	    int l=0;
	    int r=0;
	    while(r!=n-1){
	        long max=segtree.query(1,0,n-1,l,r);
	        if(max<=b[r+1])
	            r++;
	        else
	            l++;
	        best=Math.max(best,r-l+1);
	    }
	    System.out.println(best);
	}
}
