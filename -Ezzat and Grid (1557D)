import java.util.*;
public class Main{
    static class Node{
        int l;
        int r;
        public Node(int l,int r){
            this.l=l;
            this.r=r;
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        long[]lazy;
        int[]row;
        int[]rowlazy;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
            lazy=new long[4*n];
            row=new int[4*n];
            rowlazy=new int[4*n];
        }
        public void update(int l,int r,long val,int index){
            update(1,0,n-1,l,r,val,index);
        }
        public void update(int node,int l,int r,int ll,int rr,long val,int index){
            if(ll<=l&&r<=rr){
                tree[node]=val;
                row[node]=index;
                lazy[node]=val;
                rowlazy[node]=index;
                return;
            }
            push(node);
            int m=(l+r)/2;
            if(ll<=m)
                update(node*2,l,m,ll,rr,val,index);
            if(rr>m)
                update(node*2+1,m+1,r,ll,rr,val,index);
            if(tree[node*2]>=tree[node*2+1]){
                tree[node]=tree[node*2];
                row[node]=row[node*2];
            }
            else{
                tree[node]=tree[node*2+1];
                row[node]=row[node*2+1];
            }
        }
        public void push(int node){
            if(lazy[node]==0)
                return;
            tree[node*2]=lazy[node];
            tree[node*2+1]=lazy[node];
            row[node*2]=rowlazy[node];
            row[node*2+1]=rowlazy[node];
            lazy[node*2]=lazy[node];
            lazy[node*2+1]=lazy[node];
            rowlazy[node*2]=rowlazy[node];
            rowlazy[node*2+1]=rowlazy[node];
            lazy[node]=0;
            rowlazy[node]=0;
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            push(node);
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
        public int prev(int l,int r,long val){
            return prev(1,0,n-1,l,r,val);
        }
        public int prev(int node,int l,int r,int ll,int rr,long val){
            if(ll>r||rr<l||tree[node]<val)
                return -1;
            if(l==r)
                return row[node];
            push(node);
            int m=(l+r)/2;
            int res=-1;
            if(ll<=m)
                res=prev(node*2,l,m,ll,rr,val);
            if(res==-1&&rr>m)
                res=prev(node*2+1,m+1,r,ll,rr,val);
            return res;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int m=scan.nextInt();
        ArrayList<Node>[]array=new ArrayList[n];
        for(int i=0;i<n;i++){
            array[i]=new ArrayList<>();
        }
        int count=0;
        int[]vals=new int[2*m];
        for(int i=0;i<m;i++){
            int j=scan.nextInt()-1;
            int l=scan.nextInt();
            int r=scan.nextInt();
            array[j].add(new Node(l,r));
            vals[count]=l;
            count++;
            vals[count]=r;
            count++;
        }
        Arrays.sort(vals);
        int size=0;
        for(int i=0;i<count;i++){
            if(i==0||vals[i]!=vals[i-1])
                vals[size++]=vals[i];
        }
        HashMap<Integer,Integer>map=new HashMap<>();
        for(int i=0;i<size;i++){
            map.put(vals[i],i);
        }
        int best=0;
        int last=0;
        int[]dp=new int[n];
        int[]parent=new int[n];
        Arrays.fill(parent,-1);
        Segtree segtree=new Segtree(size);

        for(int i=0;i<n;i++){
            int cur=0;
            int prev=-1;

            for(Node node:array[i]){
                int l=map.get(node.l);
                int r=map.get(node.r);
                long res=segtree.query(l,r);

                if(res>cur){
                    cur=(int)res;
                    prev=segtree.prev(l,r,res);
                }
            }

            dp[i]=cur+1;
            parent[i]=prev;

            if(dp[i]>best){
                best=dp[i];
                last=i;
            }

            for(Node node:array[i]){
                int l=map.get(node.l);
                int r=map.get(node.r);
                segtree.update(l,r,dp[i],i);
            }
        }

        boolean[]work=new boolean[n];

        while(last!=-1){
            work[last]=true;
            last=parent[last];
        }

        ArrayList<Integer>ans=new ArrayList<>();

        for(int i=0;i<n;i++){
            if(!work[i])
                ans.add(i+1);
        }

        System.out.println(ans.size());
        for(int i:ans){
            System.out.print(i+" ");
        }
    }
}
