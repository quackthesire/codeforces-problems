import java.util.*;
public class Main{
    static class Node implements Comparable<Node>{
        int index;
        int val;
        public Node(int index,int val){
            this.index=index;
            this.val=val;
        }
        public int compareTo(Node other){
            return this.val-other.val;
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public int kth(long k){
            if(tree[1]<k)
                return n+1;
            return kth(1,0,n-1,k);
        }
        public int kth(int node,int l,int r,long k){
            if(l==r)
                return l;
            int m=(l+r)/2;
            if(tree[node*2]>=k)
                return kth(node*2,l,m,k);
            return kth(node*2+1,m+1,r,k-tree[node*2]);
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]+=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int q=scan.nextInt();
        int[]array=new int[n+1];
        ArrayList<Integer>[]list=new ArrayList[200001];
        ArrayList<Node>[]query=new ArrayList[n+1];
        for(int i=0;i<=200000;i++){
            list[i]=new ArrayList<>();
        }
        for(int i=1;i<=n;i++){
            query[i]=new ArrayList<>();
        }
        for(int i=1;i<=n;i++){
            array[i]=scan.nextInt();
            list[array[i]].add(i);
        }
        for(int i=1;i<=q;i++){
            int index=scan.nextInt();
            int k=scan.nextInt();
            query[k].add(new Node(i,index));
        }
        for(int i=1;i<=n;i++){
            Collections.sort(query[i]);
        }
        int last=n;
        int[]pos=new int[n+1];
        boolean[]ans=new boolean[q+1];
        int[]index=new int[n+1];
        long[]temp=new long[n+1];
        for(int i=1;i<=n;i++){
            temp[i]=1;
        }
        Segtree segtree=new Segtree(temp);
        for(int i=1;i<=n;i++){
            int next=last;
            for(int j=1;j<=last;j++){
                int cur=segtree.kth(segtree.query(1,pos[j])+j);
                if(cur>n)
                    next=Math.min(next,j-1);
                pos[j]=cur;
                while(index[j]<query[j].size()){
                    Node node=query[j].get(index[j]);
                    if(node.val>cur)
                        break;
                    ans[node.index]=(i<=array[node.val]);
                    index[j]++;
                }
            }
            last=next;
            for(int j:list[i]){
                segtree.update(j,-1);
            }
        }
        for(int i=1;i<=q;i++){
            System.out.println(ans[i]?"YES":"NO");
        }
    }
}
