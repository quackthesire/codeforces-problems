import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            ArrayList<Integer>valid=new ArrayList<>();
            for(int i=1;i<=n;i++){
                valid.add(i);
            }
            for(int i=0;i<n-2;i++){
                int a=valid.get(valid.size()-1);
                int b=valid.get(valid.size()-2);
                int c=valid.get(valid.size()-3);
                System.out.println("? "+a+" "+b);
                System.out.flush();
                int ab=scan.nextInt();
                System.out.println("? "+a+" "+c);
                System.out.flush();
                int ac=scan.nextInt();
                if(ab==ac)
                    valid.remove(valid.size()-1);
                else if(ab<ac)
                    valid.remove(valid.size()-2);
                else
                    valid.remove(valid.size()-3);
            }
            System.out.println("! "+valid.get(0)+" "+valid.get(1));
            System.out.flush();
            if(scan.nextInt()==-1)
                System.exit(0);
        }
    }
}
