import java.util.*;
public class Main{
    static HashSet<Integer>inf;
    static HashSet<Integer>mult;
    static void dfs(int u,ArrayList<Integer>[]adj,int[]visited){
        visited[u]=1;
        for(int v:adj[u]){
            if(visited[v]==0)
                dfs(v,adj,visited);
            else if(visited[v]==1)
                inf.add(v);
            else if(visited[v]==2)
                mult.add(v);
        }
        visited[u]=2;
    }
    static void dfs2(int u,ArrayList<Integer>[]adj,HashSet<Integer>set){
        set.add(u);
        for(int v:adj[u]){
            if(set.contains(v))
                continue;
            dfs2(v,adj,set);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<m;i++){
                adj[scan.nextInt()-1].add(scan.nextInt()-1);
            }
            int[]visited=new int[n];
            inf=new HashSet<>();
            mult=new HashSet<>();
            dfs(0,adj,visited);
            for(int i:new HashSet<>(inf)){
                dfs2(i,adj,inf);
            }
            for(int i:new HashSet<>(mult)){
                dfs2(i,adj,mult);
            }
            for(int i=0;i<n;i++){
                if(visited[i]==0)
                    System.out.print(0+" ");
                else if(inf.contains(i))
                    System.out.print(-1+" ");
                else if(mult.contains(i))
                    System.out.print(2+" ");
                else
                    System.out.print(1+" ");
            }
            System.out.println();
        }
    }
}
