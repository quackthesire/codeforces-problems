import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int[]array=new int[n];
        for(int i=0;i<n;i++){
            array[i]=scan.nextInt();
        }
        Arrays.sort(array);
        int[]spf=new int[500000];
        for(int i=1;i<500000;i++){
            spf[i]=i;
        }
        for(int i=2;i*i<500000;i++){
            if(spf[i]!=i)
                continue;
            for(int j=i*i;j<500000;j+=i){
                if(spf[j]==j)
                    spf[j]=i;
            }
        }
        long ans=0;
        long[]count=new long[500000];
        long[]sum=new long[500000];
        for(int i=0;i<n;i++){
            int val=array[i];
            HashSet<Integer>fact=new HashSet<>();
            while(val>1){
                fact.add(spf[val]);
                val/=spf[val];
            }
            ArrayList<Integer>list=new ArrayList<>(fact);
            for(int j=0;j<(1<<list.size());j++){
                int mult=1;
                for(int k=0;k<list.size();k++){
                    if((j&(1<<k))!=0)
                        mult*=list.get(k);
                }
                if(Integer.bitCount(j)%2==0)
                    ans+=count[mult]*(i-1)-sum[mult];
                else
                    ans-=count[mult]*(i-1)-sum[mult];
            }
            for(int j=0;j<(1<<list.size());j++){
                int mult=1;
                for(int k=0;k<list.size();k++){
                    if((j&(1<<k))!=0)
                        mult*=list.get(k);
                }
                count[mult]++;
                sum[mult]+=i;
            }
        }
        System.out.print(ans);
    }
}
