import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]+=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        String s=scan.next();
        int[]pre=new int[n];
        pre[0]=3*n+3+(s.charAt(0)=='0'?1:-3);
        for(int i=1;i<n;i++){
            pre[i]=pre[i-1]+(s.charAt(i)=='0'?1:-3);
        }
        long ans=0;
        Segtree segtree=new Segtree(4*n+10);
        segtree.update(3*n+3,1);
        for(int i=0;i<n;i++){
            ans+=segtree.query(0,pre[i]-2);
            ans+=segtree.query(pre[i]+1,pre[i]+1);
            segtree.update(pre[i],1);
        }
        System.out.print(ans);
    }
}
