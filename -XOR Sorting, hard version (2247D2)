import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int q=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++) array[i]=scan.nextInt();
            int len=(int)Math.ceil(Math.log(n)/Math.log(2))+1;
            int[]count=new int[len];
            ArrayList<Integer>[]min=new ArrayList[len];
            ArrayList<Integer>[]max=new ArrayList[len];
            for(int i=0;i<len;i++){
                min[i]=new ArrayList<>();
                max[i]=new ArrayList<>();
            }
            for(int i=0;i<n;i++){
                min[0].add(array[i]);
                max[0].add(array[i]);
                if(i!=0&&min[0].get(i)<max[0].get(i-1))
                    count[0]++;
            }
            for(int i=1;i<len;i++){
                for(int j=0;j<(n+(1<<i)-1)/(1<<i);j++){
                    min[i].add(min[i-1].get(j*2));
                    max[i].add(max[i-1].get(j*2));
                    if(j*2+1<min[i-1].size()){
                        min[i].set(j,Math.min(min[i].get(j),min[i-1].get(j*2+1)));
                        max[i].set(j,Math.max(max[i].get(j),max[i-1].get(j*2+1)));
                    }
                }
                for(int j=0;j<(n+(1<<i)-1)/(1<<i)-1;j++){
                    if(min[i].get(j+1)<max[i].get(j))
                        count[i]++;
                }
            }
            for(int i=0;i<len;i++){
                if(count[i]==0){
                    System.out.println(i==0?0:1<<(i-1));
                    break;
                }
            }
            for(int i=0;i<q;i++){
                int pos=scan.nextInt();
                int value=scan.nextInt();
                array[pos]=value;
                for(int j=0;j<len;j++){
                    int block=pos>>j;
                    if(block>0&&max[j].get(block-1)>min[j].get(block))
                        count[j]--;
                    if(block+1<min[j].size()&&max[j].get(block)>min[j].get(block+1))
                        count[j]--;
                    if(j==0){
                        min[j].set(block,value);
                        max[j].set(block,value);
                    }
                    else{
                        min[j].set(block,min[j-1].get(block*2));
                        max[j].set(block,max[j-1].get(block*2));
                        if(block*2+1<min[j-1].size()){
                            min[j].set(block,Math.min(min[j].get(block),min[j-1].get(block*2+1)));
                            max[j].set(block,Math.max(max[j].get(block),max[j-1].get(block*2+1)));
                        }
                    }
                    if(block>0&&max[j].get(block-1)>min[j].get(block))
                        count[j]++;
                    if(block+1<min[j].size()&&max[j].get(block)>min[j].get(block+1))
                        count[j]++;
                }
                for(int j=0;j<len;j++){
                    if(count[j]==0){
                        System.out.println(j==0?0:1<<(j-1));
                        break;
                    }
                }
            }
        }
    }
}
