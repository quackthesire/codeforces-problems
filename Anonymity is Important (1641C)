import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return n;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.min(left,right);
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int q=scan.nextInt();
        long[]vals=new long[n];
        long[]temp=new long[n];
        Arrays.fill(vals,n);
        Arrays.fill(temp,n);
        Segtree segtree=new Segtree(temp);
        TreeSet<Integer>set=new TreeSet<>();
        for(int i=0;i<n;i++){
            set.add(i);
        }
        for(int i=0;i<q;i++){
            if(scan.nextInt()==0){
                int l=scan.nextInt()-1;
                int r=scan.nextInt()-1;
                if(scan.nextInt()==0){
                    while(set.ceiling(l)!=null&&set.ceiling(l)<=r){
                        set.remove(set.ceiling(l));
                    }
                }
                else{
                    vals[l]=Math.min(vals[l],r);
                    segtree.update(l,vals[l]);
                }
            }
            else{
                int index=scan.nextInt()-1;
                if(!set.contains(index)){
                    System.out.println("NO");
                    continue;
                }
                int floor=(set.floor(index-1)==null?-1:set.floor(index-1));
                int ceil=(set.ceiling(index+1)==null?n:set.ceiling(index+1));
                System.out.println(segtree.query(floor+1,index)<ceil?"YES":"N/A");
            }
        }
    }
}
