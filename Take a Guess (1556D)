import java.util.*;
public class Main{
    static Scanner scan=new Scanner(System.in);
    static long sum(int a,int b){
        System.out.println("or "+(a+1)+" "+(b+1));
        System.out.flush();
        System.out.println("and "+(a+1)+" "+(b+1));
        System.out.flush();
        return scan.nextLong()+scan.nextLong();
    }
    public static void main(String[]args){
        int n=scan.nextInt();
        int k=scan.nextInt();
        long[]array=new long[n];
        for(int i=0;i<n;i+=3){
            if(i<n-2){
                long a=sum(i,i+1);
                long b=sum(i,i+2);
                long c=sum(i+1,i+2);
                array[i+1]=(a+c-b)/2;
                array[i]=a-array[i+1];
                array[i+2]=c-array[i+1];
            }
            else if(i<n-1){
                long a=sum(i,i+1);
                long b=sum(i-1,i);
                array[i]=b-array[i-1];
                array[i+1]=a-array[i];
            }
            else{
                long a=sum(i-1,i);
                array[i]=a-array[i-1];
            }
        }
        Arrays.sort(array);
        System.out.println("finish "+array[k-1]);
    }
}
