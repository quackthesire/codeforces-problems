import java.util.*;
public class Main{
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int n=scan.nextInt();
	    ArrayList<Integer>nums=new ArrayList<>();
	    for(int i=0;i<n;i++){
	        nums.add(i);
	    }
	    for(int i=0;i<14;i++){
	        for(int j=0;j<14;j++){
    	        Collections.shuffle(nums);
    	        ArrayList<Integer>temp=new ArrayList<>();
    	        for(int k=0;k<(int)Math.pow(2,i);k++){
    	            temp.add(nums.get(k));
    	        }
    	        for(int k=0;k<n;k++){
    	            if(temp.contains(k))
    	                System.out.print("1");
    	            else
    	                System.out.print("0");
    	        }
    	        System.out.println();
    	        if(scan.next().charAt(0)=='+')
    	            System.exit(0);
	        }
	    }
	}
}
