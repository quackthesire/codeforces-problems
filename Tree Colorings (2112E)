import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        long[]dp=new long[1000000];
        Arrays.fill(dp,Long.MAX_VALUE/2);
        dp[1]=1;
        for(int i=2;i<1000000;i++){
            for(int j=1;j*j<=i;j++){
                if(i%j!=0)
                    continue;
                if(j>2)
                    dp[i]=Math.min(dp[i],dp[i/j]+dp[j-2]);
                if(i/j>2)
                    dp[i]=Math.min(dp[i],dp[j]+dp[i/j-2]);
            }
        }
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            System.out.println(dp[n]==Long.MAX_VALUE/2?-1:dp[n]);
        }
    }
}
