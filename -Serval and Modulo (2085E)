import java.util.*;
public class Main{
    static boolean solve(long mod,long[]a,long[]b){
        long[]temp=new long[a.length];
        for(int i=0;i<a.length;i++){
            temp[i]=a[i]%mod;
        }
        Arrays.sort(temp);
        for(int i=0;i<a.length;i++){
            if(temp[i]!=b[i])
                return false;
        }
        return true;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            long[]a=new long[n];
            long[]b=new long[n];
            long sum=0;
            long max=0;
            for(int i=0;i<n;i++){
                a[i]=scan.nextLong();
                sum+=a[i];
                max+=a[i];
            }
            for(int i=0;i<n;i++){
                b[i]=scan.nextLong();
                sum-=b[i];
            }
            Arrays.sort(b);
            boolean work=false;
            for(int i=1;i*i<=sum;i++){
                if(sum%i!=0)
                    continue;
                if(solve(i,a,b)){
                    work=true;
                    System.out.println(i);
                    break;
                }
                if(solve(sum/i,a,b)){
                    work=true;
                    System.out.println(sum/i);
                    break;
                }
            }
            if(solve(max+1,a,b)){
                work=true;
                System.out.println(max+1);
            }
            if(!work)
                System.out.println(-1);
        }
    }
}
