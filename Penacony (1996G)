import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]count;
        long[]min;
        long[]lazy;
        public Segtree(int n){
            this.n=n;
            count=new int[4*n];
            min=new long[4*n];
            lazy=new long[4*n];
            build(1,0,n-1);
        }
        public void build(int node,int l,int r){
            if(l==r){
                min[node]=0;
                count[node]=1;
                return;
            }
            int m=(l+r)/2;
            build(node*2,l,m);
            build(node*2+1,m+1,r);
            merge(node);
        }
        public void merge(int node){
            if(min[node*2]<min[node*2+1]){
                min[node]=min[node*2];
                count[node]=count[node*2];
            }
            else if(min[node*2+1]<min[node*2]){
                min[node]=min[node*2+1];
                count[node]=count[node*2+1];
            }
            else{
                min[node]=min[node*2];
                count[node]=count[node*2]+count[node*2+1];
            }
        }
        public void push(int node){
            if(lazy[node]==0)
                return;
            min[node*2]+=lazy[node];
            min[node*2+1]+=lazy[node];
            lazy[node*2]+=lazy[node];
            lazy[node*2+1]+=lazy[node];
            lazy[node]=0;
        }
        public void update(int l,int r,long val){
            update(1,0,n-1,l,r,val);
        }
        public void update(int node,int l,int r,int ll,int rr,long val){
            if(ll>r||rr<l)
                return;
            if(ll<=l&&r<=rr){
                min[node]+=val;
                lazy[node]+=val;
                return;
            }
            push(node);
            int m=(l+r)/2;
            update(node*2,l,m,ll,rr,val);
            update(node*2+1,m+1,r,ll,rr,val);
            merge(node);
        }
        public int query(){
            if(min[1]==0)
                return count[1];
            return 0;
        }
    }
    static class Node{
        int other;
        boolean start;
        public Node(int other,boolean start){
            this.other=other;
            this.start=start;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            Segtree segtree=new Segtree(n);
            ArrayList<Node>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<m;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(new Node(v,true));
                adj[v].add(new Node(u,false));
                segtree.update(u,v-1,1);
            }
            int ans=n-segtree.query();
            for(int i=0;i<n;i++){//road from i to i+1
                for(Node node:adj[i]){
                    if(node.start){
                        segtree.update(0,i-1,1);
                        segtree.update(node.other,n-1,1);
                        segtree.update(i,node.other-1,-1);
                    }
                    else{
                        segtree.update(0,node.other-1,-1);
                        segtree.update(i,n-1,-1);
                        segtree.update(node.other,i-1,1);
                    }
                }
                ans=Math.min(ans,n-segtree.query());
            }
            System.out.println(ans);
        }
    }
}
