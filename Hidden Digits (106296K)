import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        if(n>=3){
            System.out.println("! 1");
            System.exit(0);
        }
        System.out.println("? 1");
        int a=scan.nextInt();
        if(n==2){
            System.out.println("? 2");
            int b=scan.nextInt();
            if(a%3==0||b%3==0||(a+b)%3==0)
                System.out.println("! 1");
            else
                System.out.println("! 0");
        }
        else{
            if(a%3==0)
                System.out.println("! 1");
            else
                System.out.println("! 0");
        }
    }
}
