import java.util.*;
public class Main{
    static void dfs1(int u,ArrayList<Integer>[]adj,boolean[]visited,ArrayList<Integer>order){
        visited[u]=true;
        for(int v:adj[u]){
            if(!visited[v])
                dfs1(v,adj,visited,order);
        }
        order.add(u);
    }
    static void dfs2(int u,ArrayList<Integer>[]adj,boolean[]visited,int[]comp,int index){
        visited[u]=true;
        comp[u]=index;
        for(int v:adj[u]){
            if(!visited[v])
                dfs2(v,adj,visited,comp,index);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]a=new int[n];
            int[]b=new int[n];
            int[]c=new int[n];
            for(int i=0;i<n;i++){
                a[i]=scan.nextInt();
            }
            for(int i=0;i<n;i++){
                b[i]=scan.nextInt();
            }
            for(int i=0;i<n;i++){
                c[i]=scan.nextInt();
            }
            ArrayList<Integer>[]adj=new ArrayList[2*n+1];
            ArrayList<Integer>[]rev=new ArrayList[2*n+1];
            for(int i=0;i<=2*n;i++){
                adj[i]=new ArrayList<>();
                rev[i]=new ArrayList<>();
            }
            for(int i=0;i<n;i++){
                adj[-a[i]+n].add(b[i]+n);
                rev[b[i]+n].add(-a[i]+n);
                adj[-b[i]+n].add(a[i]+n);
                rev[a[i]+n].add(-b[i]+n);
                adj[-a[i]+n].add(c[i]+n);
                rev[c[i]+n].add(-a[i]+n);
                adj[-c[i]+n].add(a[i]+n);
                rev[a[i]+n].add(-c[i]+n);
                adj[-b[i]+n].add(c[i]+n);
                rev[c[i]+n].add(-b[i]+n);
                adj[-c[i]+n].add(b[i]+n);
                rev[b[i]+n].add(-c[i]+n);
            }
            boolean[]visited=new boolean[2*n+1];
            ArrayList<Integer>order=new ArrayList<>();
            for(int i=1;i<=n;i++){
                if(!visited[i+n])
                    dfs1(i+n,adj,visited,order);
                if(!visited[-i+n])
                    dfs1(-i+n,adj,visited,order);
            }
            Arrays.fill(visited,false);
            int count=0;
            int[]comp=new int[2*n+1];
            for(int i=order.size()-1;i>=0;i--){
                if(visited[order.get(i)])
                    continue;
                count++;
                dfs2(order.get(i),rev,visited,comp,count);
            }
            boolean work=true;
            for(int i=1;i<=n;i++){
                if(comp[i+n]==comp[-i+n]){
                    work=false;
                    break;
                }
            }
            System.out.println(work?"YES":"NO");
        }
    }
}
