import java.util.*;
public class Main{
	public static void main(String[]args){
		Scanner scan=new Scanner(System.in);
		int n=scan.nextInt();
		int t=scan.nextInt();
		ArrayList<Integer>array=new ArrayList<>();
		for(int i=0;i<n;i++){
		    array.add(scan.nextInt());
		}
		ArrayList<Integer>temp=new ArrayList<>();
		for(int i=0;i<t;i++){
		    temp.add(array.get(i));
		}
		Collections.sort(temp);
		array.remove((Integer)temp.get(0));
		array.remove((Integer)temp.get(1));
		array.add(0);
		array.add((Integer)(temp.get(0)+temp.get(1)));
		Collections.sort(array);
		long sum=0;
		for(int i=0;i<n/2;i++){
		    sum+=array.get(i);
		}
		System.out.println(sum);
	}
}
