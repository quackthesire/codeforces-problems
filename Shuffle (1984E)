#include <bits/stdc++.h>
using namespace std;
using ll=long long;
const ll big=-1000000000000;
struct Node{
    ll ry=0;
    ll rn=0;
    ll by=0;
    ll bn=0;
};
Node solve(int u,int p,vector<vector<int>>&adj){
    Node res;
    if(p!=-1&&adj[u].size()==1){
        res.ry=big;
        res.rn=1;
        res.by=0;
        res.bn=big;
        //cout<<u<<" "<<res.ry<<" "<<res.rn<<" "<<res.by<<" "<<res.bn<<"\n";
        return res;
    }
    vector<Node>child;
    for(int v:adj[u]){
        if(v==p)
            continue;
        child.push_back(solve(v,u,adj));
    }
    ll minus=big;
    for(Node node:child){
        ll cur=max(node.by,node.bn);
        res.ry+=cur;
        minus=max(minus,node.by-cur);
    }
    res.ry++;
    if(minus<0)
        res.ry+=minus;
    for(Node node:child){
        res.rn+=node.bn;
    }
    res.rn++;
    minus=big;
    for(Node node:child){
        ll cur=max({node.ry,node.rn,node.by,node.bn});
        res.by+=cur;
        minus=max(minus,max(node.ry,node.by)-cur);
    }
    if(minus<0)
        res.by+=minus;
    for(Node node:child){
        res.bn+=max(node.rn,node.bn);
    }
    //cout<<u<<" "<<res.ry<<" "<<res.rn<<" "<<res.by<<" "<<res.bn<<"\n";
    return res;
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<vector<int>>adj(n);
        for(int i=0;i<n-1;i++){
            int u;
            int v;
            cin>>u>>v;
            adj[u-1].push_back(v-1);
            adj[v-1].push_back(u-1);
        }
        Node ans=solve(0,-1,adj);
        Node root=solve(1,-1,adj);
        cout<<max({ans.ry+1,ans.rn,ans.by+1,ans.bn,root.ry+1,root.rn,root.by+1,root.bn})<<"\n";
    }
}
