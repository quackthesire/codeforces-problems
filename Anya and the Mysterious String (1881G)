import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    static void update(Segtree segtree,int[]one,int[]two,int i){
        if(one[i]==0||(i<two.length&&two[i]==0))
            segtree.update(i,1);
        else
            segtree.update(i,0);
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int q=scan.nextInt();
            String s=scan.next();
            Segtree segtree=new Segtree(n);
            int[]one=new int[Math.max(0,n-1)];//s[i+1]-s[i]
            int[]two=new int[Math.max(0,n-2)];//s[i+2]-s[i]
            for(int i=0;i<n-1;i++){
                one[i]=(s.charAt(i+1)-s.charAt(i)+26)%26;
                update(segtree,one,two,i);
            }
            for(int i=0;i<n-2;i++){
                two[i]=(s.charAt(i+2)-s.charAt(i)+26)%26;
                update(segtree,one,two,i);
            }
            for(int i=0;i<q;i++){
                if(scan.nextInt()==1){
                    int l=scan.nextInt()-1;
                    int r=scan.nextInt()-1;
                    int val=scan.nextInt()%26;
                    if(l>0){
                        one[l-1]=(one[l-1]+val)%26;
                        update(segtree,one,two,l-1);
                    }
                    if(r<n-1){
                        one[r]=(one[r]-val+26)%26;
                        update(segtree,one,two,r);
                    }
                    if(l>1){
                        two[l-2]=(two[l-2]+val)%26;
                        update(segtree,one,two,l-2);
                    }
                    if(l>0&&l<n-1){
                        two[l-1]=(two[l-1]+val)%26;
                        update(segtree,one,two,l-1);
                    }
                    if(r>0&&r<n-1){
                        two[r-1]=(two[r-1]-val+26)%26;
                        update(segtree,one,two,r-1);
                    }
                    if(r<n-2){
                        two[r]=(two[r]-val+26)%26;
                        update(segtree,one,two,r);
                    }
                }
                else{
                    int l=scan.nextInt()-1;
                    int r=scan.nextInt()-1;
                    if(segtree.query(l,r-2)>0||(r>l&&one[r-1]==0))
                        System.out.println("NO");
                    else
                        System.out.println("YES");
                }
            }
        }
    }
}
