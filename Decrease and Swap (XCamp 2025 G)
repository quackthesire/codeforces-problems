import java.util.*;
public class Main{
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int t=scan.nextInt();
	    for(int temp=0;temp<t;temp++){
    	    int n=scan.nextInt();
    	    String s=scan.next();
    	    int[] array=new int[n];
    	    ArrayList<Integer>ones=new ArrayList<Integer>();
    	    for(int i=0;i<n;i++){
    	        array[i]=s.charAt(i)=='0'?0:1;
    	    }
    	    for(int i=n-4;i>=0;i--){
    	        if(array[i]==1)
    	            ones.add(i);
    	    }
    	    int lastone=-1;
    	    if(array[n-3]==1)
    	        lastone=n-3;
    	    else if(array[n-2]==1)
    	        lastone=n-2;
    	    else if(array[n-1]==1)
    	        lastone=n-1;
    	    boolean work=(array[n-2]==0&&array[n-1]==0)?true:false;
    	    int index=1;
    	    for(int one:ones){
    	        if(lastone-one<=2*index){
    	            work=true;
    	            break;
    	        }
    	        index++;
    	    }
    	    System.out.println(work?"Yes":"No");
	    }
	}
}
