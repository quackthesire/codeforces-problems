import java.util.*;
public class Main{
    static class Node implements Comparable<Node>{
        int pos;
        int index;
        public Node(int pos,int index){
            this.pos=pos;
            this.index=index;
        }
        public int compareTo(Node other){
            return this.pos-other.pos;
        }
    }
    static class Segtree{
        int n;
        int[]tree;
        public Segtree(int[]array){
            n=array.length;
            tree=new int[4*n];
            build(1,0,n-1,array);
        }
        public void build(int node,int l,int r,int[]array){
            if(l==r)
                tree[node]=array[l];
            else{
                int m=(l+r)/2;
                build(node*2,l,m,array);
                build(node*2+1,m+1,r,array);
                tree[node]=Math.min(tree[node*2],tree[node*2+1]);
            }
        }
        public int min(int node,int l,int r,int ll,int rr){
            if(rr<l||r<ll)
                return Integer.MAX_VALUE;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            return Math.min(min(node*2,l,m,ll,rr),min(node*2+1,m+1,r,ll,rr));
        }
        public void update(int i,int val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,int val){
            if(l==r)
                tree[node]=val;
            else{
                int m=(l+r)/2;
                if(i<=m)
                    update(node*2,l,m,i,val);
                else
                    update(node*2+1,m+1,r,i,val);
                tree[node]=Math.min(tree[node*2],tree[node*2+1]);
            }
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int max=0;
        int[]len=new int[n];
        ArrayList<Node>list=new ArrayList<>();
        for(int i=0;i<n;i++){
            int k=scan.nextInt();
            int l=scan.nextInt();
            int r=scan.nextInt();
            max=Math.max(max,l);
            int sum=l;
            len[i]=r-l;
            list.add(new Node(l,i));
            for(int j=0;j<k;j++){
                int d=scan.nextInt();
                len[i]-=d;
                sum+=d;
                list.add(new Node(sum,i));
            }
        }
        Collections.sort(list);
        int ans=0;
        Segtree segtree=new Segtree(new int[n]);
        for(int i=0;i<list.size();i++){
            Node node=list.get(i);
            segtree.update(node.index,node.pos+len[node.index]);
            if(node.pos>=max)
                ans=Math.max(ans,segtree.min(1,0,n-1,0,n-1)-node.pos);
        }
        System.out.println(ans);
    }
}
