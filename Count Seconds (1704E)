import java.util.*;
public class Main{
    static int zero=0;
    static int MOD=998244353;
    static long solve(long[]dp,int u,ArrayList<Integer>[]adj){
        if(adj[u].size()==0){
            dp[u]=1;
            return 1;
        }
        dp[u]=0;
        for(int v:adj[u]){
            if(dp[v]==-1)
                solve(dp,v,adj);
            dp[u]=(dp[u]+dp[v])%MOD;
        }
        return dp[u];
    }
    static void dfs(int u,long[]array,boolean[]visited,ArrayList<Integer>[]adj){
        visited[u]=true;
        if(array[u]==0)
            return;
        array[u]--;
        if(array[u]==0)
            zero++;
        for(int v:adj[u]){
            if(!visited[v])
                dfs(v,array,visited,adj);
        }
        for(int v:adj[u]){
            if(array[v]==0)
                zero--;
            array[v]++;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            zero=0;
            int n=scan.nextInt();
            int m=scan.nextInt();
            long[]array=new long[n];
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextLong();
                adj[i]=new ArrayList<>();
                if(array[i]==0)
                    zero++;
            }
            for(int i=0;i<m;i++){
                adj[scan.nextInt()-1].add(scan.nextInt()-1);
            }
            if(zero==n){
                System.out.println(0);
                continue;
            }
            long done=-1;
            for(int i=0;i<n;i++){
                boolean[]visited=new boolean[n];
                for(int j=0;j<n;j++){
                    if(!visited[j])
                        dfs(j,array,visited,adj);
                }
                if(zero==n){
                    done=i+1;
                    break;
                }
            }
            if(done!=-1){
                System.out.println(done);
                continue;
            }
            long ans=n;
            long[]dp=new long[n];
            Arrays.fill(dp,-1);
            for(int i=0;i<n;i++){
                if(dp[i]==-1)
                    solve(dp,i,adj);
            }
            for(int i=0;i<n;i++){
                ans=(ans+(array[i]*dp[i])%MOD)%MOD;
            }
            System.out.println(ans);
        }
    }
}
