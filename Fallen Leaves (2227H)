import java.util.*;
public class Main{
    static void dfs(int u,int p,ArrayList<Integer>[]adj,int[]count){
        if(adj[u].size()==1)
            count[u]=1;
        for(int v:adj[u]){
            if(v==p)
                continue;
            dfs(v,u,adj,count);
            count[u]+=count[v];
        }
    }
    static void dfs2(int u,int p,ArrayList<Integer>[]adj,int[]count,int[]val){
        if(p!=-1)
            val[u]=val[p]+(count[u]%2==0?-1:1);
        for(int v:adj[u]){
            if(v==p)
                continue;
            dfs2(v,u,adj,count,val);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<n-1;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(v);
                adj[v].add(u);
            }
            int root=-1;
            for(int i=0;i<n;i++){
                if(adj[i].size()!=1){
                    root=i;
                    break;
                }
            }
            int[]count=new int[n];
            int[]val=new int[n];
            dfs(root,-1,adj,count);
            dfs2(root,-1,adj,count,val);
            int ans=0;
            int max=0;
            int leaves=0;
            for(int i=0;i<n;i++){
                //System.out.println(count[i]+" "+val[i]);
                if(i==root)
                    continue;
                ans+=count[i]%2;
                if(adj[i].size()==1){
                    leaves++;
                    max=Math.max(max,val[i]);
                }
            }
            System.out.println(ans-(leaves%2==0?0:max));
        }
    }
}
