import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int[]array=new int[n];
        int[]first=new int[1<<21];
        int[]second=new int[1<<21];
        Arrays.fill(first,-1);
        Arrays.fill(second,-1);
        for(int i=0;i<n;i++){
            array[i]=scan.nextInt();
            second[array[i]]=first[array[i]];
            first[array[i]]=i;
        }
        for(int i=0;i<21;i++){
            for(int j=0;j<(1<<21);j++){
                if((j&(1<<i))!=0)
                    continue;
                int temp=Math.max(Math.min(first[j],first[j|(1<<i)]),Math.max(second[j],second[j|(1<<i)]));
                first[j]=Math.max(first[j],first[j|(1<<i)]);
                second[j]=temp;
            }
        }
        int best=0;
        for(int i=n-3;i>=0;i--){
            int cur=0;
            for(int j=20;j>=0;j--){
                if((array[i]&(1<<j))!=0)
                    continue;
                if(second[cur|(1<<j)]>i)
                    cur|=(1<<j);
            }
            best=Math.max(best,array[i]|cur);
        }
        System.out.print(best);
    }
}
