import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            int max=0;
            int[]ans=new int[n-1];
            int[]best=new int[n];
            int[]count=new int[n];
            best[n-1]=1;
            Arrays.fill(count,-1);
            for(int i=n-2;i>=0;i--){
                if(array[i]+i+1==n)
                    count[i]=1;
                else if(array[i]+i+1<n&&count[array[i]+i+1]!=-1)
                    count[i]=count[array[i]+i+1]+1;
                best[i]=max+1;
                if(array[i]+i+1<n)
                    best[i]=Math.max(best[i],best[array[i]+i+1]+1);
                if(array[i]==count[i+1])
                    ans[i]=0;
                else if(count[i+1]!=-1)
                    ans[i]=1;
                else if(best[i+1]>=array[i])
                    ans[i]=1;
                else
                    ans[i]=2;
                max=Math.max(max,count[i]);
                //System.out.println(i+" "+count[i]);
            }
            for(int i=0;i<n-1;i++){
                System.out.print(ans[i]+" ");
            }
            System.out.println();
        }
    }
}
