#include <bits/stdc++.h>
using namespace std;
using ll=long long;
void add(ll&res,ll&curi,ll&curj,ll mult,ll n){
    ll len=(n-curi)/mult+1;
    res+=len*(2*curi+(len-1)*mult)/2;
    curi+=(len-1)*mult;
    curj+=len-1;
}
void update(ll&curi,ll&curj,ll mult,ll n){
    ll t=(curj-curi)/(mult-1)+1;
    curi+=t*mult;
    curj+=t;
}
ll solve(ll mult,ll n){
    ll res=0;
    ll curi=mult;
    ll curj=1;
    while(curj<=n){
        add(res,curi,curj,mult,n);
        curi+=mult-n;
        if(curi==mult)
            break;
        curj++;
        while(curi<=curj&&curj<=n){
            update(curi,curj,mult,n);
            if(curi>n)
                curi-=n;
        }
    }
    return res;
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    ll n;
    ll m;
    cin>>n>>m;
    ll bestk=1;
    ll bestval=0;
    for(ll i=2;i<=min(m,n);i++){
        ll val=solve(i,n);
        if(val>bestval){
            bestk=i;
            bestval=val;
        }
    }
    cout<<bestk;
}
