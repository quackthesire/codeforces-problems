import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int add=0;
        int count=0;
        int count2=0;
        int count3=0;
        int count4=0;
        boolean[]array=new boolean[n];
        String scann=scan.next();
        boolean did=false;
        for(int i=0;i<n;i++){
            if(scann.substring(i,i+1).equals("G")){
                array[i]=true;
            }
            else{
                array[i]=false;
            }
        }
        for(int j=0;j<n;j++){
            if(array[j]==true){
                if(j==0){
                    while(j+add<n){
                        add++;
                        if(j+add<n){
                            if(array[j+add]==false){
                                count++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    if(did==false){
                        count++;
                    }
                    did=false;
                    add=0;
                    count--;
                }
                else if(j==n-1){
                    while(j-add>=0){
                        add++;
                        if(j-add>=0){
                            if(array[j-add]==false){
                                count++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    if(did==false){
                        count++;
                    }
                    did=false;
                    add=0;
                    count--;
                }
                else{
                    while(j+add<n){
                        add++;
                        if(j+add<n){
                            if(array[j+add]==false){
                                count2++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    add=0;
                    while(j-add>=0){
                        add++;
                        if(j-add>=0){
                            if(array[j-add]==false){
                                count3++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    if(did==false){
                        count++;
                    }
                    if(count2>0&&count3>0){
                        count4=Math.min(count2,count3);
                        count4++;
                        count+=(Math.max(count2,count3)*count4);
                        count+=(count4-3);
                    }
                    else{
                        count+=(count2+count3)-1;
                    }
                    did=false;
                    add=0;
                    count2=0;
                    count3=0;
                }
            }
            if(array[j]==false){
                if(j==0){
                    while(j+add<n){
                        add++;
                        if(j+add<n){
                            if(array[j+add]==true){
                                count++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    if(did==false){
                        count++;
                    }
                    did=false;
                    add=0;
                    count--;
                }
                else if(j==n-1){
                    while(j-add>=0){
                        add++;
                        if(j-add>=0){
                            if(array[j-add]==true){
                                count++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    if(did==false){
                        count++;
                    }
                    did=false;
                    add=0;
                    count--;
                }
                else{
                    while(j+add<n){
                        add++;
                        if(j+add<n){
                            if(array[j+add]==true){
                                count2++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    add=0;
                    while(j-add>=0){
                        add++;
                        if(j-add>=0){
                            if(array[j-add]==true){
                                count3++;
                                did=true;
                            }
                            else{
                                break;
                            }
                        }
                    }
                    if(did==false){
                        count++;
                    }
                    did=false;
                    add=0;
                    if(count2>0&&count3>0){
                        count4=Math.min(count2,count3);
                        count4++;
                        count+=(Math.max(count2,count3)*count4);
                        count+=(count4-3);
                    }
                    else{
                        count+=count2+count3-1;
                    }
                    count2=0;
                    count3=0;
                }
            }
        }
        System.out.println(count);
    }
}
