import java.util.*;
public class Main{
    static PriorityQueue<Integer> dfs(int u,Long[]array,ArrayList<Integer>[]adj){
        PriorityQueue<Integer>pq=new PriorityQueue<>((a,b)->Long.compare(array[a],array[b]));
        if(adj[u].isEmpty()){
            pq.add(u);
            return pq;
        }
        for(int v:adj[u]){
            PriorityQueue<Integer>pqv=dfs(v,array,adj);
            if(pqv.size()<pq.size()){
                pq.addAll(pqv);
            }
            else{
                pqv.addAll(pq);
                pq=pqv;
            }
        }
        int index=pq.poll();
        if(array[u]>array[index])
            pq.add(u);
        else
            pq.add(index);
        return pq;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            Long[]array=new Long[n];
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextLong();
                adj[i]=new ArrayList<>();
            }
            for(int i=1;i<n;i++){
                adj[scan.nextInt()-1].add(i);
            }
            long sum=0;
            PriorityQueue<Integer>pq=dfs(0,array,adj);
            for(int i=1;i<pq.size();i++){
                System.out.print(-1+" ");
            }
            for(int index:pq){
                sum+=array[index];
                array[index]=0L;
            }
            System.out.print(sum+" ");
            Arrays.sort(array,(a,b)->Long.compare(b,a));
            for(int i=0;i<n-pq.size();i++){
                sum+=array[i];
                System.out.print(sum+" ");
            }
            System.out.println();
        }
    }
}
