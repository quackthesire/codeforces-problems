import java.util.*;
public class solution{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int max=0;
        int[]array=new int[n];
        for(int i=0;i<n;i++){
            array[i]=scan.nextInt();
            max=Math.max(max,array[i]);
        }
        int[]freq=new int[max+1];
        for(int i=0;i<n;i++){
            freq[array[i]]++;
        }
        long[]pre=new long[max+1];
        long[]suff=new long[max+1];
        pre[0]=freq[0];
        suff[max]=freq[max];
        for(int i=1;i<max+1;i++){
            pre[i]=pre[i-1]+freq[i];
        }
        for(int i=max-1;i>=0;i--){
            suff[i]=suff[i+1]+freq[i];
        }
        long ans=0;
        for(int i=1;i<=max;i++){
            int count=0;
            int cur=-1;
            int prev=-1;
            long best=0;
            for(int j=1;j<=max/i;j++){
                long temp=pre[Math.min(max,i*(j+1)-1)]-(i*j>0?pre[i*j-1]:0);
                if(temp%2==1){
                    count++;
                    prev=cur;
                    cur=j;
                    best=temp;
                    if(count>2)
                        break;
                }
            }
            if((count==1&&cur==1)||(count==2&&cur>1&&prev==cur-1))
                ans+=best;
        }
        System.out.println(ans);
    }
}
