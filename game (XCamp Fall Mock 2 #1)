import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]tree;
        boolean max;
        public Segtree(int[]array,boolean max){
            this.n=array.length;
            this.tree=new int[4*n];
            this.max=max;
            build(array,1,0,n-1);
        }
        public void build(int[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            if(max)
	            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
           	else
                tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
        public int query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l){
                if(max)
	                return Integer.MIN_VALUE;
                return Integer.MAX_VALUE;
            }
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            int left=query(node*2,l,m,ll,rr);
            int right=query(node*2+1,m+1,r,ll,rr);
            if(max)
	            return Math.max(left,right);
            return Math.min(left,right);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt()-1;
        int q=scan.nextInt();
        int[]array=new int[n];
        for(int i=0;i<n;i++){
            array[i]=scan.nextInt()-1;
        }
		int[]pre=new int[n];
        for(int i=1;i<n;i++){
            if(array[i]<array[i-1])
                pre[i]++;
           	pre[i]+=pre[i-1];
        }
        Segtree min=new Segtree(array,false);
        Segtree max=new Segtree(array,true);
        for(int i=0;i<q;i++){
            int l=scan.nextInt()-1;
            int r=scan.nextInt()-1;
            if(min.query(l,r)!=l||max.query(l,r)!=r)
                System.out.println(-1);
            else
                System.out.println(Math.min(pre[r]-pre[l],2));
        }
    }
}
