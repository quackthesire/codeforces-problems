import java.util.*;
public class Main{
    static Scanner scan=new Scanner(System.in);
    static int n=scan.nextInt();
    static int m=scan.nextInt();
    static LinkedList<Integer>[]adj=new LinkedList[n];
    static long[]dp=new long[n];
    static long[]ans=new long[n];
    static void dfs(int u,int parent){
        dp[u]=1;
        for(int v:adj[u]){
            if(v!=parent){
                dfs(v,u);
                dp[u]=dp[u]*(dp[v]+1)%m;
            }
        }
    }
    static void solve(int u,int parent,long count){
        ans[u]=dp[u]*count%m;
        long[]pre=new long[adj[u].size()+1];
        long[]suff=new long[adj[u].size()+1];
        Arrays.fill(pre,1);
        Arrays.fill(suff,1);
        for(int i=0;i<adj[u].size();i++){
            if(adj[u].get(i)==parent)
                pre[i+1]=pre[i];
            else
                pre[i+1]=pre[i]*(dp[adj[u].get(i)]+1)%m;
        }
        for(int i=adj[u].size()-1;i>=0;i--){
            if(adj[u].get(i)==parent)
                suff[i]=suff[i+1];
            else
                suff[i]=suff[i+1]*(dp[adj[u].get(i)]+1)%m;
        }
        for(int i=0;i<adj[u].size();i++){
            if(adj[u].get(i)!=parent)
                solve(adj[u].get(i),u,(count*(pre[i]*suff[i+1]%m)+1)%m);
        }
    }
    public static void main(String[]args){
        for(int i=0;i<n;i++){
            adj[i]=new LinkedList<Integer>();
        }
        for(int i=0;i<n-1;i++){
            int a=scan.nextInt()-1;
            int b=scan.nextInt()-1;
            adj[a].add(b);
            adj[b].add(a);
        }
        dfs(0,-1);
        solve(0,-1,1);
        for(int i=0;i<n;i++){
            System.out.println(ans[i]%m);
        }
    }
}
