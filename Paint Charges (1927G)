import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            int[][][]dp=new int[n+1][n+1][n+1];
            for(int i=0;i<=n;i++){
                for(int j=0;j<=n;j++){
                    Arrays.fill(dp[i][j],Integer.MAX_VALUE/2);
                }
            }
            dp[0][0][0]=0;
            for(int i=1;i<=n;i++){
                for(int j=0;j<n;j++){
                    for(int k=0;k<n;k++){
                        int val=(j==0&&k!=0)?0:j+1;
                        dp[i][val][Math.max(0,k-1)]=Math.min(dp[i][val][Math.max(0,k-1)],dp[i-1][j][k]);
                        val=(j+1<=array[i-1])?0:j+1;
                        dp[i][val][Math.max(0,k-1)]=Math.min(dp[i][val][Math.max(0,k-1)],dp[i-1][j][k]+1);
                        val=(j==0)?0:j+1;
                        dp[i][val][Math.max(k-1,array[i-1]-1)]=Math.min(dp[i][val][Math.max(k-1,array[i-1]-1)],dp[i-1][j][k]+1);
                    }
                }
            }
            int min=Integer.MAX_VALUE/2;
            for(int i=0;i<=n;i++){
                min=Math.min(min,dp[n][0][i]);
            }
            System.out.println(min);
        }
    }
}
