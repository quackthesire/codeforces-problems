import java.util.*;
public class Main{
    static class BIT{
        int n;
        int[]tree;
        public BIT(int n){
            this.n=n;
            this.tree=new int[n+1];
        }
        public void add(int i,int x){
            for(i=i+1;i<=n;i+=i&-i){
                tree[i]+=x;
            }
        }
        public int sum(int i){
            if(i<0)
                return 0;
            int sum=0;
            for(i=i+1;i>0;i-=i&-i){
                sum+=tree[i];
            }
            return sum;
        }
        public int k(int k){
            int prev=0;
            int add=1<<(31-Integer.numberOfLeadingZeros(n));
            while(add>0){
                int cur=prev+add;
                if(cur<=n&&tree[cur]<k){
                    prev=cur;
                    k-=tree[cur];
                }
                add>>=1;
            }
            return prev;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int q=scan.nextInt();
        char[]array=new char[q];
        long[]nums=new long[q];
        ArrayList<Long>vals=new ArrayList<>();
        for(int i=0;i<q;i++){
            array[i]=scan.next().charAt(0);
            nums[i]=scan.nextLong();
            if(array[i]!='K')
                vals.add(nums[i]);
        }
        Collections.sort(vals);
        ArrayList<Long>temp=new ArrayList<>();
        for(long l:vals){
            if(temp.isEmpty()||!temp.get(temp.size()-1).equals(l))
                temp.add(l);
        }
        long[]diff=new long[temp.size()];
        for(int i=0;i<temp.size();i++){
            diff[i]=temp.get(i);
        }
        BIT tree=new BIT(temp.size());
        boolean[]visited=new boolean[temp.size()];
        for(int i=0;i<q;i++){
            char c=array[i];
            long x=nums[i];
            int index=Arrays.binarySearch(diff,x);
            if(c=='I'){
                if(index>=0&&!visited[index]){
                    visited[index]=true;
                    tree.add(index,1);
                }
            }
            else if(c=='D'){
                if(index>=0&&visited[index]){
                    visited[index]=false;
                    tree.add(index,-1);
                }
            }
            else if(c=='C'){
                if(index<0)
                    index=Math.abs(index)-1;
                System.out.println(tree.sum(index-1));
            }
            else{
                int tot=tree.sum(temp.size()-1);
                if(x>tot)
                    System.out.println("invalid");
                else
                    System.out.println(diff[tree.k((int)x)]);
            }
        }
    }
}
