import java.util.*;
import java.io.*;
public class solution{
    public static void main(String[]args) throws IOException{
        BufferedReader br=new BufferedReader(new FileReader("help.in"));
        PrintWriter pw=new PrintWriter(new FileWriter("help.out"));
        StringTokenizer st=new StringTokenizer(br.readLine());
        int n=Integer.parseInt(st.nextToken());
        int[][]array=new int[n][2];
        for(int i=0;i<n;i++){
            st=new StringTokenizer(br.readLine());
            array[i][0]=Integer.parseInt(st.nextToken())-1;
            array[i][1]=Integer.parseInt(st.nextToken())-1;
        }
        int[]pre=new int[2*n];
        for(int i=0;i<n;i++){
            pre[array[i][0]]++;
            pre[array[i][1]]--;
        }
        for(int i=0;i<2*n;i++){
            if(i>0)
                pre[i]+=pre[i-1];
        }
        int[]pow=new int[n];
        pow[0]=1;
        for(int i=1;i<n;i++){
            pow[i]=(pow[i-1]*2)%1000000007;
        }
        long ans=0;
        for(int i=0;i<n;i++){
            ans+=pow[(n-1)-(array[i][0]==0?0:pre[array[i][0]-1])];
            ans%=1000000007;
        }
        pw.println(ans);
        pw.close();
    }
}
