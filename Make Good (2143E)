import java.util.*;
public class Main{
	public static void main(String[]args){
  	    Scanner scan=new Scanner(System.in);
  	    int t=scan.nextInt();
  	    for(int temp=0;temp<t;temp++){
  	        int n=scan.nextInt();
  	        String s=scan.next();
  	        boolean[]array=new boolean[n];
  	        for(int i=0;i<n;i++){
  	            array[i]=s.charAt(i)=='(';
  	        }
  	        int val=0;
  	        for(int i=0;i<n;i++){
  	            val+=(array[i]^(i%2==1))?1:-1;
  	        }
  	        if(n%2==1||val==-n||Math.abs(val)%4!=n%4){
  	            System.out.println(-1);
  	            continue;
  	        }
  	        System.out.print("(");
            for(int i=0;i<(n-val)/4;i++){
                System.out.print("()");
            }
  	        System.out.print(")");
            for(int i=0;i<(n+val-4)/4;i++){
                System.out.print("()");
            }
            System.out.println();
	      }
	  }
}
