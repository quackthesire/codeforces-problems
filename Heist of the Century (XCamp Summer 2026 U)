import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int[]ans=new int[n];
        Arrays.fill(ans,-1);
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                if(i==j)
                    System.out.print(1+" ");
                else
                    System.out.print(n+" ");
            }
            System.out.println();
            System.out.flush();
            int val=scan.nextInt();
            if(val>n)
                ans[i]=val+1;
            if(val==0)
                System.exit(0);
            for(int j=0;j<n;j++){
                if(i==j)
                    System.out.print(2*n+" ");
                else
                    System.out.print(n+" ");
            }
            System.out.println();
            System.out.flush();
            val=scan.nextInt();
            if(val>n)
                ans[i]=2*n-val;
            if(val==0)
                System.exit(0);
        }
        for(int i=0;i<n;i++){
            if(ans[i]!=-1)
                continue;
            for(int j=0;j<n;j++){
                if(i==j)
                    System.out.print(1+" ");
                else if(ans[j]==-1)
                    System.out.print(n+" ");
                else
                    System.out.print(ans[j]+" ");
            }
            System.out.println();
            System.out.flush();
            int val=scan.nextInt();
            if(val==n)
                ans[i]=n+1;
            else
                ans[i]=n;
            if(val==0)
                break;
        }
        for(int i=0;i<n;i++){
            System.out.print(ans[i]+" ");
        }
        System.out.println();
        System.out.flush();
    }
}
