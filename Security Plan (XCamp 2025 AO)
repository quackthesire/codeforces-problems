import java.util.*;
import java.math.BigInteger;
public class Main{
    static int MOD=998244353;
    static BigInteger calc(long m,long n){
        if(n<4)
            return BigInteger.valueOf(0);
        BigInteger temp=BigInteger.valueOf(m-2);
        temp=temp.multiply(BigInteger.valueOf(n-4));
        BigInteger temp2=BigInteger.valueOf(2*m*n);
        temp2=temp2.multiply(BigInteger.valueOf(n));
        temp2=temp2.subtract(BigInteger.valueOf(m*n));
        temp2=temp2.add(BigInteger.valueOf(9*m));
        temp2=temp2.subtract(BigInteger.valueOf(4*n*n));
        temp2=temp2.subtract(BigInteger.valueOf(n));
        temp2=temp2.subtract(BigInteger.valueOf(21));
        temp=temp.multiply(temp2);
        temp=temp.divide(BigInteger.valueOf(3));
        return temp;
    }
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int t=scan.nextInt();
	    for(int tempvar=0;tempvar<t;tempvar++){
	        long n=scan.nextLong();
	        long m=scan.nextLong();
	        if(n==1&&m==1){
	            System.out.println(1);
	            continue;
	        }
	        else if(n==1){
	            System.out.println((2+(m-2)*(m-3)/2)%MOD);
	            continue;
	        }
	        else if(m==1){
	            System.out.println((2+(n-2)*(n-3)/2)%MOD);
	            continue;
	        }
	        long size=((n-2)*(m-2))%MOD;
	        BigInteger ans=BigInteger.valueOf(4+((2*n-4)*(2*n-5)/2+(2*m-4)*(2*m-5)/2)%MOD);
	        ans=ans.add(BigInteger.valueOf((((4*(n-2)*(m-2))%MOD*(n-2))%MOD*(m-2))%MOD));
	        BigInteger temp=BigInteger.valueOf(size);
	        temp=temp.multiply(BigInteger.valueOf(size-1));
	        temp=temp.multiply(BigInteger.valueOf(size-2));
	        temp=temp.multiply(BigInteger.valueOf(size-3));
	        temp=temp.divide(BigInteger.valueOf(24));
	        ans=ans.add(temp);
	        ans=ans.add(calc(m,n));
	        if(n==3)
	            ans=ans.add(BigInteger.valueOf((m-2)*(m-3)));
	        else if(n>3){
	            ans=ans.subtract(BigInteger.valueOf((3*(m-2))*(3*(m-2)-1)).multiply(BigInteger.valueOf(n-4)));
	            long left=(2*(m-2))%MOD;
	            long right=((n-2)*(m-2))%MOD;
	            ans=ans.add(BigInteger.valueOf(2*(left*(left-1)+right*(right-1))));
	            ans=ans.subtract(BigInteger.valueOf((4*(m-2))*(2*(m-2)-1)));
	        }
	        ans=ans.add(calc(n,m));
	        if(m==3)
	            ans=ans.add(BigInteger.valueOf((n-2)*(n-3)));
	        else if(m>3){
	            ans=ans.subtract(BigInteger.valueOf((3*(n-2))*(3*(n-2)-1)).multiply(BigInteger.valueOf(m-4)));
	            long left=(2*(n-2))%MOD;
	            long right=((m-2)*(n-2))%MOD;
	            ans=ans.add(BigInteger.valueOf(2*(left*(left-1)+right*(right-1))));
	            ans=ans.subtract(BigInteger.valueOf((4*(n-2))*(2*(n-2)-1)));
	        }
	        ans=ans.mod(BigInteger.valueOf(MOD));
	        System.out.println(ans.longValue());
	    }
	}
}
