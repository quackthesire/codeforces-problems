import java.util.*;
public class Main{
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    long x=scan.nextLong();
	    long y=scan.nextLong();
	    long max=Long.highestOneBit(x);
	    if(y>max-1){
	        System.out.println(2);
	        System.out.println((x^(max*2-1))+" "+(y^(max*2-1)));
	    }
	    else{
	        System.out.println(3);
	        System.out.println((x^(max*2-1))+" "+max+" "+(y^(max-1)));
	    }
	}
}
