import java.util.*;
public class Main{
    static boolean solve(long[]array,long val,long sum){
        while(sum>val*array.length){
            for(int i=0;i<array.length;i++){
                long count=(array[i]-val+1)/2;
                if(count<=0)
                    continue;
                array[i]-=2*count;
                array[(i+1)%array.length]+=count;
                sum-=count;
                if(sum<=val*array.length)
                    break;
            }
        }
        boolean work=true;
        for(int i=0;i<array.length;i++){
            if(array[i]!=val)
                work=false;
        }
        return work;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int tempvar=0;tempvar<t;tempvar++){
            int n=scan.nextInt();
            long max=0;
            long sum=0;
            long[]array=new long[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextLong();
                max=Math.max(max,array[i]);
                sum+=array[i];
            }
            long l=0;
            long r=max;
            long ans=-1;
            while(l<=r){
                long m=(l+r)/2;
                long[]temp=new long[n];
                for(int i=0;i<n;i++){
                    temp[i]=array[i];
                }
                if(solve(temp,m,sum)){
                    ans=sum-m*n;
                    l=m+1;
                }
                else
                    r=m-1;
            }
            System.out.println(ans);
        }
    }
}
