import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int k=scan.nextInt();
            long ans=0;
            PriorityQueue<Integer>pq=new PriorityQueue<>((a,b)->b-a);
            for(int i=0;i<n;i++){
                pq.add(scan.nextInt());
                if(i%(k+1)==n%(k+1))
                    ans+=pq.poll();
            }
            System.out.println(ans);
        }
    }
}
