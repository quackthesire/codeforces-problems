import java.util.*;
public class Main{
    static class Node implements Comparable<Node>{
        long x;
        long y;
        int len;
        public Node(long x,long y,int len){
            this.x=x;
            this.y=y;
            this.len=len;
        }
        @Override
        public int compareTo(Node other){
            if(y!=other.y)
                return Long.compare(y,other.y);
            return Long.compare(x,other.x);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        long x=scan.nextLong();
        long y=scan.nextLong();
        long[]xarray=new long[n];
        long[]yarray=new long[n];
        for(int i=0;i<n;i++){
            xarray[i]=scan.nextLong();
            yarray[i]=scan.nextLong();
        }
        Node[]array=new Node[(int)Math.pow(2,n/2)];
        for(int i=0;i<(int)Math.pow(2,n/2);i++){
            long a=0;
            long b=0;
            for(int j=0;j<n/2;j++){
                if((i&(int)Math.pow(2,j))!=0){
                    a+=xarray[j];
                    b+=yarray[j];
                }
            }
            array[i]=new Node(a,b,Integer.bitCount(i));
        }
        Arrays.sort(array);
        Node[]array2=new Node[(int)Math.pow(2,n-n/2)];
        for(int i=0;i<(int)Math.pow(2,n-n/2);i++){
            long a=0;
            long b=0;
            for(int j=n/2;j<n;j++){
                if((i&(int)Math.pow(2,j-n/2))!=0){
                    a+=xarray[j];
                    b+=yarray[j];
                }
            }
            array2[i]=new Node(x-a,y-b,Integer.bitCount(i));
        }
        Arrays.sort(array2);
        long[]ans=new long[n+1];
        long[]count=new long[(n/2)+1];
        int i=0;
        int j=0;
        for(int k=0;k<(int)Math.pow(2,n-n/2);k++){
            while(i<(int)Math.pow(2,n/2)&&array[i].compareTo(array2[k])<=0){
                count[array[i].len]++;
                i++;
            }
            while(j<(int)Math.pow(2,n/2)&&array[j].compareTo(array2[k])<0){
                count[array[j].len]--;
                j++;
            }
            for(int l=0;l<=n/2;l++){
                ans[l+array2[k].len]+=count[l];
            }
        }
        for(int k=1;k<=n;k++){
            System.out.println(ans[k]);
        }
    }
}
