#include <bits/stdc++.h>
using namespace std;
using ll=long long;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>array(n);
        vector<vector<int>>freq(n+1);
        for(int i=0;i<n;i++){
            cin>>array[i];
            freq[array[i]].push_back(i);
        }
        int left=INT_MAX/2;
        int right=INT_MIN/2;
        vector<int>start(n);
        vector<int>end(n);
        for(int i=1;i<=n;i++){
            if(!freq[i].empty()){
                left=min(left,freq[i][0]);
                right=max(right,freq[i][freq[i].size()-1]);
            }
            if(i<=right-left){
                start[left]++;
                end[right]++;
            }
            for(int j:freq[i]){
                if(j-i>=0){
                    start[0]++;
                    end[j-i]++;
                }
                if(j+i<=n-1){
                    start[j+i]++;
                    end[n-1]++;
                }
            }
        }
        int ans=0;
        int count=0;
        for(int i=0;i<n;i++){
            count+=start[i];
            if(count==0)
                ans++;
            count-=end[i];
        }
        cout<<ans<<"\n";
    }
}
