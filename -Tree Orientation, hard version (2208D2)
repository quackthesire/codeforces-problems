import java.util.*;
public class Main{
    static ArrayList<Integer>[]anslist;
    static boolean[]visited;
    static void dfs(int u){
        visited[u]=true;
        for(int v:anslist[u]){
            if(!visited[v])
                dfs(v);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int tempvar=0;tempvar<t;tempvar++){
            int n=scan.nextInt();
            int count=0;
            boolean work=true;
            int[]size=new int[n];
            boolean[][]adj=new boolean[n][n];
            boolean[][]ans=new boolean[n][n];
            anslist=new ArrayList[n];
            for(int i=0;i<n;i++){
                anslist[i]=new ArrayList<>();
            }
            for(int i=0;i<n;i++){
                String s=scan.next();
                for(int j=0;j<n;j++){
                    if(i!=j&&s.charAt(j)=='1'){
                        adj[i][j]=true;
                        size[i]++;
                    }
                    if(i==j&&s.charAt(j)=='0')
                        work=false;
                }
            }
            for(int i=0;i<n;i++){
                visited=new boolean[n];
                ArrayList<Integer>[]list=new ArrayList[n];
                for(int j=0;j<n;j++){
                    list[j]=new ArrayList<>();
                }
                for(int j=0;j<n;j++){
                    if(adj[i][j])
                        list[size[j]].add(j);
                }
                for(int j=n-1;j>=0;j--){
                    for(int k:list[j]){
                        if(visited[k])
                            continue;
                        ans[i][k]=true;
                        anslist[i].add(k);
                        count++;
                        if(count>n-1)
                            break;
                        for(int l=0;l<n;l++){
                            if(adj[k][l])
                                visited[l]=true;
                        }
                    }
                    if(count>n-1)
                        break;
                }
                if(count>n-1)
                    break;
            }
            for(int i=0;i<n;i++){
                for(int j=0;j<n;j++){
                    if(ans[i][j]&&ans[j][i]||adj[i][j]&&adj[j][i])
                        work=false;
                }
            }
            for(int i=0;i<n;i++){
                visited=new boolean[n];
                dfs(i);
                for(int j=0;j<n;j++){
                    if(i!=j&&visited[j]!=adj[i][j])
                        work=false;
                }
            }
            boolean[]seen=new boolean[n];
            Queue<Integer>q=new LinkedList<>();
            q.add(0);
            seen[0]=true;
            while(!q.isEmpty()){
                int i=q.poll();
                for(int j=0;j<n;j++){
                    if((ans[i][j]||ans[j][i])&&!seen[j]){
                        seen[j]=true;
                        q.add(j);
                    }
                }
            }
            for(int i=0;i<n;i++){
                if(!seen[i])
                    work=false;
            }
            if(count!=n-1||!work){
                System.out.println("NO");
                continue;
            }
            System.out.println("YES");
            for(int i=0;i<n;i++){
                for(int j=0;j<n;j++){
                    if(ans[i][j])
                        System.out.println((i+1)+" "+(j+1));
                }
            }
        }
    }
}
