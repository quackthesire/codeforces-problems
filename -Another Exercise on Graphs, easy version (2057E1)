import java.util.*;
public class Main{
    static class Edge{
        int v;
        long w;
        public Edge(int v,long w){
            this.v=v;
            this.w=w;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int q=scan.nextInt();
            ArrayList<Edge>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            TreeSet<Long>vals=new TreeSet<>();
            for(int i=0;i<m;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                long w=scan.nextLong();
                adj[u].add(new Edge(v,w));
                adj[v].add(new Edge(u,w));
                vals.add(w);
            }
            long[]list=new long[vals.size()];
            int index=0;
            for(long i:vals){
                list[index]=i;
                index++;
            }
            int[][][]dist=new int[list.length][n][n];
            for(int i=0;i<list.length;i++){
                long val=list[i];
                for(int j=0;j<n;j++){
                    int[]min=new int[n];
                    Arrays.fill(min,Integer.MAX_VALUE);
                    min[j]=0;
                    ArrayDeque<Integer>dq=new ArrayDeque<>();
                    dq.addFirst(j);
                    while(!dq.isEmpty()){
                        int u=dq.pollFirst();
                        for(Edge e:adj[u]){
                            if(min[u]+(e.w>val?1:0)<min[e.v]){
                                min[e.v]=min[u]+(e.w>val?1:0);
                                if(e.w<=val)
                                    dq.addFirst(e.v);
                                else
                                    dq.addLast(e.v);
                            }
                        }
                    }
                    dist[i][j]=min;
                }
            }
            for(int i=0;i<q;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                int k=scan.nextInt()-1;
                int l=0;
                int r=list.length-1;
                while(l<=r){
                    int mid=(l+r)/2;
                    if(dist[mid][u][v]<=k)
                        r=mid-1;
                    else
                        l=mid+1;
                }
                System.out.print(list[l]+" ");
            }
            System.out.println();
        }
    }
}
