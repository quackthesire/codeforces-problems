import java.util.*;
public class Main{
    static int[]dx={0,1,0,-1};
    static int[]dy={1,0,-1,0};
    static class Node{
        int x;
        int y;
        public Node(int x,int y){
            this.x=x;
            this.y=y;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int m=scan.nextInt();
        char[][]grid=new char[n][m];
        for(int i=0;i<n;i++){
            String s=scan.next();
            for(int j=0;j<m;j++){
                grid[i][j]=s.charAt(j);
            }
        }
        int[][]dist=new int[n][m];
        boolean[][]visited=new boolean[n][m];
        for(int i=0;i<n;i++){
            Arrays.fill(dist[i],Integer.MAX_VALUE/2);
        }
        ArrayDeque<Node>dq=new ArrayDeque<>();
        for(int i=0;i<m;i++){
            if(grid[n-1][i]=='.'){
                if(dist[n-1][i]<=1)
                    continue;
                dist[n-1][i]=1;
                dq.addLast(new Node(n-1,i));
            }
            else{
                if(dist[n-1][i]==0)
                    continue;
                dist[n-1][i]=0;
                dq.addFirst(new Node(n-1,i));
            }
        }
        while(!dq.isEmpty()){
            Node cur=dq.pollFirst();
            if(visited[cur.x][cur.y])
                continue;
            visited[cur.x][cur.y]=true;
            if(grid[cur.x][cur.y]=='#'){
                for(int i=0;i<4;i++){
                    int x=cur.x+dx[i];
                    int y=cur.y+dy[i];
                    if(x>=0&&x<n&&y>=0&&y<m&&grid[x][y]=='#'&&dist[x][y]>dist[cur.x][cur.y]){
                        dist[x][y]=dist[cur.x][cur.y];
                        dq.addFirst(new Node(x,y));
                    }
                }
            }
            if(cur.x>=1&&cur.x<n+1&&cur.y>=0&&cur.y<m){
                if(grid[cur.x-1][cur.y]=='.'){
                    if(dist[cur.x-1][cur.y]<=dist[cur.x][cur.y]+1)
                        continue;
                    dist[cur.x-1][cur.y]=dist[cur.x][cur.y]+1;
                    dq.addLast(new Node(cur.x-1,cur.y));
                }
                else{
                    if(dist[cur.x-1][cur.y]<=dist[cur.x][cur.y])
                        continue;
                    dist[cur.x-1][cur.y]=dist[cur.x][cur.y];
                    dq.addFirst(new Node(cur.x-1,cur.y));
                }
            }
        }
        char[][]ans=new char[n][m];
        for(int i=0;i<n;i++){
            Arrays.fill(ans[i],'.');
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j]=='#')
                    ans[i+dist[i][j]][j]='#';
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                System.out.print(ans[i][j]);
            }
            System.out.println();
        }
    }
}
