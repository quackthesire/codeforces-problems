import java.util.*;
import java.io.*;
public class Main{
    static class FastScanner{
        int len=0;
        int index=0;
        byte[]buffer=new byte[1<<16];
        public int read() throws IOException{
            if(index>=len){
                len=System.in.read(buffer);
                index=0;
                if(len<=0)
                    return -1;
            }
            return buffer[index++];
        }
        public long nextLong() throws IOException{
            int val;
            do{
                val=read();
            }
            while(val<=' '&&val!=-1);
            long mult=1;
            if(val=='-'){
                mult=-1;
                val=read();
            }
            long res=0;
            while(val>' '){
                res=res*10+val-'0';
                val=read();
            }
            return res*mult;
        }
        public int nextInt() throws IOException{
            return (int)nextLong();
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        long[]count;
        long[]lazy;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
            count=new long[4*n];
            lazy=new long[4*n];
            build(1,0,n-1);
        }
        public void build(int node,int l,int r){
            if(l==r){
                count[node]=1;
                return;
            }
            int m=(l+r)/2;
            build(node*2,l,m);
            build(node*2+1,m+1,r);
            pull(node);
        }
        public void pull(int node){
            tree[node]=Math.min(tree[node*2],tree[node*2+1]);
            count[node]=0;
            if(tree[node]==tree[node*2])
                count[node]+=count[node*2];
            if(tree[node]==tree[node*2+1])
                count[node]+=count[node*2+1];
        }
        public void push(int node){
            if(lazy[node]==0)
                return;
            tree[node*2]+=lazy[node];
            lazy[node*2]+=lazy[node];
            tree[node*2+1]+=lazy[node];
            lazy[node*2+1]+=lazy[node];
            lazy[node]=0;
        }
        public long[] query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long[] query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return new long[]{Long.MAX_VALUE,0};
            if(ll<=l&&r<=rr)
                return new long[]{tree[node],count[node]};
            push(node);
            int m=(l+r)/2;
            long[]left=query(node*2,l,m,ll,rr);
            long[]right=query(node*2+1,m+1,r,ll,rr);
            long count=0;
            long min=Math.min(left[0],right[0]);
            if(min==left[0])
                count+=left[1];
            if(min==right[0])
                count+=right[1];
            return new long[]{min,count};
        }
        public int first(int i){
            return first(1,0,n-1,i-1,query(i,i)[0]);
        }
        public int first(int node,int l,int r,int i,long val){
            if(l>i||tree[node]>=val)
                return -1;
            if(l==r)
                return l;
            push(node);
            int m=(l+r)/2;
            int res=first(node*2+1,m+1,r,i,val);
            if(res!=-1)
                return res;
            return first(node*2,l,m,i,val);
        }
        public void update(int l,int r,long val){
            update(1,0,n-1,l,r,val);
        }
        public void update(int node,int l,int r,int ll,int rr,long val){
            if(ll>r||rr<l)
                return;
            if(ll<=l&&r<=rr){
                tree[node]+=val;
                lazy[node]+=val;
                return;
            }
            push(node);
            int m=(l+r)/2;
            update(node*2,l,m,ll,rr,val);
            update(node*2+1,m+1,r,ll,rr,val);
            pull(node);
        }
    }
    static long[]fact=new long[1000000];
    static long[]inv=new long[1000000];
    static long MOD=998244353;
    static long modpow(long base,long exp){
        long res=1;
        base=base%MOD;
        while(exp>0){
            if(exp%2==1)
                res=(res*base)%MOD;
            exp/=2;
            base=(base*base)%MOD;
        }
        return res;
    }
    static long modinv(long val){
        return modpow(val,MOD-2);
    }
    static long cat(int len){
        return fact[len]*inv[len/2]%MOD*inv[len/2+1]%MOD;
    }
    public static void main(String[]args) throws IOException{
        FastScanner scan=new FastScanner();
        fact[0]=1;
        for(int i=1;i<1000000;i++){
            fact[i]=i*fact[i-1]%MOD;
        }
        inv[999999]=modinv(fact[999999]);
        for(int i=999998;i>=0;i--){
            inv[i]=(i+1)*inv[i+1]%MOD;
        }
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            long ans=1;
            int[]len=new int[n+1];
            int[]rev=new int[2*n+2];
            Segtree mintree=new Segtree(2*n+2);
            Segtree pref=new Segtree(2*n+2);
            len[0]=2*n;
            rev[0]=0;
            rev[2*n+1]=0;
            mintree.update(0,2*n+1,1);
            pref.update(0,2*n,1);
            ans=ans*cat(len[0])%MOD;
            System.out.print(ans+" ");
            for(int i=1;i<=n;i++){
                int l=scan.nextInt();
                int r=scan.nextInt();
                int index=rev[pref.first(l)+1];
                int loss=(int)mintree.query(l,r)[1];
                ans=ans*modinv(cat(len[index]))%MOD;
                len[index]-=loss;
                ans=ans*cat(len[index])%MOD;
                len[i]=loss-2;
                ans=ans*cat(len[i])%MOD;
                rev[l]=i;
                rev[r]=i;
                mintree.update(l,r,1);
                pref.update(l,r-1,1);
                System.out.print(ans+" ");
            }
            System.out.println();
        }
    }
}
