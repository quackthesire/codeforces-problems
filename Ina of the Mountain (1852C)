#include <bits/stdc++.h>
using namespace std;
using ll=long long;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n;
        int k;
        cin>>n>>k;
        ll ans=0;
        int prev=0;
        priority_queue<int,vector<int>,greater<int>>pq;
        for(int i=0;i<n;i++){
            int cur;
            cin>>cur;
            cur%=k;
            int diff=cur-prev;
            if(diff>=0){
                if(!pq.empty()&&pq.top()<diff){
                    ans+=pq.top();
                    pq.pop();
                    pq.push(diff);
                }
                else
                    ans+=diff;
            }
            else
                pq.push(diff+k);
            prev=cur;
        }
        cout<<ans<<"\n";
    }
}
