import java.util.*;
public class Main{
    static class Node implements Comparable<Node>{
        int x;
        int y;
        public Node(int x,int y){
            this.x=x;
            this.y=y;
        }
        public int compareTo(Node other){
            return this.x-other.x;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            Node[]a=new Node[n];
            for(int i=0;i<n;i++){
                a[i]=new Node(scan.nextInt(),0);
            }
            for(int i=0;i<n;i++){
                a[i].y=scan.nextInt();
            }
            int m=scan.nextInt();
            Node[]b=new Node[m];
            for(int i=0;i<m;i++){
                b[i]=new Node(scan.nextInt(),0);
            }
            for(int i=0;i<m;i++){
                b[i].y=scan.nextInt();
            }
            Arrays.sort(a);
            Arrays.sort(b);
            int[]suffa=new int[n];
            int[]suffb=new int[m];
            suffa[n-1]=n-1;
            for(int i=n-2;i>=0;i--){
                if(a[i].y>a[suffa[i+1]].y)
                    suffa[i]=i;
                else
                    suffa[i]=suffa[i+1];
            }
            suffb[m-1]=m-1;
            for(int i=m-2;i>=0;i--){
                if(b[i].y>b[suffb[i+1]].y)
                    suffb[i]=i;
                else
                    suffb[i]=suffb[i+1];
            }
            int[]next=new int[n+m];
            Arrays.fill(next,-1);
            for(int i=0;i<n;i++){
                int l=0;
                int r=m-1;
                int ans=m;
                while(l<=r){
                    int mid=(l+r)/2;
                    if(b[mid].x>a[i].y){
                        ans=mid;
                        r=mid-1;
                    }
                    else{
                        l=mid+1;
                    }
                }
                if(ans<m)
                    next[i]=n+suffb[ans];
            }
            for(int i=0;i<m;i++){
                int l=0;
                int r=n-1;
                int ans=n;
                while(l<=r){
                    int mid=(l+r)/2;
                    if(a[mid].x>b[i].y){
                        ans=mid;
                        r=mid-1;
                    }
                    else{
                        l=mid+1;
                    }
                }
                if(ans<n)
                    next[n+i]=suffa[ans];
            }
            int[]win=new int[n+m];//0=draw,1=win,2=lose
            Queue<Integer>q=new LinkedList<>();
            ArrayList<Integer>[]rev=new ArrayList[n+m];
            for(int i=0;i<n+m;i++){
                rev[i]=new ArrayList<>();
            }
            for(int i=0;i<n+m;i++){
                if(next[i]==-1){
                    win[i]=2;
                    q.add(i);
                }
                else{
                    rev[next[i]].add(i);
                }
            }
            while(!q.isEmpty()){
                int u=q.poll();
                for(int v:rev[u]){
                    if(win[v]!=0)
                        continue;
                    win[v]=3-win[u];
                    q.add(v);
                }
            }
            int countw=0;
            int countd=0;
            int countl=0;
            for(int i=0;i<n;i++){
                if(win[i]==0)
                    countd++;
                if(win[i]==1)
                    countw++;
                if(win[i]==2)
                    countl++;
            }
            System.out.println(countl+" "+countd+" "+countw);
        }
    }
}
