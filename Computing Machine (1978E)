import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]a=new int[n];//0=0,1=no,no,2=yes,no,3=no,yes,4=yes,yes
            int[]b=new int[n];//0=0,1=no,2=yes
            String s=scan.next();
            for(int i=0;i<n;i++){
                a[i]=s.charAt(i)-'0';
            }
            s=scan.next();
            for(int i=0;i<n;i++){
                b[i]=s.charAt(i)-'0';
            }
            for(int i=1;i<n-1;i++){
                if(b[i]==1)
                    continue;
                if(a[i-1]==0&&a[i+1]==0)
                    b[i]=2;
            }
            for(int i=1;i<n-1;i++){
                if(a[i]==1)
                    continue;
                if(b[i-1]==2&&b[i+1]==1)
                    a[i]=2;
                if(b[i-1]==1&&b[i+1]==2)
                    a[i]=3;
                if(b[i-1]==2&&b[i+1]==2)
                    a[i]=4;
                if(b[i-1]==1&&b[i+1]==1)
                    a[i]=5;
            }
            int[]pre=new int[n];
            for(int i=0;i<n;i++){
                pre[i]=a[i]>0?1:0;
                if(i!=0)
                    pre[i]+=pre[i-1];
            }
            int q=scan.nextInt();
            for(int i=0;i<q;i++){
                int l=scan.nextInt()-1;
                int r=scan.nextInt()-1;
                int ans=pre[r]-(l==0?0:pre[l-1]);
                if(l+2>=r){
                    for(int j=l;j<=r;j++){
                        if(a[j]==2||a[j]==3||a[j]==4||((j==l||j==r)&&a[j]==5))
                            ans--;
                    }
                    System.out.println(ans);
                    continue;
                }
                if(a[l]==2||a[l]==3||a[l]==4||a[l]==5)
                    ans--;
                if(a[l+1]==2||a[l+1]==4)
                    ans--;
                if(a[r-1]==3||a[r-1]==4)
                    ans--;
                if(a[r]==2||a[r]==3||a[r]==4||a[r]==5)
                    ans--;
                System.out.println(ans);
            }
        }
    }
}
