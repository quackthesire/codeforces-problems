#include <bits/stdc++.h>
using namespace std;
using ll=long long;
struct Segtree{
    int n;
    vector<int>in;
    vector<int>out;
    vector<vector<int>>adj;
    vector<bool>active;
    Segtree(int n):n(n){
        in.resize(4*n);
        out.resize(4*n);
        adj.resize(2*n);
        active.resize(4*n);
        build(1,0,n-1);
    }
    void build(int node,int l,int r){
        if(l==r){
            in[node]=l;
            out[node]=l+n;
            return;
        }
        adj.push_back({});
        in[node]=adj.size()-1;
        adj.push_back({});
        out[node]=adj.size()-1;
        int m=(l+r)/2;
        build(node*2,l,m);
        build(node*2+1,m+1,r);
        adj[out[node]].push_back(out[node*2]);
        adj[out[node]].push_back(out[node*2+1]);
        adj[in[node*2]].push_back(in[node]);
        adj[in[node*2+1]].push_back(in[node]);
    }
    void query(int node,int l,int r,int ql,int qr,vector<int>&nodes){
        if(r<ql||qr<l)
            return;
        if(ql<=l&&r<=qr){
            nodes.push_back(node);
            return;
        }
        int m=(l+r)/2;
        query(node*2,l,m,ql,qr,nodes);
        query(node*2+1,m+1,r,ql,qr,nodes);
    }
    void add(int l,int r){
        vector<int>nodes;
        query(1,0,n-1,l,r,nodes);
        for(int u:nodes){
            active[u]=true;
            for(int v:nodes){
                if(u==v)
                    continue;
                adj[in[u]].push_back(out[v]);
            }
        }
    }
    void update(int node,int l,int r,bool cur){
        if(l==r)
            return;
        cur|=active[node];
        if(cur){
            adj[in[node*2]].push_back(out[node*2+1]);
            adj[in[node*2+1]].push_back(out[node*2]);
        }
        int m=(l+r)/2;
        update(node*2,l,m,cur);
        update(node*2+1,m+1,r,cur);
    }
};
void dfs(int u,int& t,int& cur,vector<int>&disc,vector<int>&low,vector<int>&comp,vector<bool>&visited,Segtree& segtree,stack<int>&s){
    t++;
    disc[u]=t;
    low[u]=t;
    s.push(u);
    visited[u]=true;
    for(int v:segtree.adj[u]){
        if(disc[v]==-1){
            dfs(v,t,cur,disc,low,comp,visited,segtree,s);
            low[u]=min(low[u],low[v]);
        }
        else if(visited[v])
            low[u]=min(low[u],disc[v]);
    }
    if(low[u]==disc[u]){
        while(true){
            visited[s.top()]=false;
            comp[s.top()]=cur;
            if(u==s.top()){
                s.pop();
                break;
            }
            s.pop();
        }
        cur++;
    }
}
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    int m;
    cin>>n>>m;
    Segtree segtree(n);
    for(int i=0;i<m;i++){
        int t;
        int u;
        int v;
        cin>>t>>u>>v;
        u--;
        v--;
        if(t==1){
            segtree.adj[u].push_back(v+n);
            segtree.adj[v].push_back(u+n);
        }
        if(t==2){
            segtree.adj[u+n].push_back(v);
            segtree.adj[v+n].push_back(u);
        }
        if(t==3){
            segtree.add(u,v);
        }
    }
    segtree.update(1,0,n-1,false);
    int t=0;
    int cur=0;
    vector<int>disc(segtree.adj.size(),-1);
    vector<int>low(segtree.adj.size());
    vector<int>comp(segtree.adj.size());
    vector<bool>visited(segtree.adj.size(),false);
    stack<int>s;
    for(int i=0;i<segtree.adj.size();i++){
        if(disc[i]==-1)
            dfs(i,t,cur,disc,low,comp,visited,segtree,s);
    }
    bool work=true;
    for(int i=0;i<n;i++){
        if(comp[i]==comp[i+n]){
            work=false;
            break;
        }
    }
    if(!work){
        cout<<-1;
        return 0;
    }
    cout<<1<<"\n";
    for(int i=0;i<n;i++){
        cout<<(comp[i]<comp[i+n])<<" ";
    }
}
