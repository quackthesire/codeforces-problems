import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            int x=scan.nextInt();
            int[][][]dp=new int[n][2][2];
            dp[0][0][1]=1;
            if(n>1){
                dp[1][0][1]=1;
                dp[1][1][0]=1;
                if(array[0]+array[1]>=2*x)
                    dp[1][1][1]=2;
            }
            for(int i=2;i<n;i++){
                dp[i][0][0]=Math.max(dp[i-1][0][0],dp[i-1][1][0]);
                dp[i][0][1]=Math.max(dp[i-1][0][0]+1,dp[i-1][1][0]+1);
                dp[i][1][0]=Math.max(dp[i-1][0][1],dp[i-1][1][1]);
                if(array[i-1]+array[i]>=2*x){
                    dp[i][1][1]=Math.max(dp[i][1][1],dp[i-1][0][1]+1);
                    if(array[i-2]+array[i-1]+array[i]>=3*x)
                        dp[i][1][1]=Math.max(dp[i][1][1],dp[i-1][1][1]+1);
                }
            }
            System.out.println(Math.max(Math.max(Math.max(dp[n-1][0][0],dp[n-1][0][1]),dp[n-1][1][0]),dp[n-1][1][1]));
        }
    }
}
