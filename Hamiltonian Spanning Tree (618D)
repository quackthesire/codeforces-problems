import java.util.*;
public class Main{
    static int ans=0;
    static boolean dfs(int u,int parent,LinkedList<Integer>[]adj){
        int count=0;
        for(int v:adj[u]){
            if(v==parent)
                continue;
            if(dfs(v,u,adj)&&count<2){
                ans++;
                count++;
            }
        }
        return count<2;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        long x=scan.nextLong();
        long y=scan.nextLong();
        if(x>y){
            int[]array=new int[n];
            for(int i=0;i<n-1;i++){
                array[scan.nextInt()-1]++;
                array[scan.nextInt()-1]++;
            }
            int max=Integer.MIN_VALUE;
            for(int i=0;i<n;i++){
                max=Math.max(max,array[i]);
            }
            System.out.print(y*(n-2)+(max==n-1?x:y));
        }
        else{
            LinkedList<Integer>[]adj=new LinkedList[n];
            for(int i=0;i<n;i++){
                adj[i]=new LinkedList<>();
            }
            for(int i=0;i<n-1;i++){
                int a=scan.nextInt()-1;
                int b=scan.nextInt()-1;
                adj[a].add(b);
                adj[b].add(a);
            }
            dfs(0,-1,adj);
            System.out.println(y*(n-1-ans)+x*ans);
        }
    }
}
