#include <bits/stdc++.h>
#include <bitset>
using namespace std;
using ll=long long;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int m;
    int n;
    cin>>m>>n;
    vector<ll>array(n);
    for(int i=0;i<n;i++){
        cin>>array[i];
    }
    vector<vector<vector<int>>>list(m,vector<vector<int>>(n));
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            int val;
            cin>>val;
            list[i][val-1].push_back(j);
        }
    }
    vector<bitset<5000>>sets(n);
    for(int i=0;i<n;i++){
        sets[i].set();
    }
    for(int i=0;i<m;i++){
        bitset<5000>cur;
        for(int j=0;j<n;j++){
            for(int k:list[i][j]){
                sets[k]&=cur;
            }
            for(int k:list[i][j]){
                cur.set(k);
            }
        }
    }
    vector<int>deg(n);
    vector<vector<int>>adj(n);
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            if(sets[i][j]){
                adj[j].push_back(i);
                deg[i]++;
            }
        }
    }
    queue<int>q;
    vector<int>order;
    for(int i=0;i<n;i++){
        if(deg[i]==0)
            q.push(i);
    }
    while(!q.empty()){
        int u=q.front();
        q.pop();
        order.push_back(u);
        for(int v:adj[u]){
            deg[v]--;
            if(deg[v]==0)
                q.push(v);
        }
    }
    vector<ll>dp(n);
    for(int i=0;i<order.size();i++){
        dp[order[i]]=array[order[i]];
        for(int j=0;j<n;j++){
            if(sets[order[i]][j])
                dp[order[i]]=max(dp[order[i]],dp[j]+array[order[i]]);
        }
    }
    ll best=0;
    for(int i=0;i<n;i++){
        best=max(best,dp[i]);
    }
    cout<<best<<"\n";
}
