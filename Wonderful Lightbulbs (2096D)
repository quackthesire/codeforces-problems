#include <bits/stdc++.h>
using namespace std;
using ll=long long;
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        unordered_map<int,int>row;
        unordered_map<int,int>diag;
        for(int i=0;i<n;i++){
            int x;
            int y;
            cin>>x>>y;
            row[x]++;
            diag[x+y]++;
        }
        int rowval;
        int diagval;
        for(const auto&[val,count]:row){
            if(count%2==1)
                rowval=val;
        }
        for(const auto&[val,count]:diag){
            if(count%2==1)
                diagval=val;
        }
        cout<<rowval<<" "<<(diagval-rowval)<<"\n";
    }
}
