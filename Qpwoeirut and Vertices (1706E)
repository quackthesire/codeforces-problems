import java.util.*;
public class Main{
    static class DSU{
        int n;
        int[]val;
        int[]size;
        int[]parent;
        ArrayList<Integer>[]child;
        public DSU(int n){
            this.n=n;
            this.val=new int[n-1];
            this.size=new int[n];
            this.parent=new int[n];
            this.child=new ArrayList[n];
            Arrays.fill(val,Integer.MAX_VALUE/2);
            Arrays.fill(size,1);
            for(int i=0;i<n;i++){
                parent[i]=i;
                child[i]=new ArrayList<>();
                child[i].add(i);
            }
        }
        public void merge(int u,int v,int w){
            u=parent[u];
            v=parent[v];
            if(u==v)
                return;
            if(size[v]<size[u]){
                int temp=v;
                v=u;
                u=temp;
            }
            size[v]+=size[u];
            for(int i:child[u]){
                parent[i]=v;
                child[v].add(i);
                if(i!=0&&parent[i-1]==v)
                    val[i-1]=Math.min(val[i-1],w);
                if(i!=n-1&&parent[i+1]==v)
                    val[i]=Math.min(val[i],w);
            }
        }
    }
    static class Segtree{
        int n;
        int[]tree;
        public Segtree(int[]array){
            this.n=array.length;
            tree=new int[4*n];
            build(array,1,0,n-1);
        }
        public void build(int[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
        public int query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            int left=query(node*2,l,m,ll,rr);
            int right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int q=scan.nextInt();
            DSU dsu=new DSU(n);
            for(int i=0;i<m;i++){
                dsu.merge(scan.nextInt()-1,scan.nextInt()-1,i+1);
            }
            Segtree segtree=new Segtree(dsu.val);
            for(int i=0;i<q;i++){
                System.out.print(segtree.query(scan.nextInt()-1,scan.nextInt()-2)+" ");
            }
            System.out.println();
        }
    }
}
