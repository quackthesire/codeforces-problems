import java.util.*;
public class Main{
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int t=scan.nextInt();
	    for(int temp=0;temp<t;temp++){
	        int n=scan.nextInt();
	        Integer[]v1=new Integer[n];
	        Integer[]v2=new Integer[n];
	        for(int i=0;i<n;i++){
	            v1[i]=scan.nextInt();
	        }
	        for(int i=0;i<n;i++){
	            v2[i]=scan.nextInt();
	        }
	        Arrays.sort(v1);
	        Arrays.sort(v2,Collections.reverseOrder());
	        long sum=0;
	        for(int i=0;i<n;i++){
	            sum+=((long)v1[i])*v2[i];
	        }
	        System.out.println("Case #"+(temp+1)+": "+sum);
	    }
	}
}
