import java.util.*;
public class Main{
    public static void main(String[]args) throws Exception{
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<m;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(v);
                adj[v].add(u);
            }
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            String s=scan.next();
            int[]color=new int[n];
            for(int i=0;i<n;i++){
                color[i]=(s.charAt(i)=='R')?1:0;
            }
            int[]array2=new int[n];
            for(int i=0;i<n;i++){
                array2[i]=scan.nextInt();
            }
            s=scan.next();
            int[]color2=new int[n];
            for(int i=0;i<n;i++){
                color2[i]=(s.charAt(i)=='R')?1:0;
            }
            boolean work=true;
            int[]comp=new int[n];
            Arrays.fill(comp,-1);
            for(int i=0;i<n&&work;i++){
                if(comp[i]!=-1)
                    continue;
                Queue<Integer>q=new LinkedList<>();
                ArrayList<Integer>cur=new ArrayList<>();
                comp[i]=0;
                q.add(i);
                cur.add(i);
                boolean bipartite=true;
                while(!q.isEmpty()){
                    int u=q.poll();
                    for(int v:adj[u]){
                        if(comp[v]==-1){
                            comp[v]=1-comp[u];
                            q.add(v);
                            cur.add(v);
                        }
                        else if(comp[v]==comp[u])
                            bipartite=false;
                    }
                }
                if(bipartite){
                    long[]vals=new long[cur.size()];
                    long[]vals2=new long[cur.size()];
                    for(int j=0;j<cur.size();j++){
                        int u=cur.get(j);
                        vals[j]=((long)array[u]*2)+(comp[u]^color[u]);
                        vals2[j]=((long)array2[u]*2)+(comp[u]^color2[u]);
                    }
                    Arrays.sort(vals);
                    Arrays.sort(vals2);
                    for(int j=0;j<cur.size();j++){
                        if(vals[j]!=vals2[j]){
                            work=false;
                            break;
                        }
                    }
                }
                else{
                    int[]vals=new int[cur.size()];
                    int[]vals2=new int[cur.size()];
                    int count=0;
                    int count2=0;
                    for(int j=0;j<cur.size();j++){
                        int u=cur.get(j);
                        vals[j]=array[u];
                        vals2[j]=array2[u];
                        count+=color[u];
                        count2+=color2[u];
                    }
                    if((count%2)!=(count2%2)){
                        work=false;
                        break;
                    }
                    Arrays.sort(vals);
                    Arrays.sort(vals2);
                    for(int j=0;j<cur.size();j++){
                        if(vals[j]!=vals2[j]){
                            work=false;
                            break;
                        }
                    }
                }
            }
            System.out.println(work?"YES":"NO");
        }
    }
}
