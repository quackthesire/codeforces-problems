import java.util.*;
public class Main{
    static class Edge{ 
        int node;
        long w;
        int c;
        public Edge(int node,long w,int c){
            this.node=node;
            this.w=w;
            this.c=c;
        }
    }
    static class State implements Comparable<State>{
        int node;
        int r;
        int b;
        long dist;
        public State(int node,int r,int b,long dist){
            this.node=node;
            this.r=r;
            this.b=b;
            this.dist=dist;
        }
        public int compareTo(State other){
            return Long.compare(this.dist,other.dist);
        }
    }
    public static void main(String[] args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int m=scan.nextInt();
        int a=scan.nextInt();
        int b=scan.nextInt();
        ArrayList<Edge>[]adj=new ArrayList[n];
        for(int i=0;i<n;i++){
            adj[i]=new ArrayList<>();
        }
        for(int i=0;i<m;i++){
            int u=scan.nextInt()-1;
            int v=scan.nextInt()-1;
            long w=scan.nextLong();
            int c=scan.nextInt();
            adj[u].add(new Edge(v,w,c));
            adj[v].add(new Edge(u,w,c));
        }
        int s=scan.nextInt()-1;
        int t=scan.nextInt()-1;
        long[][][]dist=new long[n+1][a+1][b+1];
        for(int i=0;i<n;i++){
            for(int j=0;j<=a;j++){
                Arrays.fill(dist[i][j],Long.MAX_VALUE);
            }
        }
        dist[s][0][0]=0;
        PriorityQueue<State>pq=new PriorityQueue<>();
        pq.add(new State(s,0,0,0));
        while(!pq.isEmpty()){
            State state=pq.poll();
            if(state.dist>dist[state.node][state.r][state.b])
                continue;
            if(state.node==t&&state.r==a&&state.b==b){
                System.out.println(state.dist);
                System.exit(0);
            }
            for(Edge e:adj[state.node]){
                int red=state.r;
                int blue=state.b;
                if(e.c==1){
                    if(red==a)
                        continue;
                    red++;
                }
                if(e.c==2){
                    if(blue==b)
                        continue;
                    blue++;
                }
                if(state.dist+e.w<dist[e.node][red][blue]){
                    dist[e.node][red][blue]=state.dist+e.w;
                    pq.add(new State(e.node,red,blue,state.dist+e.w));
                }
            }
        }
        System.out.println(-1);
    }
}
