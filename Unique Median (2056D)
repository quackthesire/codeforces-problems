import java.util.*;
public class Main{
    static int bs(ArrayList<Integer>list,int val){
        int l=0;
        int r=list.size()-1;
        int res=-1;
        while(l<=r){
            int m=(l+r)/2;
            if(list.get(m)<val){
                res=m;
                l=m+1;
            }
            else
                r=m-1;
        }
        return res;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            long ans=(long)n*(n+1)/2;
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            for(int i=1;i<=10;i++){
                int[]pre=new int[n];
                int[]count=new int[n];
                for(int j=0;j<n;j++){
                    pre[j]=(array[j]<=i?-1:1);
                    count[j]=(array[j]==i?1:0);
                    if(j!=0){
                        pre[j]+=pre[j-1];
                        count[j]+=count[j-1];
                    }
                }
                ArrayList<Integer>[]list=new ArrayList[2*n+1];
                for(int j=0;j<=2*n;j++){
                    list[j]=new ArrayList<>();
                }
                list[n].add(0);
                for(int j=0;j<n;j++){
                    ans-=bs(list[pre[j]+n],count[j])+1;
                    list[pre[j]+n].add(count[j]);
                }
            }
            System.out.println(ans);
        }
    }
}
