import java.util.*;
public class Main{
    static class Edge{
        int u;
        int v;
        long w;
        public Edge(int u,int v,long w){
            this.u=u;
            this.v=v;
            this.w=w;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            long[][]dist=new long[n][n];
            ArrayList<Edge>edges=new ArrayList<>();
            for(int i=0;i<n;i++){
                Arrays.fill(dist[i],Long.MAX_VALUE/2);
                dist[i][i]=0;
            }
            for(int i=0;i<m;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                int w=scan.nextInt();
                edges.add(new Edge(u,v,w));
                edges.add(new Edge(v,u,w));
                dist[u][v]=1;
                dist[v][u]=1;
            }
            
            for(int k=0;k<n;k++){
                for(int i=0;i<n;i++){
                    for(int j=0;j<n;j++){
                        dist[i][j]=Math.min(dist[i][j],dist[i][k]+dist[k][j]);
                    }
                }
            }
            long ans=Long.MAX_VALUE/2;
            for(Edge i:edges){
                ans=Math.min(ans,i.w*(dist[i.u][0]+dist[i.v][n-1]+1));
                for(int j=0;j<n;j++){
                    ans=Math.min(ans,i.w*(dist[i.u][j]+dist[j][0]+dist[j][n-1]+2));
                }
            }
            System.out.println(ans);
        }
    }
}
