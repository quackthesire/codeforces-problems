import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int k=scan.nextInt();
            int[]array=new int[k];
            for(int i=0;i<k;i++){
                array[i]=scan.nextInt();
                for(int j=0;j<array[i]-1;j++){
                    scan.nextInt();
                }
            }
            int[]count=new int[20];
            for(int i=0;i<20;i++){
                for(int j=0;j<k;j++){
                    if((array[j]&(1<<i))!=0)
                        count[i]++;
                }
            }
            int ans=0;
            for(int i=19;i>=0;i--){
                if(count[i]>=2){
                    ans+=(1<<(i+1))-1;
                    break;
                }
                ans+=(1<<i)*count[i];
            }
            System.out.println(ans);
        }
    }
}
