import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int k=scan.nextInt();
            int[]array=new int[n+1];
            for(int i=1;i<=n;i++){
                array[i]=scan.nextInt();
            }
            int[][]dp=new int[n+1][n+1];
            for(int i=0;i<=n;i++){
                Arrays.fill(dp[i],Integer.MIN_VALUE);
            }
            dp[0][0]=0;
            for(int i=1;i<=n;i++){
                for(int j=0;j<=i;j++){
                    if(j!=0)
                        dp[i][j]=Math.max(dp[i][j],dp[i-1][j-1]);
                    if(j!=i)
                        dp[i][j]=Math.max(dp[i][j],dp[i-1][j]+(array[i]==i-j?1:0));
                }
            }
            boolean work=false;
            for(int i=0;i<=n;i++){
                if(dp[n][i]>=k){
                    System.out.println(i);
                    work=true;
                    break;
                }
            }
            if(!work)
                System.out.println(-1);
        }
    }
}
