import java.util.*;
public class Main{
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int n=scan.nextInt();
	    Double[]a=new Double[n];
	    Double[]b=new Double[n];
	    for(int i=0;i<n;i++){
	        a[i]=scan.nextDouble();
	        b[i]=scan.nextDouble();
	    }
	    Arrays.sort(a,Collections.reverseOrder());
	    Arrays.sort(b,Collections.reverseOrder());
	    double[]prea=new double[n];
	    double[]preb=new double[n];
	    for(int i=0;i<n;i++){
	        prea[i]=a[i];
	        preb[i]=b[i];
	        if(i!=0){
	            prea[i]+=prea[i-1];
	            preb[i]+=preb[i-1];
	        }
	    }
	    int indexa=0;
	    int indexb=0;
	    double max=0;
	    while(indexa!=n-1&&indexb!=n-1){
	        max=Math.max(max,Math.min(prea[indexa],preb[indexb])-indexa-indexb-2);
	        if(prea[indexa]==preb[indexb]){
	            if(indexa<n-1&&indexb<n-1){
	                indexa++;
	                indexb++;
	            }
	            else
	                break;
	        }
	        else if(prea[indexa]<preb[indexb]){
	            if(indexa<n-1)
	                indexa++;
	            else
	                break;
	        }
	        else{
	            if(indexb<n-1)
	                indexb++;
	            else
	                break;
	        }
	    }
	    System.out.println(max);
	}
}
