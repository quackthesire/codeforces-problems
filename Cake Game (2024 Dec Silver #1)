import java.util.*;
public class Main{
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int t=scan.nextInt();
	    for(int temp=0;temp<t;temp++){
	        int n=scan.nextInt();
	        long sum=0;
	        int[]array=new int[n];
	        long[]pre=new long[n/2+1];
	        long[]suff=new long[n/2+1];
	        for(int i=0;i<n;i++){
	            array[i]=scan.nextInt();
	            sum+=array[i];
	        }
	        for(int i=0;i<n/2;i++){
	            pre[i+1]=pre[i]+array[i];
	            suff[i+1]=suff[i]+array[n-i-1];
	        }
	        long best=0;
	        for(int i=0;i<n/2;i++){
	            best=Math.max(best,pre[i]+suff[n/2-i-1]);
	        }
	        System.out.println((sum-best)+" "+best);
	    }
	}
}
