#include <bits/stdc++.h>
using namespace std;
using ll=long long;
const ll MOD=1000000007;
int main(){
    int t;
    cin>>t;
    while(t--){
        ll n;
        cin>>n;
        const int size=60;
        bitset<size>bin(n);
        vector<vector<vector<ll>>>dp(size+1,vector<vector<ll>>(4,vector<ll>(2)));
        dp[0][0][1]=1;
        for(int i=0;i<size;i++){
            for(int j=0;j<4;j++){
                for(int k=0;k<2;k++){
                    for(int l=0;l<2;l++){
                        if(k==1&&l>bin.test(size-i-1))
                            continue;
                        int newk=k&&(l==bin.test(size-i-1));
                        if(j==0&&l==0)
                            dp[i+1][0][newk]+=dp[i][0][k];
                        if(j==0&&l==1)
                            dp[i+1][1][newk]+=dp[i][0][k];
                        if(j==1&&l==1)
                            dp[i+1][2][newk]+=dp[i][1][k];
                        if(j==2&&l==0)
                            dp[i+1][3][newk]+=dp[i][2][k];
                        if(j==2&&l==1)
                            dp[i+1][1][newk]+=dp[i][2][k];
                        if(j==3)
                            dp[i+1][3][newk]+=dp[i][3][k];
                        dp[i+1][0][newk]%=MOD;
                        dp[i+1][1][newk]%=MOD;
                        dp[i+1][2][newk]%=MOD;
                        dp[i+1][3][newk]%=MOD;
                    }
                }
            }
        }
        ll ans=dp[size][2][0]+dp[size][3][0]+dp[size][2][1]+dp[size][3][1];
        cout<<ans<<"\n";
    }
}
