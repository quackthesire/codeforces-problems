import java.util.*;
public class Main{
    static void dfs(int u,int p,long[]vals,long[][]array,ArrayList<Integer>[]adj){
        long temp=array[u][0];
        for(int v:adj[u]){
            if(v==p)
                continue;
            dfs(v,u,vals,array,adj);
            temp=Math.max(temp,vals[v]);
        }
        vals[u]=Math.min(temp,array[u][1]);
    }
    static long solve(int u,int p,long[]vals,ArrayList<Integer>[]adj){
        long ans=0;
        for(int v:adj[u]){
            if(v==p)
                continue;
            ans+=solve(v,u,vals,adj);
            ans+=Math.max(vals[v]-vals[u],0);
        }
        return ans;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            long[]vals=new long[n];
            long[][]array=new long[n][2];
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                array[i][0]=scan.nextLong();
                array[i][1]=scan.nextLong();
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<n-1;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(v);
                adj[v].add(u);
            }
            dfs(0,-1,vals,array,adj);
            System.out.println(vals[0]+solve(0,-1,vals,adj));
        }
    }
}
