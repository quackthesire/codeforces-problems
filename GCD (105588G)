import java.util.*;
public class Main{
	static int best;
	static class State{
	  long a;
	  long b;
	  int t;
	  public State(long a,long b,int t){
		  this.a=a;
		  this.b=b;
		  this.t=t;
	  }
	}
	static long gcd(long a,long b){
	  while(b!=0){
		  long temp=a%b;
		  a=b;
		  b=temp;
	  }
	  return a;
	}
	public static void main(String[]args){
		Scanner scan=new Scanner(System.in);
		int t=scan.nextInt();
		for(int temp=0;temp<t;temp++){
		    long a=scan.nextLong();
		    long b=scan.nextLong();
		    int max=(int)(2*Math.log(a)/Math.log(2)+2);
		    best=max;
		    Queue<State>q=new LinkedList<>();
		    q.add(new State(a,b,0));
		    while(!q.isEmpty()){
		        /*for(State s:q){
		            System.out.print("State: "+s.a+" "+s.b+" "+s.t+" ");
		        }
		        System.out.println();*/
		        State s=q.poll();
		        if(s.a==0||s.b==0)
		            best=Math.min(best,s.t+1);
		        else if(s.t<best-2){
		            long gcd=gcd(s.a,s.b);
		            q.add(new State(s.a-gcd,s.b,s.t+1));
		            q.add(new State(s.a,s.b-gcd,s.t+1));
		        }
		    }
		    System.out.println(best);
		}
	}
}
