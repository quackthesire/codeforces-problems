import java.util.*;
public class Main{
    static void dfs(int u,int p,int pp,int cur,ArrayList<Integer>[]adj,ArrayList<Integer>[]vals,int[]depth){
        depth[u]=cur;
        if(pp!=-1){
            vals[u]=new ArrayList<>(vals[pp]);
            vals[u].add(adj[p].size());
        }
        for(int v:adj[u]){
            if(v==p)
                continue;
            if(p==-1)
                dfs(v,u,-1,cur+1,adj,vals,depth);
            else
                dfs(v,u,p,cur+1,adj,vals,depth);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int q=scan.nextInt();
            int[]depth=new int[n];
            ArrayList<Integer>[]adj=new ArrayList[n];
            ArrayList<Integer>[]vals=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
                vals[i]=new ArrayList<>();
            }
            for(int i=0;i<n-1;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(v);
                adj[v].add(u);
            }
            dfs(0,-1,-1,0,adj,vals,depth);
            for(int i=0;i<n;i++){
                Collections.sort(vals[i]);
            }
            for(int i=0;i<q;i++){
                int v=scan.nextInt()-1;
                int p=scan.nextInt();
                int count=0;
                int ans=0;
                for(int j=0;j<vals[v].size()-p;j++){
                    ans+=2*vals[v].get(j);
                    count++;
                }
                System.out.println(ans+2*(vals[v].size()-count)+(depth[v]%2==1?1:0));
            }
        }
    }
}
