import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public long query(int l,int r){
            if(l>r)
                return 0;
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=Math.max(tree[node],val);
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            ArrayList<Integer>[]pos=new ArrayList[n];
            for(int i=0;i<n;i++){
                pos[i]=new ArrayList<>();
            }
            for(int i=0;i<m;i++){
                pos[scan.nextInt()-1].add(i);
            }
            boolean work=true;
            for(int i=0;i<n;i++){
                if(pos[i].size()==0)
                    work=false;
            }
            if(!work){
                System.out.println(-1);
                continue;
            }
            long[][]pre=new long[n][];
            long[][]suff=new long[n][];
            for(int i=0;i<n;i++){
                pre[i]=new long[pos[i].size()];
                suff[i]=new long[pos[i].size()];
            }
            int max=m-1;
            Segtree segtree=new Segtree(m);
            for(int i=0;i<n;i++){
                for(int j=0;j<pos[i].size();j++){
                    pre[i][j]=segtree.query(pos[i].get(j)+1,max);
                }
                int best=-1;
                for(int j:pos[i]){
                    best=Math.max(best,j);
                }
                max=Math.min(max,best);
                if(i==0){
                    for(int j:pos[i]){
                        segtree.update(j,1);
                    }
                    continue;
                }
                for(int j=0;j<pos[i].size();j++){
                    int k=pos[i].get(j);
                    if(pre[i][j]>0)
                        segtree.update(k,pre[i][j]+1);
                }
            }
            max=m-1;
            segtree=new Segtree(m);
            for(int i=n-1;i>=0;i--){
                for(int j=0;j<pos[i].size();j++){
                    suff[i][j]=segtree.query(pos[i].get(j)+1,max);
                }
                int best=-1;
                for(int j:pos[i]){
                    best=Math.max(best,j);
                }
                max=Math.min(max,best);
                if(i==n-1){
                    for(int j:pos[i]){
                        segtree.update(j,1);
                    }
                    continue;
                }
                for(int j=0;j<pos[i].size();j++){
                    int k=pos[i].get(j);
                    if(suff[i][j]>0)
                        segtree.update(k,suff[i][j]+1);
                }
            }
            long min=Long.MAX_VALUE/4;
            for(int i=0;i<n;i++){
                for(int j=0;j<pos[i].size();j++){
                    min=Math.min(min,n-pre[i][j]-suff[i][j]-1);
                }
            }
            System.out.println(min);
        }
    }
}
