import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]tree;
        boolean min;
        public Segtree(int[]array,boolean min){
            this.n=array.length;
            this.min=min;
            tree=new int[4*n];
            build(array,1,0,n-1);
        }
        public void build(int[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=min?Math.min(tree[node*2],tree[node*2+1]):Math.max(tree[node*2],tree[node*2+1]);
        }
        public int query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public int query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return min?1000000000:0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            int left=query(node*2,l,m,ll,rr);
            int right=query(node*2+1,m+1,r,ll,rr);
            return min?Math.min(left,right):Math.max(left,right);
        }
    }
    static int bsl(Segtree segtree,int val,int cur){
        int l=cur;
        int r=segtree.n-2;
        int ans=-1;
        while(l<=r){
            int m=(l+r)/2;
            int temp=segtree.query(cur,m);
            if(temp==val){
                ans=m;
                r=m-1;
            }
            else if(temp>val)
                l=m+1;
            else
                r=m-1;
        }
        return ans;
    }
    static int bsr(Segtree segtree,int val,int cur){
        int l=cur;
        int r=segtree.n-2;
        int ans=-1;
        while(l<=r){
            int m=(l+r)/2;
            int temp=segtree.query(cur,m);
            if(temp==val){
                ans=m;
                l=m+1;
            }
            else if(temp>val)
                l=m+1;
            else
                r=m-1;
        }
        return ans;
    }
    static int bsl2(Segtree segtree,int val,int cur){
        int l=cur;
        int r=segtree.n-1;
        int ans=-1;
        while(l<=r){
            int m=(l+r)/2;
            int temp=segtree.query(m,segtree.n-1);
            if(temp==val){
                ans=m;
                r=m-1;
            }
            else if(temp>val)
                l=m+1;
            else
                r=m-1;
        }
        return ans;
    }
    static int bsr2(Segtree segtree,int val,int cur){
        int l=cur;
        int r=segtree.n-1;
        int ans=-1;
        while(l<=r){
            int m=(l+r)/2;
            int temp=segtree.query(m,segtree.n-1);
            if(temp==val){
                ans=m;
                l=m+1;
            }
            else if(temp>val)
                l=m+1;
            else
                r=m-1;
        }
        return ans;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            boolean work=false;
            Segtree min=new Segtree(array,true);
            Segtree max=new Segtree(array,false);
            for(int i=0;i<n-2;i++){
                int val=max.query(0,i);
                int l=bsl(min,val,i+1);
                int r=bsr(min,val,i+1);
                int ll=bsl2(max,val,i+2);
                int rr=bsr2(max,val,i+2);
                if(l==-1||ll==-1)
                    continue;
                int left=Math.max(l,ll-1);
                int right=Math.min(r,rr-1);
                if(left<=right){
                    System.out.println("YES");
                    System.out.println((i+1)+" "+(left-i)+" "+(n-left-1));
                    work=true;
                    break;
                }
            }
            if(!work)
                System.out.println("NO");
        }
    }
}
