import java.util.*;
public class Main{
    static class Node{
        int index;
        long val;
        public Node(int index,long val){
            this.index=index;
            this.val=val;
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        long[]lazy;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
            lazy=new long[4*n];
        }
        public void push(int node,int l,int r){
            if(lazy[node]==0)
                return;
            int m=(l+r)/2;
            tree[node*2]+=lazy[node];
            tree[node*2+1]+=lazy[node];
            lazy[node*2]+=lazy[node];
            lazy[node*2+1]+=lazy[node];
            lazy[node]=0;
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return Long.MIN_VALUE/2;
            if(ll<=l&&r<=rr)
                return tree[node];
            push(node,l,r);
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
        public void range(int l,int r,long val){
            range(1,0,n-1,l,r,val);
        }
        public void range(int node,int l,int r,int ll,int rr,long val){
            if(ll>r||rr<l)
                return;
            if(ll<=l&&r<=rr){
                tree[node]+=val;
                lazy[node]+=val;
                return;
            }
            push(node,l,r);
            int m=(l+r)/2;
            range(node*2,l,m,ll,rr,val);
            range(node*2+1,m+1,r,ll,rr,val);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            push(node,l,r);
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]a=new int[n];
            int[]b=new int[n];
            long[]vals=new long[n];
            Node[]array=new Node[n];
            for(int i=0;i<n;i++){
                vals[i]=scan.nextLong();
            }
            for(int i=0;i<n;i++){
                a[i]=scan.nextInt()-1;
            }
            for(int i=0;i<n;i++){
                b[scan.nextInt()-1]=i+1;
            }
            for(int i=0;i<n;i++){
                array[i]=new Node(b[a[i]],vals[a[i]]);
            }
            Segtree segtree=new Segtree(n+1);
            segtree.range(1,n,Long.MIN_VALUE/2);
            for(int i=0;i<n;i++){
                segtree.update(array[i].index,segtree.query(0,array[i].index));
                segtree.range(0,array[i].index-1,array[i].val);
                //System.out.print(segtree.query(0,n)+" ");
            }
            System.out.println(segtree.query(0,n));
        }
    }
}
