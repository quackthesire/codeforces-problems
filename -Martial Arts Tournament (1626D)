import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            Arrays.sort(array);
            int pow=1;
            int[]cost=new int[n+1];
            for(int i=1;i<=n;i++){
                cost[i]=pow-i;
                if(i==pow)
                    pow*=2;
            }
            int[]left=new int[n];
            for(int i=1;i<n;i++){
                if(array[i-1]!=array[i])
                    left[i]=i;
                else
                    left[i]=left[i-1];
            }
            int best=cost[n]+2;
            for(int i=0;i<n;i++){
                int first=left[i];
                if(first==0)
                    continue;
                for(int j=0;(1<<j)<n-first;j++){
                    int second=left[first+(1<<j)];
                    if(second==first||second==n)
                        continue;
                    best=Math.min(best,cost[first]+cost[second-first]+cost[n-second]);
                }
            }
            for(int i=0;i<n;i++){
                int first=left[i];
                if(first==0||first==n)
                    continue;
                best=Math.min(best,cost[first]+cost[n-first]+1);
            }
            System.out.println(best);
        }
    }
}
