import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int[]pos=new int[n];
        int[]array=new int[n];
        for(int i=0;i<n;i++){
            array[i]=scan.nextInt()-1;
            pos[array[i]]=i;
        }
        int[][]dp=new int[n][n];
        for(int i=1;i<n;i++){
            for(int j=0;j<n-i;j++){
                int min=Integer.MAX_VALUE/2;
                for(int k=j;k<i+j;k++){
                    min=Math.min(min,dp[j][k]+dp[k][i+j-1]+Math.abs(pos[i+j]-pos[k]));
                }
                dp[j][i+j]=min;
                //System.out.println(j+" "+(i+j)+" "+dp[j][i+j]);
            }
        }
        System.out.println(dp[0][n-1]);
    }
}
