import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int[][][]array=new int[n][n][n];
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                for(int k=0;k<n;k++){
                    array[i][j][k]=scan.nextInt();
                }
            }
        }
        int[][]dp=new int[n+1][1<<(2*n)];
        for(int i=1;i<=n;i++){
            Arrays.fill(dp[i],Integer.MAX_VALUE/2);
        }
        for(int i=1;i<(1<<(2*n));i++){
            if(2*Integer.bitCount(i>>>n)!=Integer.bitCount(i))
                continue;
            int index=Integer.bitCount(i>>>n);
            for(int j=0;j<n;j++){
                if((i&(1<<j))==0)
                    continue;
                for(int k=n;k<2*n;k++){
                    if((i&(1<<k))==0)
                        continue;
                    dp[index][i]=Math.min(dp[index][i],dp[index-1][i^(1<<j)^(1<<k)]+array[index-1][j][k-n]);
                }
            }
        }
        System.out.print(dp[n][(1<<(2*n))-1]);
    }
}
