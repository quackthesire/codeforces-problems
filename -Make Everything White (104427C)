import java.util.*;
public class Main{
  	public static void main(String[]args){
  	    Scanner scan=new Scanner(System.in);
  	    int n=scan.nextInt();
  	    int m=scan.nextInt();
  	    int[][]array=new int[n][m];
  	    for(int i=0;i<n;i++){
  	        String s=scan.next();
  	        for(int j=0;j<m;j++){
  	            array[i][j]=s.charAt(j)=='W'?1:0;
  	        }
  	    }
  	    for(int i=1;i<n-1;i++){
  	        if(m>1){
      	        array[i][0]=1-array[i][0];
      	        array[i][m-1]=1-array[i][m-1];
  	        }
  	    }
  	    for(int i=1;i<m-1;i++){
  	        if(n>1){
      	        array[0][i]=1-array[0][i];
      	        array[n-1][i]=1-array[n-1][i];
  	        }
  	    }
  	    if(n==1){
  	        array[0][0]=1-array[0][0];
  	        array[0][m-1]=1-array[0][m-1];
  	    }
  	    if(m==1){
  	        array[0][0]=1-array[0][0];
  	        array[n-1][0]=1-array[n-1][0];
  	    }
  	    System.out.println("1");
  	    for(int i=0;i<n;i++){
  	        for(int j=0;j<m;j++){
  	            System.out.print(array[i][j]==1?"2":"3");
  	        }
  	        System.out.println();
  	    }
  	}
}
