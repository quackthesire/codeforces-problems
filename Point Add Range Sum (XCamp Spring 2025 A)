import java.util.*;
public class Main{
    static Scanner scan=new Scanner(System.in);
    static int n=scan.nextInt();
    static int q=scan.nextInt();
    static int[]array=new int[n];
    static long[]tree=new long[2*n];
    static void segtree(){
        for(int i=0;i<n;i++){
            tree[i+n]=array[i];
        }
        for(int i=n-1;i>0;--i){
            tree[i]=tree[i<<1]+tree[i<<1|1]; 
        }
    }
    static void add(int p,int x){
        tree[p+n]+=x;
        for(int i=p+n;i>1;i>>=1){
            tree[i>>1]=tree[i]+tree[i^1];
        }
    }
    static long sum(int l,int r){
        long ans=0;
        for(l+=n,r+=n;l<r;l>>=1,r>>=1){
            if((l&1)>0) 
                ans+=tree[l++];
            if((r&1)>0) 
                ans+=tree[--r];
        }
        return ans;
    }
    public static void main(String[]args){
        for(int i=0;i<n;i++){
            array[i]=scan.nextInt();
        }
        segtree();
        for(int i=0;i<q;i++){
            int a=scan.nextInt();
            int b=scan.nextInt();
            int c=scan.nextInt();
            if(a==0)
                add(b,c);
            else
                System.out.println(sum(b,c));
        }
    }
}
