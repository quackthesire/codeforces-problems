import java.util.*;
public class Main{
    static class Segtree{
        int n;
        int[]tree;
        boolean max;
        public Segtree(int[]array,boolean max){
            this.n=array.length;
            this.tree=new int[4*n];
            this.max=max;
            build(array,1,0,n-1);
        }
        public void build(int[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            if(max)
                tree[node]=Math.max(tree[node*2],tree[node*2+1]);
            else
                tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
        public ArrayList<Integer> query(int l,int r,int val){
            return query(1,0,n-1,l,r,val);
        }
        public ArrayList<Integer> query(int node,int l,int r,int ll,int rr,int val){
            if(ll>r||rr<l)
                return new ArrayList<>();
            if(ll<=l&&r<=rr){
                if((!max&&tree[node]>val)||(max&&tree[node]<val))
                    return new ArrayList<>();
                else if(l==r)
                    return new ArrayList<>(Arrays.asList(l));
            }
            int m=(l+r)/2;
            ArrayList<Integer>left=query(node*2,l,m,ll,rr,val);
            ArrayList<Integer>right=query(node*2+1,m+1,r,ll,rr,val);
            left.addAll(right);
            return left;
        }
        public int min(int l,int r){
            return min(1,0,n-1,l,r);
        }
        public int min(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return Integer.MAX_VALUE/4;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            int left=min(node*2,l,m,ll,rr);
            int right=min(node*2+1,m+1,r,ll,rr);
            return Math.min(left,right);
        }
        public void update(int i,int val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,int val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            if(max)
                tree[node]=Math.max(tree[node*2],tree[node*2+1]);
            else
                tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
    }
    static class Node implements Comparable<Node>{
        int node;
        int dist;
        public Node(int node,int dist){
            this.node=node;
            this.dist=dist;
        }
        public int compareTo(Node other){
            return this.dist-other.dist;
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int[]l=new int[n];
        int[]r=new int[n];
        for(int i=0;i<n;i++){
            l[i]=scan.nextInt()-1;
            r[i]=scan.nextInt()-1;
        }
        int[]distl=new int[n];
        Segtree min=new Segtree(l,false);
        Segtree max=new Segtree(r,true);
        PriorityQueue<Node>pq=new PriorityQueue<>();
        Arrays.fill(distl,Integer.MAX_VALUE/4);
        distl[0]=0;
        min.update(0,Integer.MAX_VALUE/4);
        max.update(0,Integer.MIN_VALUE/4);
        pq.add(new Node(0,0));
        while(!pq.isEmpty()){
            Node cur=pq.poll();
            ArrayList<Integer>next=min.query(cur.node,n-1,cur.node);
            next.addAll(max.query(0,cur.node,cur.node));
            for(int index:next){
                min.update(index,Integer.MAX_VALUE/4);
                max.update(index,Integer.MIN_VALUE/4);
                distl[index]=cur.dist+1;
                pq.add(new Node(index,distl[index]));
            }
        }
        int[]distr=new int[n];
        min=new Segtree(l,false);
        max=new Segtree(r,true);
        pq=new PriorityQueue<>();
        Arrays.fill(distr,Integer.MAX_VALUE/4);
        distr[n-1]=0;
        min.update(n-1,Integer.MAX_VALUE/4);
        max.update(n-1,Integer.MIN_VALUE/4);
        pq.add(new Node(n-1,0));
        while(!pq.isEmpty()){
            Node cur=pq.poll();
            ArrayList<Integer>next=min.query(cur.node,n-1,cur.node);
            next.addAll(max.query(0,cur.node,cur.node));
            for(int index:next){
                min.update(index,Integer.MAX_VALUE/4);
                max.update(index,Integer.MIN_VALUE/4);
                distr[index]=cur.dist+1;
                pq.add(new Node(index,distr[index]));
            }
        }
        Segtree left=new Segtree(distl,false);
        Segtree right=new Segtree(distr,false);
        int[]ans=new int[n];
        min=new Segtree(l,false);
        max=new Segtree(r,true);
        pq=new PriorityQueue<>();
        for(int i=0;i<n;i++){
            if(left.min(l[i],r[i])==Integer.MAX_VALUE/4||right.min(l[i],r[i])==Integer.MAX_VALUE/4)
                ans[i]=Integer.MAX_VALUE/4;
            else
                ans[i]=left.min(l[i],r[i])+right.min(l[i],r[i])+1;
            pq.add(new Node(i,ans[i]));
        }
        min.update(pq.peek().node,Integer.MAX_VALUE/4);
        max.update(pq.peek().node,Integer.MIN_VALUE/4);
        while(!pq.isEmpty()){
            Node cur=pq.poll();
            if(ans[cur.node]!=cur.dist)
                continue;
            ArrayList<Integer>next=min.query(cur.node,n-1,cur.node);
            next.addAll(max.query(0,cur.node,cur.node));
            for(int index:next){
                min.update(index,Integer.MAX_VALUE/4);
                max.update(index,Integer.MIN_VALUE/4);
                if(ans[index]>cur.dist+1){
                    ans[index]=cur.dist+1;
                    pq.add(new Node(index,ans[index]));
                }
            }
        }
        int q=scan.nextInt();
        for(int i=0;i<q;i++){
            int index=scan.nextInt()-1;
            if(ans[index]==Integer.MAX_VALUE/4)
                System.out.println(-1);
            else
                System.out.println(ans[index]);
        }
    }
}
