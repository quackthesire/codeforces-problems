import java.util.*;
public class Main{
    static boolean solve(int count,int val,int[]array){
        for(int i=0;i<count;i++){
            if(array[i]+array[2*count-i-1]>=val)
                return false;
        }
        return true;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int k=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt();
            }
            Arrays.sort(array);
            int l=0;
            int r=n/3;
            while(l<=r){
                int m=(l+r)/2;
                if(solve(m,k,array))
                    l=m+1;
                else
                    r=m-1;
            }
            int count=0;
            for(int i=2*r;i<n-r;i++){
                if(array[i]<k)
                    count++;
                else
                    break;
            }
            int val=Math.min(count,(n-3*r)/2);
            System.out.println(r+val+(n-3*r)-2*val-1);
        }
    }
}
