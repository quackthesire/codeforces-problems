import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return Long.MIN_VALUE;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
    }
    static class Node{
        int w;
        int index;
        Node(int w,int index){
            this.w=w;
            this.index=index;
        }
    }
    static int time=0;
    static void dfs(int u,int p,ArrayList<Integer>[]adj,int[]tin,int[]tout){
        tin[u]=time;
        time++;
        for(int v:adj[u]){
            if(v==p)
                continue;
            dfs(v,u,adj,tin,tout);
        }
        tout[u]=time-1;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]weight=new int[n];
            Node[]array=new Node[n];
            for(int i=0;i<n;i++){
                weight[i]=scan.nextInt();
                array[i]=new Node(weight[i],i);
            }
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<n-1;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                adj[u].add(v);
                adj[v].add(u);
            }
            time=0;
            int[]tin=new int[n];
            int[]tout=new int[n];
            dfs(0,-1,adj,tin,tout);
            long[]vals=new long[n];
            for(int i=0;i<n;i++){
                vals[tin[i]]=array[i].w;
            }
            Segtree segtree=new Segtree(vals);
            Arrays.sort(array,(a,b)->b.w-a.w);
            int ans=0;
            for(int i=0;i<n;i++){
                int u=array[i].index;
                long max=Long.MIN_VALUE;
                max=Math.max(max,segtree.query(0,tin[u]-1));
                max=Math.max(max,segtree.query(tout[u]+1,n-1));
                if(max>weight[u]){
                    ans=u+1;
                    break;
                }
            }
            System.out.println(ans);
        }
    }
}
