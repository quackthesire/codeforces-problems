import java.util.*;
public class Main{
    static class Node{
        int val;
        int l;
        int r;
        public Node(int val,int l,int r){
            this.val=val;
            this.l=l;
            this.r=r;
        }
    }
    static int bs1(int[]index,int pos,int[]zero){
        int l=0;
        int r=index.length-1;
        int ans=-1;
        while(l<=r){
            int m=(l+r)/2;
            int x=index[m];
            if(x<=pos||zero[x-1]-(pos==0?0:zero[pos-1])==0){
                ans=x;
                l=m+1;
            }
            else
                r=m-1;
        }
        return ans;
    }
    static int bs2(int[]index,int pos,int[]zero,int[]one){
        int l=0;
        int r=index.length-1;
        int ans=-1;
        while(l<=r){
            int m=(l+r)/2;
            int x=index[m];
            if(x<=pos||(zero[x-1]-(pos==0?0:zero[pos-1])==0&&one[x-1]-(pos==0?0:one[pos-1])==0)){
                ans=x;
                l=m+1;
            }
            else
                r=m-1;
        }
        return ans;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        String s=scan.next();
        int min=0;
        int[]temp=new int[n];
        for(int i=0;i<n;i++){
            if(s.charAt(i)=='(')
                temp[i]++;
            else
                temp[i]--;
            if(i!=0)
                temp[i]+=temp[i-1];
            if(temp[i]<temp[min])
                min=i;
        }
        if(temp[n-1]!=0){
            System.out.println(0);
            System.out.println(1+" "+1);
            return;
        }
        s=s.substring(min+1,n)+s.substring(0,min+1);
        int count=0;
        int[]array=new int[n];
        int[]zero=new int[n];
        int[]one=new int[n];
        int[]two=new int[n];
        int[]index=new int[n/2];
        for(int i=0;i<n;i++){
            if(s.charAt(i)=='(')
                array[i]++;
            else{
                array[i]--;
                index[count]=i;
                count++;
            }
            if(i!=0)
                array[i]+=array[i-1];
            if(array[i]==0)
                zero[i]++;
            if(array[i]==1)
                one[i]++;
            if(array[i]==2)
                two[i]++;
            if(i!=0){
                zero[i]+=zero[i-1];
                one[i]+=one[i-1];
                two[i]+=two[i-1];
            }
        }
        Node ans=new Node(zero[n-1],0,0);
        for(int i=0;i<n;i++){
            if(s.charAt(i)==')')
                continue;
            int j=bs1(index,i,zero);
            if(j>i){
                int ones=one[j-1]-(i==0?0:one[i-1]);
                if(ones>ans.val)
                    ans=new Node(ones,i,j);
            }
            j=bs2(index,i,zero,one);
            if(j>i){
                int twos=two[j-1]-(i==0?0:two[i-1]);
                if(zero[n-1]+twos>ans.val)
                    ans=new Node(zero[n-1]+twos,i,j);
            }
        }
        System.out.println(ans.val);
        System.out.println(((min+ans.l+1)%n+1)+" "+((min+ans.r+1)%n+1));
    }
}
