import java.util.*;
public class Main{
    static class Node implements Comparable<Node>{
        int a;
        int b;
        int index;
        public Node(int a,int b,int index){
            this.a=a;
            this.b=b;
            this.index=index;
        }
        public int compareTo(Node other){
            return Math.min(this.a,this.b)-Math.min(other.a,other.b);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            Node[]array=new Node[n];
            for(int i=0;i<n;i++){
                array[i]=new Node(scan.nextInt()-1,0,0);
            }
            for(int i=0;i<n;i++){
                array[i]=new Node(array[i].a,scan.nextInt()-1,i);
            }
            Arrays.sort(array);
            boolean work=true;
            for(int i=1;i<n;i++){
                int max=Math.max(array[i-1].a,array[i-1].b);
                if(max>array[i].a&&max>array[i].b){
                    work=false;
                    break;
                }
            }
            if(!work){
                System.out.println("NO");
                continue;
            }
            int[]state=new int[n];//0=both,1=same,2=diff
            for(int i=1;i<n;i++){
                Node max=new Node(0,0,0);
                if(array[i-1].a>array[i-1].b)
                    max=new Node(array[i-1].a,0,0);
                else
                    max=new Node(array[i-1].b,1,0);
                if(max.a<array[i].a&&max.a>array[i].b)
                    state[i]=max.b+1;
                if(max.a>array[i].a&&max.a<array[i].b)
                    state[i]=2-max.b;
            }
            int[]val=new int[n];
            int[]pos=new int[n];
            for(int i=0;i<n;i++){
                val[array[i].index]=i;
            }
            for(int i=0;i<n;i++){
                pos[val[i]]=i;
            }
            for(int i=0;i<n;i++){
                int first=pos[i];
                if(first==i)
                    continue;
                int a=val[i];
                int b=val[first];
                if(state[a]!=0)
                    state[a]=3-state[a];
                if(a!=n-1&&state[a+1]!=0)
                    state[a+1]=3-state[a+1];
                if(state[b]!=0)
                    state[b]=3-state[b];
                if(b!=n-1&&state[b+1]!=0)
                    state[b+1]=3-state[b+1];
                val[i]=b;
                val[first]=a;
                pos[b]=i;
                pos[a]=first;
            }
            int count=0;
            int start=0;
            boolean odd=false;
            for(int i=0;i<n-1;i++){
                if(i!=0&&state[i]==0){
                    if((i-start)%2==1)
                        odd=true;
                    start=i;
                }
                if(state[i]==2){
                    state[i]=3-state[i];
                    if(state[i+1]!=0)
                        state[i+1]=3-state[i+1];
                    count++;
                }
            }
            if(state[n-1]==0){
                if((n-1-start)%2==1)
                    odd=true;
                start=n-1;
            }
            if((n-start)%2==1)
                odd=true;
            if(state[n-1]==2)
                count++;
            System.out.println(odd||count%2==0?"YES":"NO");
        }
    }
}
