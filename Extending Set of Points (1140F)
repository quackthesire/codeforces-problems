import java.util.*;
public class Main{
    static int max=300000;
    static class Edge{
        int u;
        int v;
        public Edge(int u,int v){
            this.u=u;
            this.v=v;
        }
    }
    static class DSU{
        int[]parent;
        int[]x;
        int[]y;
        Deque<long[]>hist=new ArrayDeque<>();
        long tot;
        public DSU(int n){
            parent=new int[n+1];
            x=new int[n+1];
            y=new int[n+1];
            for(int i=1;i<=n;i++){
                parent[i]=i;
                if(i<=max)
                    x[i]=1;
                else
                    y[i]=1;
            }
            tot=0;
        }
        public int find(int val){
            while(val!=parent[val])
                val=parent[val];
            return val;
        }
        public void union(int u,int v){
            u=find(u);
            v=find(v);
            if(u==v){
                hist.push(new long[]{-1});
                return;
            }
            if(x[u]+y[u]<x[v]+y[v]){
                int temp=u;
                u=v;
                v=temp;
            }
            hist.push(new long[]{v,parent[v],x[u],y[u],tot});
            tot-=(long)x[u]*(long)y[u];
            tot-=(long)x[v]*(long)y[v];
            parent[v]=u;
            x[u]+=x[v];
            y[u]+=y[v];
            tot+=(long)x[u]*(long)y[u];
        }
        public void rollback(int size){
            while(hist.size()>size){
                long[]change=hist.pop();
                if(change[0]==-1)
                    continue;
                x[parent[(int)change[0]]]=(int)change[2];
                y[parent[(int)change[0]]]=(int)change[3];
                parent[(int)change[0]]=(int)change[1];
                tot=change[4];
            }
        }
        public int getx(int val){
            return x[find(val)];
        }
        public int gety(int val){
            return y[find(val)];
        }
    }
    static class Segtree{
        int n;
        ArrayList<Edge>[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new ArrayList[4*n+5];
            for(int i=0;i<4*n+5;i++){
                tree[i]=new ArrayList<>();
            }
        }
        public void add(int node,Edge edge,int l,int r,int ll,int rr){
            if(r<ll||rr<l)
                return;
            if(l<=ll&&rr<=r){
                tree[node].add(edge);
                return;
            }
            int m=(ll+rr)/2;
            add(node*2,edge,l,r,ll,m);
            add(node*2+1,edge,l,r,m+1,rr);
        }
        public void dfs(int node,int l,int r,DSU dsu){
            int size=dsu.hist.size();
            for(Edge edge:tree[node]){
                dsu.union(edge.u,edge.v);
            }
            if(l==r)
                System.out.println(dsu.tot);
            else{
                int m=(l+r)/2;
                dfs(node*2,l,m,dsu);
                dfs(node*2+1,m+1,r,dsu);
            }
            dsu.rollback(size);
        }
    }
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int q=scan.nextInt();
	    HashMap<Long,Integer>points=new HashMap<>();
	    Segtree segtree=new Segtree(q);
	    DSU dsu=new DSU(max*2);
	    for(int i=0;i<q;i++){
            int x=scan.nextInt();
            int y=scan.nextInt();
            long key=x+(long)(max+1)*y;
            int visited=points.getOrDefault(key,-1);
            if(visited!=-1){
                segtree.add(1,new Edge(x,y+max),visited,i-1,0,q-1);
                points.remove(key);
            }
            else
                points.put(key,i);
        }
	    for (Map.Entry<Long,Integer>edge:points.entrySet()){
            long key=edge.getKey();
            segtree.add(1,new Edge((int)(key%(max+1)),(int)(key/(max+1))+max),edge.getValue(),q-1,0,q-1);
        }
	    segtree.dfs(1,0,q-1,dsu);
	}
}
