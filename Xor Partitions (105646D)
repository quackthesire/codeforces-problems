import java.util.*;
public class Main{
    static long MOD=1000000007;
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        long[]dp=new long[n+1];
        long[]pref=new long[n+1];
        long[][]sum=new long[60][2];
        dp[0]=1;
        for(int i=0;i<60;i++){
            sum[i][0]=1;
        }
        for(int i=1;i<=n;i++){
            long cur=0;
            pref[i]=pref[i-1]^scan.nextLong();
            for(int j=0;j<60;j++){
                cur=(cur+sum[j][(int)((pref[i]>>j)&1L)^1]*((1L<<j)%MOD))%MOD;
            }
            dp[i]=cur;
            for(int j=0;j<60;j++){
                sum[j][(int)((pref[i]>>j)&1L)]=(sum[j][(int)((pref[i]>>j)&1L)]+dp[i])%MOD;
            }
        }
        System.out.println(dp[n]);
    }
}
