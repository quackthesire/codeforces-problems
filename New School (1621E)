import java.util.*;
public class Main{
    static class Node implements Comparable<Node>{
        int k;
        int index;
        int start;
        long sum;
        long[]vals;
        public Node(int k,int index,int start,long sum,long[]vals){
            this.k=k;
            this.index=index;
            this.start=start;
            this.sum=sum;
            this.vals=vals;
        }
        public int compareTo(Node other){
            if(sum*other.k==other.sum*k)
                return this.index-other.index;
            return Long.compare(sum*other.k,other.sum*k);
        }
    }
    static int bs(Node[]array,long sum,long k){
        int l=0;
        int r=array.length-1;
        while(l<=r){
            int m=(l+r)/2;
            if(array[m].sum*k>sum*array[m].k)
                r=m-1;
            else
                l=m+1;
        }
        return l;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int tempvar=0;tempvar<t;tempvar++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            long[]temp=new long[n];
            for(int i=0;i<n;i++){
                temp[i]=scan.nextLong();
            }
            Arrays.sort(temp);
            long[]array=new long[m];
            for(int i=0;i<m;i++){
                array[i]=temp[i+n-m];
            }
            int tot=0;
            Node[]list=new Node[m];
            for(int i=0;i<m;i++){
                int k=scan.nextInt();
                long sum=0;
                long[]vals=new long[k];
                for(int j=0;j<k;j++){
                    vals[j]=scan.nextLong();
                    sum+=vals[j];
                }
                list[i]=new Node(k,i,tot,sum,vals);
                tot+=k;
            }
            Arrays.sort(list);
            int[]bad=new int[m];
            for(int i=0;i<m;i++){
                if(list[i].sum>list[i].k*array[i])
                    bad[i]++;
                if(i!=0)
                    bad[i]+=bad[i-1];
            }
            int[]left=new int[m];
            for(int i=0;i<m-1;i++){
                if(list[i+1].sum>list[i+1].k*array[i])
                    left[i]++;
                if(i!=0)
                    left[i]+=left[i-1];
            }
            int[]right=new int[m];
            for(int i=0;i<m-1;i++){
                if(list[i].sum>list[i].k*array[i+1])
                    right[i]++;
                if(i!=0)
                    right[i]+=right[i-1];
            }
            int[]ans=new int[tot];
            for(int i=0;i<m;i++){
                for(int j=0;j<list[i].k;j++){
                    int work=0;
                    long k=list[i].k-1;
                    long sum=list[i].sum-list[i].vals[j];
                    if(bad[m-1]==0){
                        if(list[i].vals[j]*list[i].k>=list[i].sum)
                            work=1;
                        else{
                            int last=bs(list,sum,k)-1;
                            long val=(last==0?0:left[last-1])-(i==0?0:left[i-1]);
                            if(sum<=k*array[last]&&val==0)
                                work=1;
                        }
                    }
                    else{
                        if(list[i].vals[j]*list[i].k>list[i].sum){
                            int last=bs(list,sum,k);
                            if(sum<=k*array[last]){
                                long val=(i==0?0:right[i-1])-(last==0?0:right[last-1]);
                                if(bad[i]-(last==0?0:bad[last-1])==bad[m-1]&&val==0)
                                    work=1;
                            }
                        }
                    }
                    ans[list[i].start+j]=work;
                }
            }
            for(int i=0;i<tot;i++){
                System.out.print(ans[i]);
            }
            System.out.println();
        }
    }
}
