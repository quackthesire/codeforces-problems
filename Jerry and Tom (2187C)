import java.util.*;
public class Main{
    static long dfs(int u,ArrayList<Integer>[]adj,long[]size,long cur){
        long sum=0;
        long count=0;
        for(int v:adj[u]){
            sum+=dfs(v,adj,size,cur+1);
            size[u]+=size[v];
            sum+=cur*size[v]*count;
            count+=size[v];
        }
        sum+=cur*(size[u]-1);
        return sum;
    }
    static long dfs2(int u,ArrayList<Integer>[]adj,HashMap<Long,Long>[]map,long cur){
        long sum=0;
        int best=-1;
        for(int v:adj[u]){
            sum+=dfs2(v,adj,map,cur+1);
            if(best==-1||map[v].size()>map[best].size())
                best=v;
        }
        if(best==-1)
            map[u]=new HashMap<>();
        else
            map[u]=map[best];
        for(int v:adj[u]){
            if(v==best)
                continue;
            for(Map.Entry<Long,Long>e:map[v].entrySet()){
                sum+=cur*e.getValue()*map[u].getOrDefault(e.getKey(),0L);
            }
            for(Map.Entry<Long,Long>e:map[v].entrySet()){
                map[u].put(e.getKey(),map[u].getOrDefault(e.getKey(),0L)+e.getValue());
            }
        }
        map[u].put(cur,map[u].getOrDefault(cur,0L)+1);
        return sum;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int m=scan.nextInt();
            int[]max=new int[n];
            for(int i=0;i<n-1;i++){
                max[i]=i+1;
            }
            for(int i=0;i<m;i++){
                int u=scan.nextInt()-1;
                int v=scan.nextInt()-1;
                max[u]=Math.max(max[u],v);
            }
            ArrayList<Integer>[]adj=new ArrayList[n];
            for(int i=0;i<n;i++){
                adj[i]=new ArrayList<>();
            }
            for(int i=0;i<n-1;i++){
                adj[max[i]].add(i);
            }
            long[]size=new long[n];
            Arrays.fill(size,1L);
            HashMap<Long,Long>[]map=new HashMap[n];
            long count=0;
            long sum=-dfs(n-1,adj,size,0L)-dfs2(n-1,adj,map,0L);
            for(int i=n-1;i>=0;i--){
                long cur=map[n-1].getOrDefault((long)i,0L);
                sum+=(long)i*cur*count;
                sum+=(long)i*cur*(cur-1);
                count+=cur;
            }
            System.out.println(sum);
        }
    }
}
