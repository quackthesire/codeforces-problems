import java.util.*;
import java.io.*;
public class Main{
    static int size;
    static class Node implements Comparable<Node>{
        int left;
        int right;
        int index;
        public Node(int left,int right,int index){
            this.left=left;
            this.right=right;
            this.index=index;
        }
        public int compareTo(Node other){
            if (this.left/size!=other.left/size)
                return this.left/size-other.left/size;
            if(this.left/size%2==0){
                if(this.right==other.right)
                    return this.index-other.index;
                return this.right-other.right;
            }
            else {
                if(this.right==other.right)
                    return this.index - other.index;
                return other.right - this.right;
            }
        }
    }
    public static void main(String[]args) throws IOException{
        BufferedReader br=new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st=new StringTokenizer(br.readLine());
        int n=Integer.parseInt(st.nextToken());
        int t=Integer.parseInt(st.nextToken());
        size=(int)Math.sqrt(n);
        int[]array=new int[n];
        st=new StringTokenizer(br.readLine());
        for(int i=0;i<n;i++){
            array[i]=Integer.parseInt(st.nextToken());
        }
        Node[]sub=new Node[t];
        for(int i=0;i<t;i++){
            st=new StringTokenizer(br.readLine());
            sub[i]=new Node(Integer.parseInt(st.nextToken())-1,Integer.parseInt(st.nextToken())-1,i);
        }
        Arrays.sort(sub);
        int[]count=new int[(int)Math.pow(10,6)+5];
        long[]ans=new long[t];
        long cur=0;
        int left=0;
        int right=-1;
        for(Node u:sub){
            while(left>u.left){
                left--;
                int val=array[left];
                cur-=(long)count[val]*count[val]*val;
                count[val]++;
                cur+=(long)count[val]*count[val]*val;
            }
            while(right<u.right){
                right++;
                int val=array[right];
                cur-=(long)count[val]*count[val]*val;
                count[val]++;
                cur+=(long)count[val]*count[val]*val;
            }
            while(right>u.right){
                int val=array[right];
                cur-=(long)count[val]*count[val]*val;
                count[val]--;
                cur+=(long)count[val]*count[val]*val;
                right--;
            }
            while(left<u.left){
                int val=array[left];
                cur-=(long)count[val]*count[val]*val;
                count[val]--;
                cur+=(long)count[val]*count[val]*val;
                left++;
            }
            ans[u.index]=cur;
        }
        PrintWriter pw=new PrintWriter(new OutputStreamWriter(System.out));
        for(int i=0;i<t;i++){
            pw.println(ans[i]);
        }
        pw.close();
    }
}
