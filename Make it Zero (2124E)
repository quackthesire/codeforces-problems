import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            long sum=0;
            long max=0;
            long[]array=new long[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextLong();
                sum+=array[i];
                max=Math.max(max,array[i]);
            }
            if(sum%2==1||max>sum/2){
                System.out.println(-1);
                continue;
            }
            long[]pre=new long[n];
            for(int i=0;i<n;i++){
                pre[i]=array[i];
                if(i!=0)
                    pre[i]+=pre[i-1];
            }
            long[]suff=new long[n];
            for(int i=n-1;i>=0;i--){
                suff[i]=array[i];
                if(i!=n-1)
                    suff[i]+=suff[i+1];
            }
            int index=-1;
            for(int i=0;i<n-1;i++){
                if(pre[i]==suff[i+1])
                    index=i;
            }
            if(index!=-1){
                System.out.println(1);
                for(int i=0;i<n;i++){
                    System.out.print(array[i]+" ");
                }
                System.out.println();
                continue;
            }
            System.out.println(2);
            index=0;
            while(pre[index]<sum/2){
                index++;
            }
            long val=(pre[index-1]+suff[index+1]-array[index])/2;
            long need=pre[index-1];
            for(int i=0;i<index;i++){
                long cur=Math.min(array[i],need);
                System.out.print(cur+" ");
                array[i]-=cur;
                need-=cur;
            }
            System.out.print((pre[index-1]-val)+" ");
            array[index]-=(pre[index-1]-val);
            need=val;
            for(int i=index+1;i<n;i++){
                long cur=Math.min(array[i],need);
                System.out.print(cur+" ");
                array[i]-=cur;
                need-=cur;
            }
            System.out.println();
            for(int i=0;i<n;i++){
                System.out.print(array[i]+" ");
            }
            System.out.println();
        }
    }
}
