import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]sum;
        long[]tree;
        public Segtree(long[]array){
            this.n=array.length;
            sum=new long[4*n];
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                sum[node]=array[l];
                tree[node]=Math.max(0,array[l]);
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            sum[node]=sum[node*2]+sum[node*2+1];
            tree[node]=Math.max(tree[node*2],sum[node*2]+tree[node*2+1]);
        }
        public long[] query(int ll,int rr){
            if(ll>rr)
                return new long[]{0,0};
            return query(1,0,n-1,ll,rr);
        }
        public long[] query(int node,int l,int r,int ll,int rr){
            if(ll<=l&&r<=rr)
                return new long[]{sum[node],tree[node]};
            int m=(l+r)/2;
            if(rr<=m)
                return query(node*2,l,m,ll,rr);
            if(ll>m)
                return query(node*2+1,m+1,r,ll,rr);
            long[]left=query(node*2,l,m,ll,rr);
            long[]right=query(node*2+1,m+1,r,ll,rr);
            return new long[]{left[0]+right[0],Math.max(left[1],left[0]+right[1])};
        }
        public void update(int index,long val){
            update(1,0,n-1,index,val);
        }
        public void update(int node,int l,int r,int index,long val){
            if(l==r){
                sum[node]+=val;
                tree[node]=Math.max(0,sum[node]);
                return;
            }
            int m=(l+r)/2;
            if(index<=m)
                update(node*2,l,m,index,val);
            else
                update(node*2+1,m+1,r,index,val);
            sum[node]=sum[node*2]+sum[node*2+1];
            tree[node]=Math.max(tree[node*2],sum[node*2]+tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            int[]pos=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt()-1;
                pos[array[i]]=i;
            }
            long[]val=new long[n];
            for(int i=0;i<n;i++){
                int count=0;
                if(array[i]>0&&pos[array[i]-1]<i)
                    count++;
                if(array[i]+1<n&&pos[array[i]+1]<i)
                    count++;
                val[i]=1-count;
            }
            int ans=0;
            Segtree segtree=new Segtree(val);
            for(int i=0;i<n;i++){
                long[]left=segtree.query(i,n-1);
                long[]right=segtree.query(0,i-1);
                if(Math.max(left[1],left[0]+right[1])<=2)
                    ans++;
                if(i==n-1)
                    continue;
                if(array[i]>0){
                    segtree.update(pos[array[i]-1],1);
                    segtree.update(i,-1);
                }
                if(array[i]<n-1){
                    segtree.update(pos[array[i]+1],1);
                    segtree.update(i,-1);
                }
            }
            System.out.println(ans);
        }
    }
}
