import java.util.*;
public class Main{
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(int n){
            this.n=n;
            tree=new long[4*n];
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return Math.max(left,right);
        }
        public void update(int i){
            update(1,0,n-1,i);
        }
        public void update(int node,int l,int r,int i){
            if(l==r){
                tree[node]++;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i);
            else
                update(node*2+1,m+1,r,i);
            tree[node]=Math.max(tree[node*2],tree[node*2+1]);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            int[]array=new int[n];
            for(int i=0;i<n;i++){
                array[i]=scan.nextInt()-1;
            }
            boolean[][]work=new boolean[n][n];
            for(int i=0;i<n;i++){
                Segtree segtree=new Segtree(n);
                for(int j=i;j<n;j++){
                    segtree.update(array[j]);
                    if((j-i+1)%2==0&&segtree.query(0,n-1)<=(j-i+1)/2)
                        work[i][j]=true;
                }
            }
            int[]dp=new int[n];
            dp[0]=1;
            for(int i=1;i<n;i++){
                if(work[0][i-1])
                    dp[i]=1;
                for(int j=0;j<i;j++){
                    if(array[j]!=array[i]||dp[j]==0)
                        continue;
                    if(i-j==1||work[j+1][i-1])
                        dp[i]=Math.max(dp[i],dp[j]+1);
                }
            }
            int best=dp[n-1];
            for(int i=0;i<n-1;i++){
                if(work[i+1][n-1])
                    best=Math.max(best,dp[i]);
            }
            System.out.println(best);
        }
    }
}
