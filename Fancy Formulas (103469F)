import java.util.*;
public class Main{
    static long inv(long base,long exp,long mod){
        long res=1;
        while(exp>0){
            if(exp%2==1)
                res=(res*base)%mod;
            base=(base*base)%mod;
            exp/=2;
        }
        return res;
    }
	public static void main(String[]args){
	    Scanner scan=new Scanner(System.in);
	    int p=scan.nextInt();
	    int q=scan.nextInt();
	    int max=0;
        long base=1;
        while(base<p){
            base*=2;
            max++;
        }
	    for(int i=0;i<q;i++){
	        int a=scan.nextInt();
	        int b=scan.nextInt();
	        int c=scan.nextInt();
	        int d=scan.nextInt();
	        if((a+b)%p!=(c+d)%p){
	            System.out.println("-1");
	            continue;
	        }
	        if(a==c&&b==d){
	            System.out.println("0");
	            continue;
	        }
	        long inv=inv((a+b)%p,p-2,p);
            long pow=1;
            for(int j=1;j<=max;j++){
                pow=(pow*2)%p;
                long limit=(((pow*a-c)%p+p)%p*inv)%p;
                if(limit<(1L<<j)){
                    System.out.println(j);
                    break;
                }
            }
	    }
	}
}
