import java.util.*;
public class Main{
	public static void main(String[]args){
		Scanner scan=new Scanner(System.in);
		String s=scan.next();
		boolean[]array=new boolean[s.length()];
		for(int i=0;i<array.length;i++){
		    array[i]=s.charAt(i)=='1';
		}
		int count=0;
		for(int i=1;i<=(Math.sqrt(1+4*array.length)-1)/2;i++){
		    int len=(int)Math.pow(i,2)+i;
		    int zeros=0;
		    int ones=0;
		    for(int j=0;j<len;j++){
		        if(!array[j])
		            zeros++;
		        else
		            ones++;
		    }
		    if(zeros==(int)Math.pow(ones,2))
		        count++;
		    for(int j=1;j<=array.length-len;j++){
		        if(!array[j-1])
		            zeros--;
		        else
		            ones--;
		        if(!array[j+len-1])
		            zeros++;
		        else
		            ones++;
    		    if(zeros==(int)Math.pow(ones,2))
    		        count++;
		    }
		}
		System.out.println(count);
	}
}
