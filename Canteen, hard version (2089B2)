import java.util.*;
public class Main{
    static boolean solve(int num,long k,int start,long[]array){
        long count=0;
        ArrayDeque<Integer>dq=new ArrayDeque<>();
        for(int i=start;i>=start-array.length/2;i--){
            while(!dq.isEmpty()&&dq.peekFirst()>i+num){
                dq.pollFirst();
            }
            if(!dq.isEmpty()&&start>=i+num)
                count+=Math.max(0,array[dq.peekFirst()]-array[i]);
            while(!dq.isEmpty()&&array[dq.peekLast()]>=array[i]){
                dq.pollLast();
            }
            dq.offerLast(i);
        }
        return count<=k;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int tempvar=0;tempvar<t;tempvar++){
            int n=scan.nextInt();
            long k=scan.nextLong();
            long sum=0;
            long[]a=new long[n];
            long[]b=new long[n];
            for(int i=0;i<n;i++){
                a[i]=scan.nextLong();
                sum+=a[i];
            }
            for(int i=0;i<n;i++){
                b[i]=scan.nextLong();
            }
            if(sum==k){
                System.out.println(0);
                continue;
            }
            int min=n;
            long[]c=new long[2*n];
            for(int i=0;i<2*n;i++){
                c[i]=a[(i%n)]-b[(i%n)];
                if(i!=0)
                    c[i]+=c[i-1];
                if(i>=n&&c[i]<c[min])
                    min=i;
            }
            int l=1;
            int r=n;
            while(l<=r){
                int m=(l+r)/2;
                if(solve(m,k,min,c))
                    r=m-1;
                else
                    l=m+1;
            }
            System.out.println(l);
        }
    }
}
