import java.util.*;
public class Main{
    static long x;
    static Node point;
    static class Node implements Comparable<Node>{
        long x;
        long y;
        public Node(long x,long y){
            this.x=x;
            this.y=y;
        }
        public int compareTo(Node other){
            return Long.compare(this.x,other.x);
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public long query(int l,int r){
            if(l>r)
                return 0;
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]+=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    static long solve(int n,Segtree left,Segtree right){
        int l=0;
        int r=n;
        while(l<=r){
            int m=(l+r)/2;
            if(work(m,left,right))
                l=m+1;
            else
                r=m-1;
        }
        return r;
    }
    static boolean work(int val,Segtree left,Segtree right){
        int l=0;
        int r=left.n-1;
        while(l<=r){
            int m=(l+r)/2;
            if(left.query(0,m)>=val&&right.query(0,m)>=val)
                r=m-1;
            else
                l=m+1;
        }
        boolean res=left.query(l+1,left.n-1)>=val&&right.query(l+1,left.n-1)>=val;
        if(res)
            point=new Node(x,l+1);
        return res;
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            Node[]array=new Node[n];
            TreeSet<Long>set=new TreeSet<>();
            for(int i=0;i<n;i++){
                array[i]=new Node(scan.nextLong(),scan.nextLong());
                set.add(array[i].y);
            }
            Arrays.sort(array);
            int index=0;
            HashMap<Long,Integer>map=new HashMap<>();
            HashMap<Integer,Long>rev=new HashMap<>();
            for(long i:set){
                map.put(i,index);
                rev.put(index,i);
                index++;
            }
            long[]val=new long[set.size()];
            for(int i=0;i<n;i++){
                val[map.get(array[i].y)]++;
            }
            x=0;
            point=new Node(0,0);
            Segtree left=new Segtree(new long[set.size()]);
            Segtree right=new Segtree(val);
            long max=solve(n,left,right);
            Node node=point;
            for(int i=0;i<n;i++){
                left.update(map.get(array[i].y),1);
                right.update(map.get(array[i].y),-1);
                x=array[i].x;
                if(i!=n-1&&array[i].x!=array[i+1].x){
                    x=array[i+1].x;
                    long cur=solve(n,left,right);
                    if(cur>max){
                        max=cur;
                        node=point;
                    }
                }
            }
            System.out.println(max);
            System.out.println(node.x+" "+rev.getOrDefault((int)node.y,1000000000L));
        }
    }
}
