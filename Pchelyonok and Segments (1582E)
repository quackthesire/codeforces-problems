import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int tempvar=0;tempvar<t;tempvar++){
            int n=scan.nextInt();
            long[]array=new long[n+1];
            long[]pre=new long[n+1];
            long[]valid=new long[n+1];
            for(int i=1;i<=n;i++){
                array[i]=scan.nextLong();
                pre[i]=array[i]+pre[i-1];
                valid[i]=array[i];
            }
            for(int i=2;i<=(int)Math.sqrt(2*n)+1;i++){
                long max=-1;
                long[]temp=new long[n+1];
                Arrays.fill(temp,-1);
                boolean work=false;
                for(int j=n;j>i;j--){
                    max=Math.max(max,valid[j]);
                    if(pre[j-1]-pre[j-i-1]>=max)
                        continue;
                    temp[j-i]=pre[j-1]-pre[j-i-1];
                    if(temp[j-i]>=0)
                        work=true;
                }
                valid=temp;
                if(!work){
                    System.out.println(i-1);
                    break;
                }
            }
        }
    }
}
