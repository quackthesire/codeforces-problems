#include <bits/stdc++.h>
using namespace std;
using ll=long long;
const ll MOD=998244353;
struct BIT{
    int n;
    vector<ll>bit;
    BIT(int n):n(n){
        bit.resize(n+1);
    }
    void update(int i,ll val){
        i++;
        for(i;i<=n;i+=i&-i){
            bit[i]=(bit[i]+val)%MOD;
        }
    }
    ll sum(int i){
        ll res=0;
        for(i;i>0;i-=i&-i){
            res=(res+bit[i])%MOD;
        }
        return res;
    }
    ll query(int l,int r){
        return (sum(r+1)-sum(l)+MOD)%MOD;
    }
};
struct ValComp{
    const vector<vector<pair<int,int>>>&vals;
    ValComp(vector<vector<pair<int,int>>>&vals):vals(vals){}
    bool operator()(const pair<int,int>&a,const pair<int,int>&b) const{
        if(vals[a.first][a.second].first==vals[b.first][b.second].first)
            return a.first<b.first;
        return vals[a.first][a.second].first<vals[b.first][b.second].first;
    }
};
struct IndexComp{
    bool operator()(const pair<int,int>&a,const pair<int,int>&b) const{
        return a.second>b.second;
    }
};
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    cin>>n;
    vector<int>array(n);
    vector<int>last(30,-1);
    vector<vector<int>>index(n);
    for(int i=0;i<n;i++){
        cin>>array[i];
        for(int j=0;j<30;j++){
            if(last[j]!=-1)
                index[i].push_back(last[j]);
        }
        index[i].push_back(i);
        sort(index[i].begin(),index[i].end(),greater<int>());
        index[i].erase(unique(index[i].begin(),index[i].end()),index[i].end());
        for(int j=0;j<30;j++){
            if((array[i]&(1<<j))!=0)
                last[j]=i;
        }
    }
    vector<vector<pair<int,int>>>vals(n);//(or value,index)
    vector<pair<int,int>>order;
    order.reserve(31*n);
    for(int i=0;i<n;i++){
        int cur=0;
        int count=0;
        vals[i].reserve(31);
        for(int j:index[i]){
            cur|=array[j];
            vals[i].push_back(make_pair(cur,j));
            order.push_back(make_pair(i,count));
            count++;
        }
    }
    for(int i=0;i<n;i++){
        sort(vals[i].begin(),vals[i].end(),IndexComp());
    }
    sort(order.begin(),order.end(),ValComp(vals));
    BIT bit(n);
    for(int i=0;i<order.size();i++){
        int cur=vals[order[i].first][order[i].second].second;
        int next=(order[i].second==vals[order[i].first].size()-1)?-1:vals[order[i].first][order[i].second+1].second;
        bit.update(order[i].first,bit.query(max(0,next),cur-1));
        if(next==-1)
            bit.update(order[i].first,1);
    }
    cout<<bit.query(n-1,n-1)<<"\n";
}
