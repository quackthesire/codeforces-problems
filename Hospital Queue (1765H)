import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        int m=scan.nextInt();
        ArrayList<Integer>[]adj=new ArrayList[n];
        ArrayList<Integer>[]rev=new ArrayList[n];
        ArrayList<Integer>[]array=new ArrayList[n];
        for(int i=0;i<n;i++){
            adj[i]=new ArrayList<>();
            rev[i]=new ArrayList<>();
            array[i]=new ArrayList<>();
        }
        for(int i=0;i<n;i++){
            array[scan.nextInt()-1].add(i);
        }
        for(int i=0;i<m;i++){
            int a=scan.nextInt()-1;
            int b=scan.nextInt()-1;
            adj[a].add(b);
            rev[b].add(a);
        }
        for(int i=0;i<n;i++){
            int ans=0;
            int[]val=new int[n];
            for(int j=0;j<n;j++){
                val[j]=adj[j].size();
            }
            boolean[]visited=new boolean[n];
            Queue<Integer>q=new LinkedList<>();
            for(int j=n-1;j>=0;j--){
                for(int k:array[j]){
                    visited[k]=true;
                    if(val[k]==0&&k!=i)
                        q.add(k);
                }
                if(q.isEmpty()){
                    ans=j;
                    break;
                }
                int cur=q.poll();
                for(int k:rev[cur]){
                    val[k]--;
                    if(val[k]==0&&visited[k]&&k!=i)
                        q.add(k);
                }
            }
            System.out.print((ans+1)+" ");
        }
    }
}
