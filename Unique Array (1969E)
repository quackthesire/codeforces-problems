#include <bits/stdc++.h>
using namespace std;
using ll=long long;
struct Segtree{
    int n;
    vector<ll>tree;
    vector<ll>lazy;
    Segtree(int n):n(n){
        tree.resize(4*n);
        lazy.resize(4*n);
    }
    int query(){
        return query(1,0,n-1);
    }
    int query(int node,int l,int r){
        if(tree[node]!=0)
            return n;
        if(l==r)
            return l;
        push(node,l,r);
        int m=(l+r)/2;
        if(tree[node*2]==0)
            return query(node*2,l,m);
        return query(node*2+1,m+1,r);
    }
    void update(int l,int r,ll val){
        update(1,0,n-1,l,r,val);
    }
    void update(int node,int l,int r,int ql,int qr,ll val){
        if(r<ql||qr<l)
            return;
        if(ql<=l&&r<=qr){
            tree[node]+=val;
            lazy[node]+=val;
            return;
        }
        push(node,l,r);
        int m=(l+r)/2;
        update(node*2,l,m,ql,qr,val);
        update(node*2+1,m+1,r,ql,qr,val);
        tree[node]=min(tree[node*2],tree[node*2+1]);
    }
    void push(int node,int l,int r){
        if(lazy[node]==0)
            return;
        int m=(l+r)/2;
        tree[node*2]+=lazy[node];
        tree[node*2+1]+=lazy[node];
        lazy[node*2]+=lazy[node];
        lazy[node*2+1]+=lazy[node];
        lazy[node]=0;
    }
};
int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>array(n);
        vector<vector<int>>pos(n);
        for(int i=0;i<n;i++){
            cin>>array[i];
            array[i]--;
            pos[array[i]].push_back(i);
        }
        for(int i=0;i<n;i++){
            pos[i].push_back(n);
        }
        vector<queue<pair<int,int>>>valid(n);
        for(int i=0;i<n;i++){
            for(int j=0;j<pos[i].size()-1;j++){
                valid[i].push(make_pair(pos[i][j],pos[i][j+1]-1));
            }
        }
        Segtree segtree(n);
        for(int i=0;i<n;i++){
            if(!valid[i].empty())
                segtree.update(valid[i].front().first,valid[i].front().second,1);
        }
        vector<int>last(n);
        last[0]=segtree.query();
        for(int i=1;i<n;i++){
            queue<pair<int,int>>&q=valid[array[i-1]];
            segtree.update(q.front().first,q.front().second,-1);
            segtree.update(i-1,i-1,LLONG_MAX/2);
            q.pop();
            if(!q.empty())
                segtree.update(q.front().first,q.front().second,1);
            last[i]=segtree.query();
        }
        int count=0;
        int cur=n;
        for(int i=n-1;i>=0;i--){
            if(cur<=last[i])
                continue;
            count++;
            cur=i;
        }
        cout<<count<<"\n";
    }
}
