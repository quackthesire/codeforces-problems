import java.util.*;
import java.io.*;
public class Main{
    static class FastScanner{
        InputStream in;
        byte[]buffer=new byte[1<<16];
        int len=0;
        int index=0;
        FastScanner(InputStream in){
            this.in=in;
        }
        int read() throws IOException{
            if(index>=len){
                len=in.read(buffer);
                index=0;
                if(len<=0)
                    return -1;
            }
            return buffer[index++];
        }
        int nextInt() throws IOException{
            int cur=read();
            while(cur!=-1&&cur<=' '){
                cur=read();
            }
            int mult=1;
            if(cur=='-'){
                mult=-1;
                cur=read();
            }
            int val=0;
            while(cur>' '){
                val=val*10+(cur-'0');
                cur=read();
            }
            return val*mult;
        }
        long nextLong() throws IOException{
            long cur=read();
            while(cur!=-1&&cur<=' '){
                cur=read();
            }
            long mult=1;
            if(cur=='-'){
                mult=-1;
                cur=read();
            }
            long val=0;
            while(cur>' '){
                val=val*10+(cur-'0');
                cur=read();
            }
            return val*mult;
        }
    }
    static int LOG=20;
    static FastScanner scan=new FastScanner(System.in);
    static int n;
    static int[]dist;
    static boolean[]array;
    static LinkedList<Integer>cur;
    static LinkedList<Integer>[]adj;
    static int[]depth;
    static int[][]parent;
    static void dfs(int u,int p){
        parent[u][0]=p;
        for(int i=1;i<LOG;i++){
            parent[u][i]=parent[parent[u][i-1]][i-1];
        }
        for(int v:adj[u]){
            if(v!=p){
                depth[v]=depth[u]+1;
                dfs(v,u);
            }
        }
    }
    static int lca(int u,int v){
        for(int i=LOG-1;i>=0;i--){
            if(depth[u]-depth[v]>=(1<<i))
                u=parent[u][i];
        }
        if(u==v)
            return u;
        for(int i=LOG-1;i>=0;i--){
            if(parent[u][i]!=parent[v][i]){
                u=parent[u][i];
                v=parent[v][i];
            }
        }
        return parent[u][0];
    }
    static int distance(int u,int v){
        if(depth[v]>depth[u])
            return depth[u]+depth[v]-2*depth[lca(v,u)];
        return depth[u]+depth[v]-2*depth[lca(u,v)];
    }
    static void bfs(){
        int[]q=new int[n];
        int l=0;
        int r=0;
        for(int i=0;i<n;i++){
            if(array[i]){
                dist[i]=0;
                q[r]=i;
                r++;
            }
        }
        while(l<r){
            int u=q[l];
            l++;
            for(int v:adj[u]){
                if(dist[v]>dist[u]+1){
                    dist[v]=dist[u]+1;
                    q[r]=v;
                    r++;
                }
            }
        }
    }
    static void solve(int u,LinkedList<Integer>cur,int[]dist){
        int best=dist[u];
        for(int v:cur){
            best=Math.min(best,distance(u,v));
        }
        System.out.println(best);
    }
    public static void main(String[]args) throws IOException{
        n=scan.nextInt();
        int m=scan.nextInt();
        int size=(int)Math.sqrt(m);
        array=new boolean[n];
        adj=new LinkedList[n];
        depth=new int[n];
        parent=new int[n][LOG];
        array[0]=true;
        for(int i=0;i<n;i++){
            adj[i]=new LinkedList<>();
        }
        for(int i=0;i<n-1;i++){
            int a=scan.nextInt()-1;
            int b=scan.nextInt()-1;
            adj[a].add(b);
            adj[b].add(a);
        }
        dfs(0,0);
        for(int i=0;i<m;i+=size){
            cur=new LinkedList<>();
            dist=new int[n];
            Arrays.fill(dist,Integer.MAX_VALUE);
            bfs();
            for(int q=i;q<Math.min(i+size,m);q++){
                if(scan.nextInt()==1){
                    int v=scan.nextInt()-1;
                    if(!array[v]){
                        array[v]=true;
                        cur.add(v);
                    }
                }
                else
                    solve(scan.nextInt()-1,cur,dist);
            }
        }
    }
}
