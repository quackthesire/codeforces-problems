import java.util.*;
public class Main{
    static final int LOG=20;
    static Scanner scan=new Scanner(System.in);
    static int n=scan.nextInt();
    static int[]dist;
    static boolean[]array=new boolean[n];
    static LinkedList<Integer>cur;
    static LinkedList<Integer>[]adj=new LinkedList[n];
    static int[]depth=new int[n];
    static int[][]parent=new int[n][LOG];
    static void dfs(int u,int p){
        parent[u][0]=p;
        for(int i=1;i<LOG;i++){
            parent[u][i]=parent[parent[u][i-1]][i-1];
        }
        for(int v:adj[u]){
            if(v!=p){
                depth[v]=depth[u]+1;
                dfs(v,u);
            }
        }
    }
    static int lca(int u,int v){
        for(int i=LOG-1;i>=0;i--){
            if(depth[u]-depth[v]>=(1<<i))
                u=parent[u][i];
        }
        if(u==v)
            return u;
        for(int i=LOG-1;i>=0;i--){
            if(parent[u][i]!=parent[v][i]){
                u=parent[u][i];
                v=parent[v][i];
            }
        }
        return parent[u][0];
    }
    static int distance(int u,int v){
        if(depth[v]>depth[u])
            return depth[u]+depth[v]-2*depth[lca(v,u)];
        return depth[u]+depth[v]-2*depth[lca(u,v)];
    }
    static void bfs(){
        Queue<Integer>q=new LinkedList<>();
        for(int i=0;i<n;i++){
            if(array[i]){
                dist[i]=0;
                q.add(i);
            }
        }
        while(!q.isEmpty()){
            int u=q.poll();
            for(int v:adj[u]){
                if(dist[v]>dist[u]+1){
                    dist[v]=dist[u]+1;
                    q.add(v);
                }
            }
        }
    }
    static void solve(int u,LinkedList<Integer>cur,int[]dist){
        int best=dist[u];
        for(int v:cur)
            best=Math.min(best,distance(u,v));
        System.out.println(best);
    }
    public static void main(String[]args){
        int m=scan.nextInt();
        int size=(int)Math.sqrt(m);
        array[0]=true;
        for(int i=0;i<n;i++){
            adj[i]=new LinkedList<>();
        }
        for(int i=0;i<n-1;i++){
            int a=scan.nextInt()-1;
            int b=scan.nextInt()-1;
            adj[a].add(b);
            adj[b].add(a);
        }
        dfs(0,0);
        for(int i=0;i<m;i+=size){
            cur=new LinkedList<>();
            dist=new int[n];
            Arrays.fill(dist,Integer.MAX_VALUE);
            bfs();
            for(int q=i;q<Math.min(i+size,m);q++){
                if(scan.nextInt()==1){
                    int v=scan.nextInt()-1;
                    if(!array[v]){
                        array[v]=true;
                        cur.add(v);
                    }
                }
                else
                    solve(scan.nextInt()-1,cur,dist);
            }
        }
    }
}
