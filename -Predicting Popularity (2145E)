import java.util.*;
public class Main{
    static class MinSegtree{
        int n;
        long[]tree;
        long[]lazy;
        public MinSegtree(int n){
            this.n=n;
            tree=new long[4*n];
            lazy=new long[4*n];
            build(1,0,n-1);
        }
        public void build(int node,int l,int r){
            if(l==r){
                tree[node]=-l;
                return;
            }
            int m=(l+r)/2;
            build(node*2,l,m);
            build(node*2+1,m+1,r);
            tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
        public int query(){
            if(tree[1]>=0)
                return n;
            return query(1,0,n-1);
        }
        public int query(int node,int l,int r){
            if(l==r)
                return l;
            push(node);
            int m=(l+r)/2;
            if(tree[node*2]<0)
                return query(node*2,l,m);
            return query(node*2+1,m+1,r);
        }
        public void update(int l,int r,long val){
            update(1,0,n-1,l,r,val);
        }
        public void update(int node,int l,int r,int ll,int rr,long val){
            if(ll>r||rr<l)
                return;
            if(ll<=l&&r<=rr){
                tree[node]+=val;
                lazy[node]+=val;
                return;
            }
            push(node);
            int m=(l+r)/2;
            update(node*2,l,m,ll,rr,val);
            update(node*2+1,m+1,r,ll,rr,val);
            tree[node]=Math.min(tree[node*2],tree[node*2+1]);
        }
        public void push(int node){
            if(lazy[node]==0)
                return;
            tree[node*2]+=lazy[node];
            tree[node*2+1]+=lazy[node];
            lazy[node*2]+=lazy[node];
            lazy[node*2+1]+=lazy[node];
            lazy[node]=0;
        }
    }
    static class Segtree{
        int n;
        long[]tree;
        public Segtree(long[]array){
            this.n=array.length;
            tree=new long[4*n];
            build(array,1,0,n-1);
        }
        public void build(long[]array,int node,int l,int r){
            if(l==r){
                tree[node]=array[l];
                return;
            }
            int m=(l+r)/2;
            build(array,node*2,l,m);
            build(array,node*2+1,m+1,r);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
        public long query(int l,int r){
            return query(1,0,n-1,l,r);
        }
        public long query(int node,int l,int r,int ll,int rr){
            if(ll>r||rr<l)
                return 0;
            if(ll<=l&&r<=rr)
                return tree[node];
            int m=(l+r)/2;
            long left=query(node*2,l,m,ll,rr);
            long right=query(node*2+1,m+1,r,ll,rr);
            return left+right;
        }
        public void update(int i,long val){
            update(1,0,n-1,i,val);
        }
        public void update(int node,int l,int r,int i,long val){
            if(l==r){
                tree[node]=val;
                return;
            }
            int m=(l+r)/2;
            if(i<=m)
                update(node*2,l,m,i,val);
            else
                update(node*2+1,m+1,r,i,val);
            tree[node]=tree[node*2]+tree[node*2+1];
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int a=scan.nextInt();
        int b=scan.nextInt();
        int n=scan.nextInt();
        int[]array=new int[n];
        long[]count=new long[2000001];
        MinSegtree min=new MinSegtree(2000001);
        for(int i=0;i<n;i++){
            array[i]+=Math.max(scan.nextInt()-a,0);
        }
        for(int i=0;i<n;i++){
            array[i]+=Math.max(scan.nextInt()-b,0);
            count[array[i]]++;
            min.update(array[i]+1,2000000,1);
        }
        Segtree vals=new Segtree(count);
        int m=scan.nextInt();
        for(int i=0;i<m;i++){
            int index=scan.nextInt()-1;
            int old=array[index];
            array[index]=0;
            array[index]+=Math.max(scan.nextInt()-a,0);
            array[index]+=Math.max(scan.nextInt()-b,0);
            count[old]--;
            count[array[index]]++;
            min.update(old+1,2000000,-1);
            min.update(array[index]+1,2000000,1);
            vals.update(old,count[old]);
            vals.update(array[index],count[array[index]]);
            /*
            System.out.println("min: "+min.query());
            for(int j=0;j<30;j++){
                System.out.print(count[j]+" ");
            }
            System.out.println();
            */
            System.out.println(vals.query(0,min.query()-1));
        }
    }
}
