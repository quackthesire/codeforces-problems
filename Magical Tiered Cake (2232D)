import java.util.*;
public class Main{
    static class Move{
        int id;
        int from;
        int to;
        public Move(int id,int from,int to){
            this.id=id;
            this.from=from;
            this.to=to;
        }
    }
    static void solve(ArrayList<Move>moves,int[]array,int last,int from,int to){
        if(last==0)
            return;
        int other=from^to;
        if(array[last]==0){
            solve(moves,array,last-1,from,other);
            moves.add(new Move(last,from,to));
            solve(moves,array,last-1,other,to);
        }
        else{
            solve(moves,array,last-array[last]-1,from,other);
            moves.add(new Move(last,from,to));
            solve(moves,array,last-array[last]-1,other,from);
            solve(moves,array,last-1,from,to);
        }
    }
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int t=scan.nextInt();
        for(int temp=0;temp<t;temp++){
            int n=scan.nextInt();
            boolean work=true;
            int[]array=new int[n+1];
            ArrayList<Move>moves=new ArrayList<>();
            for(int i=1;i<=n;i++){
                array[i]=scan.nextInt();
                if(array[i]>=i)
                    work=false;
            }
            if(!work){
                System.out.println("NO");
                continue;
            }
            System.out.println("YES");
            solve(moves,array,n,1,3);
            System.out.println(moves.size());
            for(Move i:moves){
                System.out.println(i.id+" "+i.from+" "+i.to);
            }
        }
    }
}
